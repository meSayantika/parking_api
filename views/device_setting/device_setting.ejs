<link href="/template/dist/css/device_setting.css" rel="stylesheet">
<style>
  /* Direct fallback styles for premium look */
  .dev-page-wrapper { background: #f3f4f6 !important; padding: 20px !important; min-height: 100vh; }
  .dev-card { border-radius: 12px !important; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1) !important; border: none !important; background: #fff !important; }
  .dev-header { border-bottom: 1px solid #e5e7eb !important; padding-bottom: 15px !important; margin-bottom: 20px !important; }
  .dev-add-btn { background: linear-gradient(135deg, #10b981, #059669) !important; color: #fff !important; border: none !important; padding: 10px 20px !important; border-radius: 8px !important; font-weight: 600 !important; cursor: pointer !important; }
</style>

<div class="dev-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card dev-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="dev-header">
              <div class="dev-title-group">
                <div class="dev-icon-badge">
                  <i data-feather="settings"></i>
                </div>
                <h3 class="dev-page-title">Device Setting</h3>
              </div>
              <button type="button" class="dev-add-btn" id="myBtn">
                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Device
              </button>
            </div>

            <!-- FILTER SECTION -->
            <div class="dev-filter-sec">
              <div class="row align-items-end">
                <div class="col-md-6 dev-form-group mb-0">
                  <label for="dev_id" class="dev-label">
                    <i data-feather="tablet" style="width:14px;height:14px;margin-right:4px;"></i> Device ID
                  </label>
                  <select name="dev_id" class="dev-select" id="dev_id" required>
                    <option value="">Select Device ID</option>
                    <% data.msg.forEach(function(item2,index) { %>
                      <option value="<%=item2.app_id%>">
                        <%=item2.app_id%>
                      </option>
                      <% }); %>
                  </select>
                </div>
                <div class="col-md-4">
                  <div style="white-space: nowrap; display: flex; align-items: center; gap: 10px;">
                    <button type="submit" class="dev-submit-btn" id="submitBtn">
                      <i data-feather="search" style="width:15px;height:15px;margin-right:6px;"></i> Filter
                    </button>
                    <a href="/device/device_name" class="dev-refresh-btn" title="Refresh List">
                      <i data-feather="refresh-cw"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <!-- TABLE CONTENT -->
            <div class="dev-table-wrap mt-4 mb-5">
              <table id="example" class="table dev-table no-wrap show_data" style="width:100%">
                <thead>
                  <tr>
                    <th>Sl. No.</th>
                    <th>Device ID</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <!-- Data populated by AJAX -->
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add Device</b></h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/device/add_save_device" method="post" id="myForm">
          <div class="row mb-3">
            <div class="col-12">
              <div class="dev-info-badge" style="background: var(--primary-light); color: var(--primary); padding: 8px 15px; border-radius: 8px; display: inline-flex; align-items: center; font-weight: 600;">
                <i data-feather="info" style="width:16px; height:16px; margin-right:8px;"></i>
                No. of Device Allowed: <span class="ml-2 badge badge-primary"><%= user.user_data.no_device %></span>
                <input type="hidden" id="no_device" value="<%= user.user_data.no_device %>">
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-3 dev-form-group">
              <label for="cust_id" class="dev-label">Customer Name</label>
              <select name="cust_id" class="dev-select" id="cust_id" required>
                <option value="<%= user.user_data.customer_id %>">
                  <%= user.user_data.customer_name %>
                </option>
              </select>
            </div>
            <div class="col-md-3 dev-form-group">
              <label for="dev_mode" class="dev-label">Mode</label>
              <select name="dev_mode" class="dev-select" id="dev_mode">
                <option value="<%= user.user_data.dev_mod %>">
                  <%= user.user_data.dev_mod=='D' ? 'Dual' : 'Toll Naka' %>
                </option>
              </select>
            </div>
            <div class="col-md-3 dev-form-group">
              <label for="app_id" class="dev-label">Device ID</label>
              <input type="text" class="dev-input" id="app_id" name="app_id" placeholder="Enter Device ID...." value="">
            </div>
            <div class="col-md-3 dev-form-group">
              <label for="dev_type" class="dev-label">Device Type</label>
              <select name="dev_type" class="dev-select" id="dev_type">
                <option value="">Select Device Type</option>
                <option value="H">Handheld Device</option>
                <option value="M">Mobile Device</option>
                <option value="A">Amigos Blue Handheld Device</option>
              </select>
            </div>

            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">GST Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="gst_flag" id="gst_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Report Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="report_flag" id="report_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Total Collection Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="tot_col" id="tot_col" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Redirection (Home/Back)</label>
                <label class="dev-switch switch-info">
                  <input type="checkbox" name="redirect_flag" id="redirect_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>

            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Grace Period Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="grace_flag" id="grace_flag" value="Y" checked>
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group" id="hide_grace">
              <label for="grace_value" class="dev-label">Grace Value (Min)</label>
              <input type="text" name="grace_value" id="grace_value" class="dev-input" value="00">
            </div>

            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Advance Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="adv_pay_flag" id="adv_pay_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group" id="hide_adv" style="display:none;">
              <label for="adv_value" class="dev-label">Advance Value</label>
              <input type="text" name="adv_value" id="adv_value" class="dev-input" value="00">
            </div>

            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Pay Mode Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="pay_mode_flag" id="pay_mode_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>

            <% if (user.user_data.dev_mod == 'D') { %>
            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">QR Code Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="qr_code_flag" id="qr_code_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>

            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Day wise Vehicle Rate</label>
                <label class="dev-switch">
                  <input type="checkbox" name="day_wise_rate" id="day_wise_rate" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <% } %>   

            <% if (user.user_data.dev_mod == 'F') { %>
            <div class="col-md-3 dev-form-group">
              <label for="default_payment_mode" class="dev-label">Default Payment Mode</label>
              <select name="default_payment_mode" class="dev-select" id="default_payment_mode">
                <option value="">Select Payment Mode</option>
                <option value="C">CASH</option>
                <option value="U">UPI</option>
              </select>
            </div>
            <% } %>  

          </div>
          <div class="row mt-3">
            <div class="col-12 text-center">
              <button type="submit" id="set_dev_sub" class="dev-submit-btn">SUBMIT</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  console.log("Device Setting script starting...");
  $(document).ready(function () {
    console.log("Document ready in Device Setting");
    // We use window.onload to ensure Select2 and DataTables (which are loaded at the bottom of main.ejs) are ready
    $(window).on('load', function () {
      console.log("Window fully loaded - initializing libraries");
      
      // 1. Initialize Select2
      if ($.fn.select2) {
          $('.dev-select').select2({
              placeholder: 'Select an option',
              width: '100%'
          });
      }

      // 2. Initialize DataTable
      var table;
      if ($.fn.DataTable) {
          table = $('#example').DataTable({
              "paging": true,
              "lengthChange": true,
              "searching": true,
              "ordering": true,
              "info": true,
              "autoWidth": false,
              "responsive": true,
              "pageLength": 5,
              "lengthMenu": [5, 10, 25, 50],
              "language": {
                  "paginate": {
                      "previous": "<i data-feather='chevron-left' style='width:14px;height:14px;'></i>",
                      "next": "<i data-feather='chevron-right' style='width:14px;height:14px;'></i>"
                  }
              }
          });

          // Re-replace icons on every draw
          table.on('draw', function() {
              if (typeof feather !== 'undefined') feather.replace();
          });
      }

      // 3. Add Device Modal Logic
      $("#myBtn").on('click', function (e) {
        e.preventDefault();
        var $btn = $(this);
        var originalHtml = $btn.html();
        
        console.log("Add Device button clicked - checking limit");
        $btn.html('<i class="fa fa-spinner fa-spin"></i> Checking...').prop('disabled', true);

        $.ajax({
          type: "GET",
          url: "/device/device_id",
          success: function (response) {
            console.log("Limit check response:", response);
            $btn.html(originalHtml).prop('disabled', false);
            
            var tot_row = (response.msg && response.msg.length > 0) ? parseInt(response.msg[0].tot_row) : 0;
            var allowed = parseInt($('#no_device').val()) || 0;
            
            if(allowed <= tot_row){
              alert(`Limit reached: You cannot add more than ${allowed} devices. (Current: ${tot_row})`);
            } else {
              console.log("Opening modal #myModal");
              $("#myModal").modal('show');
            }
          },
          error: function (err) {
            console.error("Limit check error:", err);
            $btn.html(originalHtml).prop('disabled', false);
            $("#myModal").modal('show');
          }
        });
      });

      // 4. Filter Logic
      $('#submitBtn').on('click', function (e) {
        e.preventDefault();
        console.log("Filter button clicked");
        var dev_id = $('#dev_id').val();
        
        $.ajax({
          type: "GET",
          url: "/device/device_details",
          data: { dev_id: dev_id },
          success: function (response) {
            console.log("Filter AJAX success:", response);
            
            if ($.fn.DataTable && $.fn.DataTable.isDataTable('#example')) {
                var dTable = $('#example').DataTable();
                dTable.clear();
                if (response.suc > 0 && response.msg && response.msg.length > 0) {
                  response.msg.forEach(function (item, index) {
                    var actionBtn = "<a href='/device/edit_device_details?customer_id=" + item.customer_id + "&&dev_id=" + item.app_id + "' class='action-btn-edit' title='Edit Device'><i class='fa fa-edit' style='font-size:14px;'></i></a>";
                    dTable.row.add([
                      (index + 1),
                      "<span style='font-weight: 600; color: var(--gray-800);'>" + item.app_id + "</span>",
                      actionBtn
                    ]);
                  });
                }
                dTable.draw();
            } else {
              // Fallback for no DataTables
              var tbody = $(".show_data tbody");
              tbody.empty();
              if (response.suc > 0 && response.msg && response.msg.length > 0) {
                response.msg.forEach(function (item, index) {
                  var row = "<tr><td>" + (index + 1) + "</td><td>" + item.app_id + "</td><td><a href='/device/edit_device_details?customer_id=" + item.customer_id + "&&dev_id=" + item.app_id + "' class='action-btn-edit'><i class='fa fa-edit'></i></a></td></tr>";
                  tbody.append(row);
                });
              } else {
                  tbody.append("<tr><td colspan='3' class='text-center'>No data found</td></tr>");
              }
            }
            if (typeof feather !== 'undefined') feather.replace();
          },
          error: function (err) {
            console.error("Filter AJAX error:", err);
            alert("Error fetching device details. Please check console.");
          }
        });
      });

      // Auto-load all devices on page load (try after 500ms to be safe)
      setTimeout(function() {
          $('#submitBtn').trigger('click');
      }, 500);

      // Handle modal Select2 focus
      $('#myModal').on('shown.bs.modal', function () {
          if ($.fn.select2) {
              $('.dev-select', this).select2({
                  placeholder: 'Select an option',
                  width: '100%',
                  dropdownParent: $('#myModal')
              });
          }
      });
    });

    // Toggle Logics (don't depend on DataTables/Select2)
    $('#grace_flag').on('change', function () {
      if ($(this).is(':checked')) {
        $('#hide_grace').show();
        $('#grace_value').attr('required', 'required');
      } else {
        $('#grace_value').removeAttr('required').val('00');
        $('#hide_grace').hide();
      }
    });

    $('#adv_pay_flag').on('change', function () {
      if ($(this).is(':checked')) {
        $('#hide_adv').show();
        $('#adv_value').attr('required', 'required');
      } else {
        $('#adv_value').removeAttr('required').val('00');
        $('#hide_adv').hide();
      }
    });

    $('#gst_flag').on('change', function () {
      if ($(this).prop('checked')) {
        $('#adv_pay_flag').prop('checked', false).trigger('change');
        $('#adv_pay_flag').closest('.dev-switch').addClass('disabled-opacity');
      } else {
        $('#adv_pay_flag').closest('.dev-switch').removeClass('disabled-opacity');
      }
    });
  });
</script>