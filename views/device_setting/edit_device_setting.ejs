<link href="/template/dist/css/device_setting.css" rel="stylesheet">

<div class="dev-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card dev-card">
          <div class="card-body">
            
            <!-- HEADER -->
            <div class="dev-header" style="margin-bottom:20px;">
                <div class="dev-title-group">
                    <div class="dev-icon-badge">
                        <i data-feather="edit-3"></i>
                    </div>
                    <span class="dev-back-btn" id="back" title="Back to Device Settings">
                        <i data-feather="arrow-left"></i>
                    </span>
                    <h3 class="dev-edit-title">Edit Device Setting</h3>
                </div>
            </div>

            <!-- FORM -->
            <form action="/device/edit_save_device" id="myForm" method="post">
                <div class="row mt-4">
                    <!-- Core Info -->
                    <div class="col-md-3 dev-form-group">
                        <label class="dev-label">Customer Name</label>
                        <select name="cust_id_view" class="dev-select" id="cust_id" disabled style="background-color: var(--gray-100); cursor: not-allowed;">
                            <option value="">Select Customer Name</option>
                            <option value="<%= data.customer_id %>" <%=user.user_data.customer_id==data.customer_id ? 'selected' : '' %>><%= data.customer_name %></option>
                        </select>
                        <input type="hidden" name="cust_id" value="<%= data.customer_id %>">
                    </div>

                    <div class="col-md-3 dev-form-group">
                        <label class="dev-label">Mode</label>
                        <select name="dev_mode" class="dev-select" id="dev_mode" disabled style="background-color: var(--gray-100); cursor: not-allowed;">
                            <option value="<%= data.dev_mod == 'D' ? 'D' : 'F' %>">
                                <%= data.dev_mod=='D' ? 'Dual' : 'Toll Naka' %>
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3 dev-form-group">
                        <label class="dev-label">Device ID</label>
                        <input type="text" class="dev-input" id="app_id" name="app_id" value="<%= data.app_id %>" readonly style="background-color: var(--gray-100); cursor: not-allowed;">
                    </div>

                    <div class="col-md-3 dev-form-group">
                        <label class="dev-label">Device Type</label>
                        <select name="dev_type" class="dev-select" id="dev_type">
                            <option value="H" <%= data.device_type==='H' ? 'selected' : '' %>>Handheld Device</option>
                            <option value="M" <%= data.device_type==='M' ? 'selected' : '' %>>Mobile Device</option>
                            <option value="A" <%= data.device_type==='A' ? 'selected' : '' %>>Amigos Blue Handheld Device</option>
                        </select>
                    </div>

                    <!-- Flags -->
                    <div class="col-md-3 dev-form-group">
                        <div class="switch-container">
                            <label class="dev-label">GST Flag</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="gst_flag" name="gst_flag" <%=(data.gst_flag=='Y' )?'checked':''%>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3 dev-form-group">
                        <div class="switch-container">
                            <label class="dev-label">Report Flag</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="report_flag" name="report_flag" <%=(data.report_flag=='Y' )?'checked':''%>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3 dev-form-group">
                        <div class="switch-container">
                            <label class="dev-label">Total Collection Flag</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="tot_col" name="tot_col" <%=(data.total_collection=='Y' )?'checked':''%>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3 dev-form-group">
                        <div class="switch-container">
                            <label class="dev-label">Redirection (Home/Back)</label>
                            <label class="dev-switch switch-info">
                                <input type="checkbox" value="Y" id="redirect_flag" name="redirect_flag" <%=(data.redirection_flag=='Y' )?'checked':''%>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3 dev-form-group">
                        <div class="switch-container">
                            <label class="dev-label">Grace Period Flag</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="grace_flag" name="grace_flag" <%=(data.grace_period_flag=='Y' )?'checked':''%>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3 dev-form-group" id="hide_grace">
                        <label class="dev-label">Grace Value (Min)</label>
                        <input type="text" name="grace_value" id="grace_value" class="dev-input" value="<%= data.grace_value != '' ? (data.grace_value.split(':').length > 0 ? data.grace_value.split(':')[1] : 0) : 0 %>">
                    </div>
                    
                    <div class="col-md-3 dev-form-group">
                        <div class="switch-container">
                            <label class="dev-label">Advance Flag</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="adv_pay_flag" name="adv_pay_flag" <%=(data.adv_pay=='Y' )?'checked':''%>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3 dev-form-group" id="hide_adv">
                        <label class="dev-label">Advance Value</label>
                        <input type="text" name="adv_value" id="adv_value" class="dev-input" value="<%= data.adv_value%>">
                    </div>

                    <div class="col-md-3 dev-form-group">
                        <div class="switch-container">
                            <label class="dev-label">Pay Mode Flag</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="pay_mode_flag" name="pay_mode_flag" <%=(data.pay_mode_flag=='Y' )?'checked':''%>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3 dev-form-group">
                        <div class="switch-container">
                            <label class="dev-label">Manual Car In Flag</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="manual_car_in" name="manual_car_in" <%=(data.manual_car_in=='Y' )?'checked':''%>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <% if (user.user_data.dev_mod == 'D') { %>
                    <div class="col-md-3 dev-form-group">
                        <div class="switch-container">
                            <label class="dev-label">QR Code Flag</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="qr_code_flag" name="qr_code_flag" <%=(data.qr_code_flag=='Y' )?'checked':''%>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-3 dev-form-group">
                        <div class="switch-container">
                            <label class="dev-label">Day wise Vehicle Rate</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="day_wise_rate" name="day_wise_rate" <%=(data.day_wise_rate=='Y' )?'checked':''%>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>
                    <% } %>

                    <% if (user.user_data.dev_mod == 'F') { %>
                    <div class="col-md-3 dev-form-group">
                        <label class="dev-label">Default Payment Mode</label>
                        <select name="default_payment_mode" class="dev-select" id="default_payment_mode">
                            <option value="C" <%= data.default_pay_mode ==='C' ? 'selected' : '' %>>CASH</option>
                            <option value="U" <%= data.default_pay_mode ==='U' ? 'selected' : '' %>>UPI</option>
                        </select>
                    </div>
                    <% } %>  
                </div>

                <div class="text-center mt-3">
                    <button type="submit" id="submitBtn" class="dev-submit-btn" disabled>Update Device Details</button>
                </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        // Initialize Feather Icons
        if (typeof feather !== 'undefined') {
            feather.replace();
        }

        // Initialize Select2
        $('.dev-select').select2({
            width: '100%',
            placeholder: 'Select an option'
        });

        // Back button
        $("#back").click(function () {
            window.location.href = "/device/device_name";
        });

        // Grace logic
        function toggleGraceSection() {
            if ($('#grace_flag').is(':checked')) {
                $('#hide_grace').show();
                $('#grace_value').attr('required', 'required');
            } else {
                $('#grace_value').removeAttr('required').val('00');
                $('#hide_grace').hide();
            }
        }

        $('#grace_flag').on('change', toggleGraceSection);
        toggleGraceSection(); // Initial check

        // Advance logic
        function toggleAdvSection() {
            if ($('#adv_pay_flag').is(':checked')) {
                $('#hide_adv').show();
                $('#adv_value').attr('required', 'required');
            } else {
                $('#adv_value').removeAttr('required').val('00');
                $('#hide_adv').hide();
            }
        }

        $('#adv_pay_flag').on('change', toggleAdvSection);
        toggleAdvSection(); // Initial check

        // GST vs Advance Mutual Exclusion
        $('#gst_flag').on('change', function () {
            if ($(this).prop('checked')) {
                $('#adv_pay_flag').prop('checked', false).trigger('change');
                $('#adv_pay_flag').closest('.dev-switch').addClass('disabled-opacity');
            } else {
                $('#adv_pay_flag').closest('.dev-switch').removeClass('disabled-opacity');
            }
        });

        $('#adv_pay_flag').change(function () {
            if ($('#gst_flag').prop('checked')) {
                $(this).prop('checked', false);
                return false;
            }
        });

        // Initial exclusion state
        if ($('#gst_flag').is(':checked')) {
            $('#adv_pay_flag').closest('.dev-switch').addClass('disabled-opacity');
        }

        // ===== Change detector Logic =====
        function getFieldValue(id) {
            let $el = $("#" + id);
            if ($el.length === 0) return null;
            if ($el.attr("type") === "checkbox") return $el.prop("checked") ? "Y" : "N";
            return $el.val();
        }

        const fieldList = [
            "dev_type", "gst_flag", "report_flag", "tot_col", "redirect_flag",
            "grace_flag", "grace_value", "adv_pay_flag", "adv_value",
            "pay_mode_flag", "qr_code_flag", "day_wise_rate", "default_payment_mode", "manual_car_in"
        ];

        const validFields = fieldList.filter(id => $("#" + id).length > 0);
        const initialValues = {};
        validFields.forEach(id => {
            initialValues[id] = getFieldValue(id);
        });

        function checkForChanges() {
            let changed = false;
            validFields.forEach(id => {
                if (getFieldValue(id) !== initialValues[id]) {
                    changed = true;
                }
            });
            $("#submitBtn").prop("disabled", !changed);
        }

        validFields.forEach(id => {
            $("#" + id).on("input change", function() {
                setTimeout(checkForChanges, 20);
            });
        });
    });
</script>

