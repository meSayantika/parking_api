  body.nav-loader-active {
    overflow: hidden;
  }

  .global-nav-loader {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(241, 245, 249, 0.42);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s ease, visibility 0.22s ease;
    z-index: 200000;
  }

  .global-nav-loader.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  .global-nav-loader-box {
    min-width: 220px;
    padding: 24px 28px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(16, 185, 129, 0.18);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.14);
    text-align: center;
  }

  .global-nav-loader-spinner {
    width: 52px;
    height: 52px;
    margin: 0 auto 14px;
    border-radius: 50%;
    border: 4px solid rgba(16, 185, 129, 0.16);
    border-top-color: #059669;
    animation: globalNavSpin 0.8s linear infinite;
  }

  .global-nav-loader-text {
    color: #0f172a;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  @keyframes globalNavSpin {
    to {
      transform: rotate(360deg);
    }
  }

