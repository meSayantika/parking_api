<link href="/template/dist/css/operator-page.css" rel="stylesheet">

<div class="op-page-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card op-card">
                    <div class="card-body">

                        <!-- HEADER -->
                        <div class="op-header">
                            <div class="op-title-group">
                                <div class="op-icon-badge">
                                    <i data-feather="clock"></i>
                                </div>
                                <h3 class="op-page-title">Shift Settings</h3>
                            </div>
                            <button type="button" class="op-add-btn" id="myBtn">
                                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Shift
                            </button>
                        </div>

                        <!-- TABLE CONTENT -->
                        <div class="op-table-wrap mt-3">
                            <table id="example" class="table op-table no-wrap display">
                                <thead>
                                    <tr>
                                        <th>Sl. No.</th>
                                        <th>Shift Name</th>
                                        <th>From Time</th>
                                        <th>To Time</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(data.msg && data.msg.length > 0){
                                        data.msg.forEach(function(item,index) { %>
                                            <tr>
                                                <td><%=(index+1)%></td>
                                                <td style="font-weight: 600; color: var(--gray-800);"><%=item.shift_name %></td>
                                                <td>
                                                    <span class="badge badge-light-success text-success" style="font-weight: 600; border-radius: 6px; padding: 5px 10px;">
                                                        <i data-feather="sun" style="width:12px; height:12px; margin-right: 4px;"></i> <%=item.f_time %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge badge-light-info text-info" style="font-weight: 600; border-radius: 6px; padding: 5px 10px;">
                                                        <i data-feather="moon" style="width:12px; height:12px; margin-right: 4px;"></i> <%=item.t_time %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <a href="/shift/edit_shift_details?customer_id=<%=item.customer_id%>&&shift_id=<%= item.shift_id %>" 
                                                       class="action-btn-edit" title="Edit Shift">
                                                        <i class="fa fa-edit"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        <% });
                                    } else { %>
                                        <tr>
                                            <td colspan="5" style="color: var(--danger); font-weight: 500; padding: 30px; text-align: center;">No shift settings found</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add New Shift</b></h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <form action="/shift/add_save_shift" method="post" id="myForm">
                    <div class="row">
                        <div class="col-md-12 op-form-group">
                            <label class="op-label">Customer Name</label>
                            <input type="text" class="op-input" value="<%= user.user_data.customer_name %>" disabled style="background-color: var(--gray-50);">
                            <input type="hidden" name="cust_id" value="<%=user.user_data.customer_id %>">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 op-form-group">
                            <label class="op-label">Shift Name</label>
                            <input type="text" class="op-input" id="shift_name" name="shift_name" placeholder="Enter Shift Name (e.g. Morning Shift)" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 op-form-group">
                            <label class="op-label">From Time</label>
                            <input type="time" name="frm_time" id="frm_time" class="op-input" required>
                        </div>
                        <div class="col-md-6 op-form-group">
                            <label class="op-label">To Time</label>
                            <input type="time" name="to_time" id="to_time" class="op-input" required>
                        </div>
                    </div>

                    <div class="text-center mt-3">
                        <button type="submit" class="op-submit-btn" style="width: auto; padding: 10px 50px;">Save Shift</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Feather Icons
        if (typeof feather !== 'undefined') {
            feather.replace();
        }

        // Show Modal
        $("#myBtn").click(function () {
            $("#myModal").modal('show');
        });

        // DataTable Initialization matching GST section
        $('#example').DataTable({
            pageLength: 10,
            lengthMenu: [10, 25, 50, 100],
            ordering: false,
            responsive: true,
            autoWidth: false,
            language: {
                search: "Search Shift:",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                paginate: {
                    previous: "Prev",
                    next: "Next"
                }
            },
            drawCallback: function() {
                if (typeof feather !== 'undefined') {
                    feather.replace();
                }
            }
        });
    });
</script>