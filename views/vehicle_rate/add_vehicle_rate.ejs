<link href="/template/dist/css/vehicle-page.css" rel="stylesheet">

<style>
    /* Specific adjustment for Sl No margin */
    .show_data th:first-child, .show_data td:first-child {
        padding-left: 20px !important;
    }
</style>

<div class="veh-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card veh-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="veh-header">
              <div class="veh-title-group">
                <div class="veh-icon-badge" style="display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; color: white; line-height: 1;">
                  ₹
                </div>
                <h3 class="veh-page-title">Manage Vehicle Rate</h3>
              </div>
              <button type="button" class="veh-add-btn" id="myBtn">
                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Vehicle Rate
              </button>
            </div>

            <!-- FILTER SECTION -->
            <div class="veh-filter-sec mt-3">
              <div class="row align-items-end mb-2">
                <div class="col-md-4 veh-form-group mb-0">
                  <label class="veh-label"><i data-feather="percent" style="width:14px;height:14px;margin-right:4px;"></i> Rate Type</label>
                  <input type="text" class="veh-input" value="<%= user.user_data.dev_mod=='D' ? 'Hourly' : 'Fixed' %>" readonly style="background-color: var(--gray-50); cursor: not-allowed;">
                  <input type="hidden" id="rate_type" value="<%= user.user_data.dev_mod=='D' ? 'H' : 'F' %>">
                </div>
                <div class="col-md-4 veh-form-group mb-0">
                  <label class="veh-label"><i data-feather="truck" style="width:14px;height:14px;margin-right:4px;"></i> Vehicle Name</label>
                  <select name="veh_id" class="veh-select" id="veh_id" required>
                    <option value="">Select Vehicle Name</option>
                    <% data.forEach(dt => { %>
                      <option value="<%= dt.vehicle_id %>"><%= dt.vehicle_name %></option>
                    <% })%>
                  </select>
                </div>
                <div class="col-md-4" style="padding-top: 26px;">
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <button type="button" class="veh-submit-btn" id="submitBtn" style="width: auto; height: 48px; padding: 0 25px;">
                      <i data-feather="search" style="width:16px;height:16px;margin-right:6px;"></i> Fetch Details
                    </button>
                    <a href="/rate/vehicle_rate_dtls" class="veh-refresh-btn" title="Refresh List" style="height: 48px; width: 48px;">
                      <i data-feather="refresh-cw"></i>
                    </a>
                  </div>
                </div>
              </div>
              <input type="hidden" id="cust_id" name="cust_id" value="<%= data.customer_id %>">
            </div>

            <!-- TABLE CONTENT -->
            <div class="veh-table-wrap mt-4">
              <table id="example" class="table veh-table no-wrap show_data">
                <thead>
                  <tr>
                    <th class="text-center">Sl. No.</th>
                    <th class="text-center">From Hour</th>
                    <th class="text-center">To Hour</th>
                    <th class="text-center">Parking Fee</th>
                    <% if (user.user_data.dev_mod == 'D') { %>
                    <th class="text-center">Flag</th>
                    <% } %>   
                    <th class="text-center">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <!-- Content dynamically populated -->
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add Vehicle Rate</b></h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/rate/add_save_vehicle_rate" method="post" id="myForm">
          <div class="row">
            <div class="col-md-6 veh-form-group">
              <label class="veh-label">Rate Type</label>
              <input type="text" class="veh-input" value="<%= user.user_data.dev_mod=='D' ? 'Hourly' : 'Fixed' %>" readonly style="background-color: var(--gray-50);">
              <input type="hidden" name="rate_type" value="<%= user.user_data.dev_mod=='D' ? 'H' : 'F' %>">
            </div>
            <div class="col-md-6 veh-form-group">
              <label class="veh-label">Vehicle Name</label>
              <select name="veh_id" class="veh-select modal-select" required>
                <option value="">Select Vehicle</option>
                <% data.forEach(dt => { %>
                  <option value="<%= dt.vehicle_id %>"><%= dt.vehicle_name %></option>
                <% })%>
              </select>
            </div>
          </div>

          <div class="row">
            <div class="col-md-4 veh-form-group">
              <label class="veh-label">From Hour</label>
              <input type="number" class="veh-input" name="frm_hr" value="0" min="0">
            </div>
            <div class="col-md-4 veh-form-group">
              <label class="veh-label">To Hour</label>
              <input type="number" class="veh-input" name="to_hr" value="0" min="0">
            </div>
            <div class="col-md-4 veh-form-group">
              <label class="veh-label">Parking Fee (₹)</label>
              <input type="text" class="veh-input" name="park_fee" placeholder="0.00" required>
            </div>
          </div>

          <% if (user.user_data.dev_mod == 'D') { %>
          <div class="veh-form-group">
            <label class="veh-label">Rate Flag</label>
            <select name="flag" class="veh-select modal-select" required>
              <option value="">Select Flag</option>
              <option value="O">Old Rate</option>
              <option value="N">New Rate</option>
              <option value="C">Custom</option>
            </select>
          </div>
          <% } %>

          <div class="text-center mt-2">
            <button type="submit" class="veh-submit-btn" style="width: auto; padding: 10px 40px;">Save Rate Configuration</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // Feather Icons
    if (typeof feather !== 'undefined') {
        feather.replace();
    }

    // Initialize Select2
    $('.veh-select').select2({
      width: '100%'
    });

    // Modal Handling
    $("#myBtn").click(function () {
      $("#myModal").modal('show');
    });

    $('#myModal').on('shown.bs.modal', function() {
      $('.modal-select', this).select2({
        width: '100%',
        dropdownParent: $('#myModal')
      });
    });

    // DataTable Initialization
    var dataTable = $('#example').DataTable({
        pageLength: 10,
        lengthMenu: [10, 25, 50, 100],
        ordering: false,
        responsive: true,
        autoWidth: false,
        language: {
            search: "Search Rate:",
            lengthMenu: "Show _MENU_ entries",
            info: "Showing _START_ to _END_ of _TOTAL_ entries",
            paginate: { previous: "Prev", next: "Next" }
        },
        drawCallback: function() {
            if (typeof feather !== 'undefined') feather.replace();
        }
    });

    // Fetch Logic
    $('#submitBtn').click(function () {
      var veh_id = $('#veh_id').val();
      var rate_type = $('#rate_type').val();

      if(!veh_id) {
          alert('Please select a vehicle first');
          return;
      }

      $.ajax({
        type: "GET",
        url: "/rate/vehicle_details",
        data: { veh_id: veh_id, rate_type: rate_type },
        success: function (response) {
          dataTable.clear().draw();
          if (response.suc > 0 && response.msg.length > 0) {
            response.msg.forEach(function (item, index) {
              var flagHtml = '';
              <% if (user.user_data.dev_mod == 'D') { %>
              flagHtml = `<span class="badge ${item.night_day_flag === 'O' ? 'badge-warning' : item.night_day_flag === 'C' ? 'badge-success' : 'badge-primary'}" style="padding: 5px 10px; border-radius: 20px;">
                ${item.night_day_flag === 'O' ? 'Old Rate' : item.night_day_flag === 'C' ? 'Custom' : 'New Rate'}
              </span>`;
              <% } %>

              var actionHtml = `<a href="/rate/edit_vehicle_rate_details?customer_id=${item.customer_id}&sl_no=${item.sl_no}" class="action-btn-edit" title="Edit Rate">
                <i class="fa fa-edit"></i>
              </a>`;

              dataTable.row.add([
                index + 1,
                item.from_hour,
                item.to_hour,
                `<span style="font-weight: 600; color: var(--green-600);">₹ ${item.vehicle_rate}</span>`,
                <% if (user.user_data.dev_mod == 'D') { %> flagHtml, <% } %>
                actionHtml
              ]).draw(false);
            });
          } else {
             // DataTable handles empty message automatically, or we can add a row
          }
        },
        error: function (error) {
          alert('Error fetching data.');
        }
      });
    });
  });
</script>