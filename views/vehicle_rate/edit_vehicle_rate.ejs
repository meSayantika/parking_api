<link href="/template/dist/css/vehicle-page.css" rel="stylesheet">

<div class="veh-page-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card veh-card">
                    <div class="card-body">

                        <!-- HEADER -->
                        <div class="veh-header">
                            <div class="veh-title-group">
                                <div class="veh-icon-badge" style="display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; color: white; line-height: 1; width: 40px; height: 40px;">
                                    ₹
                                </div>
                                  <button type="button" class="veh-back-btn" id="back" title="Go Back">
                                    <i data-feather="arrow-left"></i>
                                </button>
                                <h3 class="veh-page-title ml-2">Edit Vehicle Rate</h3>
                            </div>
                        </div>

                        <!-- FORM CONTENT -->
                        <form action="/rate/edit_save_vehicle_rate" id="myForm" method="post" class="mt-4">
                            <input type="hidden" id="sl_no" name="sl_no" value="<%= data.sl_no %>">

                            <div class="row">
                                <div class="col-md-4 veh-form-group">
                                    <label class="veh-label">Rate Type</label>
                                    <input type="text" class="veh-input" value="<%= user.user_data.dev_mod=='D' ? 'Hourly' : 'Fixed' %>" readonly style="background-color: var(--gray-50);">
                                    <input type="hidden" name="rate_type" value="<%= user.user_data.dev_mod=='D' ? 'H' : 'F' %>">
                                </div>
                                <div class="col-md-4 veh-form-group">
                                    <label class="veh-label">Vehicle Name</label>
                                    <input type="text" class="veh-input" value="<%= data.vehicle_name %>" disabled style="background-color: var(--gray-100);">
                                </div>
                                <div class="col-md-4 veh-form-group">
                                    <label class="veh-label">Customer Name</label>
                                    <input type="text" class="veh-input" value="<%= data.customer_name %>" disabled style="background-color: var(--gray-100);">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 veh-form-group">
                                    <label class="veh-label">From Hour</label>
                                    <input type="number" class="veh-input" id="frm_hr" name="frm_hr" value="<%= data.from_hour %>" min="0">
                                </div>
                                <div class="col-md-4 veh-form-group">
                                    <label class="veh-label">To Hour</label>
                                    <input type="number" class="veh-input" id="to_hr" name="to_hr" value="<%= data.to_hour %>" min="0">
                                </div>
                                <div class="col-md-4 veh-form-group">
                                    <label class="veh-label">Parking Fee (₹)</label>
                                    <input type="text" class="veh-input" id="park_fee" name="park_fee" value="<%= data.vehicle_rate %>" required>
                                </div>
                            </div>

                            <% if (user.user_data.dev_mod == 'D') { %>
                            <div class="row">
                                <div class="col-md-4 veh-form-group">
                                    <label class="veh-label">Rate Flag</label>
                                    <select name="flag" class="veh-select" id="flag">
                                        <option value="O" <%= data.night_day_flag === 'O' ? 'selected' : '' %>>Old Rate</option>
                                        <option value="N" <%= data.night_day_flag === 'N' ? 'selected' : '' %>>New Rate</option>
                                        <option value="C" <%= data.night_day_flag === 'C' ? 'selected' : '' %>>Custom</option>
                                        <!-- <option value="UD" <%= data.night_day_flag === 'UD' ? 'selected' : '' %>>Upto 2 Days</option> -->
                                    </select>
                                </div>
                            </div>
                            <% } %>

                            <div class="text-center mt-2">
                                <button type="submit" id="submitBtn" class="veh-submit-btn" style="width: auto; padding: 10px 60px;" disabled>Update Rate Details</button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Feather Icons
        if (typeof feather !== 'undefined') {
            feather.replace();
        }

        // Initialize Select2
        $('.veh-select').select2({
            width: '100%'
        });

        // Back navigation
        $("#back").click(function () {
            window.location.href = "/rate/vehicle_rate_dtls";
        });

        // Change detection logic
        const initialValues = {
            frm_hr: $("#frm_hr").val(),
            to_hr: $("#to_hr").val(),
            park_fee: $("#park_fee").val(),
            flag: $("#flag").length ? $("#flag").val() : null
        };

        function checkForChanges() {
            let changed =
                $("#frm_hr").val() !== initialValues.frm_hr ||
                $("#to_hr").val() !== initialValues.to_hr ||
                $("#park_fee").val() !== initialValues.park_fee ||
                ($("#flag").length && $("#flag").val() !== initialValues.flag);

            $("#submitBtn").prop("disabled", !changed);
        }

        // Bind events
        $("#frm_hr, #to_hr, #park_fee").on("input change", checkForChanges);
        $("#flag").on("change", checkForChanges);
    });
</script>
