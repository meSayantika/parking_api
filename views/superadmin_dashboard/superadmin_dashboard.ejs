<link href="/template/dist/css/superadmin-dashboard.css" rel="stylesheet">

<%
  const dash = dashboard || {};
  const counts = dash.counts || {};
  const revenue = dash.revenue || {};
  const trend = dash.trend || [];
  const paymentModes = dash.paymentModes || [];
  const topCustomers = dash.topCustomers || [];
  const topLocations = dash.topLocations || [];
  const vehicleTypes = dash.vehicleTypes || [];
  const recentTransactions = dash.recentTransactions || [];
  const operatorPerCustomers = dash.operatorPerCustomers || [];
  const devicePerCustomers = dash.devicePerCustomers || [];

  const toCurrency = (value) => {
    const num = Number(value || 0);
    return num.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  };

  const toNumber = (value) => Number(value || 0).toLocaleString('en-IN');
%>

<div class="sad-page">
  <div class="sad-loader" id="dashboardLoader">
    <div class="sad-loader-box">
      <div class="sad-loader-spinner"></div>
      <div class="sad-loader-text">Loading dashboard data...</div>
    </div>
  </div>

  <div id="dashboardContent">
  <div class="container-fluid">
    <div class="sad-hero">
      <div class="sad-hero-copy">
        <div class="sad-overline">Superadmin Analytics</div>
        <h1 class="sad-title">Live parking dashboard built from your real system data</h1>
        <p class="sad-subtitle">
          Read operations, revenue, customer performance, payment mix, and recent activity from one clean screen.
        </p>
      </div>
      </div>
      <!-- <div class="sad-hero-stats">
        <div class="sad-mini-stat">
          <span class="sad-mini-label">Today Revenue</span>
          <strong>Rs. <%= toCurrency(revenue.today_revenue) %></strong>
        </div>
        <div class="sad-mini-stat">
          <span class="sad-mini-label">Today Entries</span>
          <strong><%= toNumber(counts.today_entries) %></strong>
        </div>
        <div class="sad-mini-stat">
          <span class="sad-mini-label">Active Parked</span>
          <strong><%= toNumber(counts.active_parked) %></strong>
        </div>
      </div> -->
    

    <div class="row sad-secondary-grid">
      <div class="col-xl-6 col-lg-12">
        <div class="sad-panel">
          <div class="sad-panel-head">
            <div>
              <div class="sad-panel-eyebrow">Customer Performance</div>
              <h3 class="sad-panel-title">Top customers by revenue</h3>
            </div>
          </div>
          <div class="sad-chart-wrap sad-chart-mid">
            <canvas id="customerRevenueChart"></canvas>
          </div>
        </div>
      </div>

      <div class="col-xl-6 col-lg-12">
        <div class="sad-panel">
          <div class="sad-panel-head">
            <div>
              <div class="sad-panel-eyebrow">Location Activity</div>
              <h3 class="sad-panel-title">Top locations by entries</h3>
            </div>
          </div>
          <div class="sad-chart-wrap sad-chart-mid">
            <canvas id="locationActivityChart"></canvas>
          </div>
        </div>
      </div>
    </div>

     <div class="sad-kpi-grid">
      <div class="sad-kpi-card">
        <div class="sad-kpi-icon sad-green"><i data-feather="map-pin"></i></div>
        <div class="sad-kpi-body">
          <div class="sad-kpi-value"><%= toNumber(counts.total_locations) %></div>
          <div class="sad-kpi-label">Locations</div>
        </div>
      </div>
      <div class="sad-kpi-card">
        <div class="sad-kpi-icon sad-teal"><i data-feather="user"></i></div>
        <div class="sad-kpi-body">
          <div class="sad-kpi-value"><%= toNumber(counts.total_sellers) %></div>
          <div class="sad-kpi-label">Sellers</div>
        </div>
      </div>
      <div class="sad-kpi-card">
        <div class="sad-kpi-icon sad-blue"><i data-feather="users"></i></div>
        <div class="sad-kpi-body">
          <div class="sad-kpi-value"><%= toNumber(counts.total_customers) %></div>
          <div class="sad-kpi-label">Customers</div>
        </div>
      </div>
      <div class="sad-kpi-card">
        <div class="sad-kpi-icon sad-orange"><i data-feather="user-check"></i></div>
        <div class="sad-kpi-body">
          <div class="sad-kpi-value"><%= toNumber(counts.total_operators) %></div>
          <div class="sad-kpi-label">Operators</div>
        </div>
      </div>
      <div class="sad-kpi-card">
        <div class="sad-kpi-icon sad-indigo"><i data-feather="truck"></i></div>
        <div class="sad-kpi-body">
          <div class="sad-kpi-value"><%= toNumber(counts.total_vehicles) %></div>
          <div class="sad-kpi-label">Vehicles</div>
        </div>
      </div>
      <div class="sad-kpi-card">
        <div class="sad-kpi-icon sad-red"><i data-feather="activity"></i></div>
        <div class="sad-kpi-body">
          <div class="sad-kpi-value"><%= toNumber(counts.total_entries) %></div>
          <div class="sad-kpi-label">Total Entries</div>
        </div>
      </div>
    </div>

    <div class="row sad-main-grid">
      <div class="col-xl-8 col-lg-12">
        <div class="sad-panel sad-panel-lg">
          <div class="sad-panel-head">
            <div>
              <div class="sad-panel-eyebrow">Revenue Trend</div>
              <h3 class="sad-panel-title">Last 7 days entries, paid amount and advance amount</h3>
            </div>
            <div class="sad-panel-chip">Live trend</div>
          </div>
          <div class="sad-chart-wrap">
            <canvas id="revenueTrendChart"></canvas>
          </div>
        </div>

        <div class="sad-panel">
          <div class="sad-panel-head">
            <div>
              <div class="sad-panel-eyebrow">Vehicle Mix</div>
              <h3 class="sad-panel-title">Top vehicle categories by entries and revenue</h3>
            </div>
            <div class="sad-panel-chip">Live category view</div>
          </div>
          <div class="sad-chart-wrap sad-chart-wide">
            <canvas id="vehicleTypeChart"></canvas>
          </div>
        </div>
      </div>

      <div class="col-xl-4 col-lg-12">
        <div class="sad-panel">
          <div class="sad-panel-head">
            <div>
              <div class="sad-panel-eyebrow">Collections</div>
              <h3 class="sad-panel-title">Revenue snapshot</h3>
            </div>
          </div>
          <div class="sad-amount-stack">
            <div class="sad-amount-card">
              <span class="sad-amount-label">Today Paid</span>
              <strong>Rs. <%= toCurrency(revenue.today_revenue) %></strong>
            </div>
            <div class="sad-amount-card">
              <span class="sad-amount-label">Today Advance</span>
              <strong>Rs. <%= toCurrency(revenue.today_advance) %></strong>
            </div>
            <div class="sad-amount-card">
              <span class="sad-amount-label">Month Paid</span>
              <strong>Rs. <%= toCurrency(revenue.month_revenue) %></strong>
            </div>
            <div class="sad-amount-card">
              <span class="sad-amount-label">Total Paid</span>
              <strong>Rs. <%= toCurrency(revenue.total_revenue) %></strong>
            </div>
          </div>
        </div>

        <div class="sad-panel">
          <div class="sad-panel-head">
            <div>
              <div class="sad-panel-eyebrow">Payment Mix</div>
              <h3 class="sad-panel-title">Mode-wise amount</h3>
            </div>
          </div>
          <div class="sad-donut-wrap">
            <canvas id="paymentModeChart"></canvas>
          </div>
          <div class="sad-legend-list">
            <% if (paymentModes.length) { %>
              <% paymentModes.forEach(function(mode){ %>
                <div class="sad-legend-item">
                  <span><%= mode.pay_mode == 'C' ? 'Cash' : mode.pay_mode == 'U' ? 'UPI' : 'Unknow' %></span>
                  <strong>Rs. <%= toCurrency(mode.total_amount) %></strong>
                </div>
              <% }) %>
            <% } else { %>
              <div class="sad-empty-inline">No payment data available</div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="row">
       <div class="col-md-6">
    <div class="sad-panel">
  <div class="sad-panel-head">
    <div>
      <div class="sad-panel-eyebrow">Operator Distribution</div>
      <h3 class="sad-panel-title">Operators per customer</h3>
    </div>
  </div>
  <div class="sad-chart-wrap sad-chart-mid">
    <canvas id="operatorCustomerChart"></canvas>
  </div>
</div>
 </div>

 <div class="col-md-6">
  <div class="sad-panel">
  <div class="sad-panel-head">
    <div>
      <div class="sad-panel-eyebrow">Device Distribution</div>
      <h3 class="sad-panel-title">Devices per customer</h3>
    </div>
  </div>
  <div class="sad-chart-wrap sad-chart-mid" style="height:300px;">
    <canvas id="deviceCustomerChart"></canvas>
  </div>
</div>
</div>

    <div class="sad-panel sad-table-panel">
      <div class="sad-panel-head">
        <div>
          <div class="sad-panel-eyebrow">Recent Activity</div>
          <h3 class="sad-panel-title">Latest transaction feed</h3>
        </div>
        <a href="/superadmin/view_trans" class="sad-link-chip">Open transaction page</a>
      </div>
      <div class="table-responsive sad-table-wrap">
        <table class="table sad-table">
          <thead>
            <tr>
              <th>Receipt</th>
              <th>Customer</th>
              <th>Vehicle</th>
              <th>Number</th>
              <th>Pay Mode</th>
              <th>Paid</th>
              <th>Advance</th>
              <th>Status</th>
              <th>Time</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentTransactions.length) { %>
              <% recentTransactions.forEach(function(item){ %>
                <tr>
                  <td><span class="sad-badge sad-badge-soft"><%= item.receipt_no || '-' %></span></td>
                  <td><strong><%= item.customer_name || 'Unknown' %></strong></td>
                  <td><%= item.vehicle_name || '-' %></td>
                  <td><%= item.vehicle_no || '-' %></td>
                  <td><%= item.pay_mode || 'Unknown' %></td>
                  <td class="sad-amount-text">Rs. <%= toCurrency(item.paid_amt) %></td>
                  <td class="sad-amount-text">Rs. <%= toCurrency(item.advance_amt) %></td>
                  <td>
                    <% if (item.car_out_flag === 'N') { %>
                      <span class="sad-status sad-status-live">In Parking</span>
                    <% } else { %>
                      <span class="sad-status sad-status-done">Completed</span>
                    <% } %>
                  </td>
                  <td><%= item.date_time_in || '-' %></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="9" class="sad-empty-table">No transaction data available yet</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
</div>

<script src="/template/assets/libs/chart.js/dist/Chart.bundle.min.js"></script>
<script>
  (function () {
    var trend = <%- JSON.stringify(trend) %>;
    var paymentModes = <%- JSON.stringify(paymentModes) %>;
    var topCustomers = <%- JSON.stringify(topCustomers) %>;
    var topLocations = <%- JSON.stringify(topLocations) %>;
    var vehicleTypes = <%- JSON.stringify(vehicleTypes) %>;
    var loader = document.getElementById('dashboardLoader');

    function hideLoader() {
      if (loader) {
        loader.classList.add('sad-loader-hidden');
      }
    }

    function safeLabels(list, field, fallbackLabel) {
      return list.length ? list.map(function (item) { return item[field]; }) : [fallbackLabel];
    }

    function safeNumbers(list, field) {
      return list.length ? list.map(function (item) { return Number(item[field] || 0); }) : [0];
    }

    Chart.defaults.global.defaultFontFamily = "'Inter', 'Segoe UI', sans-serif";
    Chart.defaults.global.defaultFontColor = '#64748b';

    var trendCtx = document.getElementById('revenueTrendChart');
    if (trendCtx) {
      new Chart(trendCtx, {
        type: 'bar',
        data: {
          labels: safeLabels(trend, 'day_label', 'No Data'),
          datasets: [
            {
              type: 'line',
              label: 'Paid Amount',
              data: safeNumbers(trend, 'total_paid'),
              borderColor: '#059669',
              backgroundColor: 'rgba(5, 150, 105, 0.12)',
              borderWidth: 3,
              fill: false,
              lineTension: 0.35,
              pointBackgroundColor: '#059669',
              pointRadius: 4
            },
            {
              type: 'line',
              label: 'Advance Amount',
              data: safeNumbers(trend, 'total_advance'),
              borderColor: '#f97316',
              backgroundColor: 'rgba(249, 115, 22, 0.10)',
              borderWidth: 2,
              fill: false,
              lineTension: 0.35,
              pointBackgroundColor: '#f97316',
              pointRadius: 3
            },
            {
              type: 'bar',
              label: 'Entries',
              data: safeNumbers(trend, 'total_entries'),
              backgroundColor: 'rgba(37, 99, 235, 0.16)',
              borderColor: '#2563eb',
              borderWidth: 1,
              yAxisID: 'y-axis-entries'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          legend: { position: 'bottom' },
          tooltips: { mode: 'index', intersect: false },
          scales: {
            yAxes: [
              {
                id: 'y-axis-amount',
                ticks: { beginAtZero: true },
                gridLines: { color: 'rgba(148, 163, 184, 0.12)' }
              },
              {
                id: 'y-axis-entries',
                position: 'right',
                ticks: { beginAtZero: true },
                gridLines: { display: false }
              }
            ],
            xAxes: [
              {
                gridLines: { display: false }
              }
            ]
          }
        }
      });
    }

    var paymentCtx = document.getElementById('paymentModeChart');
    if (paymentCtx) {
      new Chart(paymentCtx, {
        type: 'doughnut',
        data: {
          labels: safeLabels(paymentModes, 'pay_mode', 'No Data'),
          datasets: [{
            data: safeNumbers(paymentModes, 'total_amount'),
            backgroundColor: ['#059669', '#2563eb', '#f97316', '#dc2626', '#7c3aed', '#0f766e'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          legend: { display: false },
          cutoutPercentage: 68
        }
      });
    }

    var customerCtx = document.getElementById('customerRevenueChart');
    if (customerCtx) {
      new Chart(customerCtx, {
        type: 'horizontalBar',
        data: {
          labels: safeLabels(topCustomers, 'customer_name', 'No Customers'),
          datasets: [{
            label: 'Revenue',
            data: safeNumbers(topCustomers, 'total_revenue'),
            backgroundColor: ['#059669', '#10b981', '#34d399', '#6ee7b7', '#2563eb', '#7c3aed'],
            borderRadius: 10
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          legend: { display: false },
          scales: {
            xAxes: [{
              ticks: { beginAtZero: true },
              gridLines: { color: 'rgba(148, 163, 184, 0.12)' }
            }],
            yAxes: [{
              gridLines: { display: false }
            }]
          }
        }
      });
    }

    var locationCtx = document.getElementById('locationActivityChart');
    if (locationCtx) {
      new Chart(locationCtx, {
        type: 'bar',
        data: {
          labels: safeLabels(topLocations, 'location_name', 'No Locations'),
          datasets: [{
            label: 'Entries',
            data: safeNumbers(topLocations, 'total_entries'),
            backgroundColor: ['#059669', '#10b981', '#34d399', '#60a5fa', '#2563eb', '#7c3aed'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          legend: { display: false },
          scales: {
            xAxes: [{
              gridLines: { display: false }
            }],
            yAxes: [{
              ticks: { beginAtZero: true },
              gridLines: { color: 'rgba(148, 163, 184, 0.12)' }
            }]
          }
        }
      });
    }

    function shortLabel(label) {
  return label.length > 10 ? label.substring(0, 10) + '...' : label;
}

    var operatorData = <%- JSON.stringify(operatorPerCustomers) %>;

var operatorCtx = document.getElementById('operatorCustomerChart');

if (operatorCtx) {
  new Chart(operatorCtx, {
    type: 'bar',
    data: {
      labels: operatorData.map(item => shortLabel(item.customer_name)),
     datasets: [{
      label: 'Operators',
      data: safeNumbers(operatorData, 'total_operators'),
      backgroundColor: '#059669',
      borderRadius: 6,

      barThickness: 15,
      maxBarThickness: 18,
      categoryPercentage: 0.4,
      barPercentage: 0.6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      legend: { display: false },
      scales: {
        yAxes: [{
          ticks: { beginAtZero: true }
        }],
        xAxes: [{
          gridLines: { display: false },
          ticks: {
          maxRotation: 30,
          minRotation: 0,
          autoSkip: false,
          fontSize: 10
  }
        }]
      }
    }
  });
}

var deviceData = <%- JSON.stringify(devicePerCustomers) %>;

var deviceCtx = document.getElementById('deviceCustomerChart');

if (deviceCtx) {
  new Chart(deviceCtx, {
    type: 'bar',
    data: {
      labels: deviceData.map(item => shortLabel(item.customer_name)),
      datasets: [{
        label: 'Devices',
        data: safeNumbers(deviceData, 'total_devices'),
        backgroundColor: 'rgba(110, 204, 153, 1)',

        barThickness: 'flex',
        categoryPercentage: 0.5,
        barPercentage: 0.6,
        borderRadius: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      legend: { display: false },

      scales: {
        yAxes: [{
          ticks: {
            beginAtZero: true,
            stepSize: 5
          }
        }],
        xAxes: [{
          gridLines: { display: false },
          ticks: {
            maxRotation: 25,
            minRotation: 0
          }
        }]
      }
    }
  });
}

    var vehicleTypeCtx = document.getElementById('vehicleTypeChart');
    if (vehicleTypeCtx) {
      new Chart(vehicleTypeCtx, {
        type: 'bar',
        data: {
          labels: safeLabels(vehicleTypes, 'vehicle_name', 'No Vehicles'),
          datasets: [
            {
              type: 'bar',
              label: 'Entries',
              data: safeNumbers(vehicleTypes, 'total_entries'),
              backgroundColor: 'rgba(5, 150, 105, 0.16)',
              borderColor: '#059669',
              borderWidth: 1,
              yAxisID: 'vehicle-entries'
            },
            {
              type: 'line',
              label: 'Revenue',
              data: safeNumbers(vehicleTypes, 'total_revenue'),
              borderColor: '#2563eb',
              backgroundColor: 'rgba(37, 99, 235, 0.12)',
              borderWidth: 3,
              fill: false,
              lineTension: 0.35,
              pointBackgroundColor: '#2563eb',
              pointRadius: 4,
              yAxisID: 'vehicle-revenue'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          legend: { position: 'bottom' },
          scales: {
            yAxes: [
              {
                id: 'vehicle-entries',
                position: 'left',
                ticks: { beginAtZero: true },
                gridLines: { color: 'rgba(148, 163, 184, 0.12)' }
              },
              {
                id: 'vehicle-revenue',
                position: 'right',
                ticks: { beginAtZero: true },
                gridLines: { display: false }
              }
            ],
            xAxes: [{
              gridLines: { display: false }
            }]
          }
        }
      });
    }

    window.addEventListener('load', hideLoader);
    setTimeout(hideLoader, 1200);
  })();
</script>


<script>
const hasData = window.location.search.includes('loadData=1');

if (!hasData) {
    // show loader full screen
    document.getElementById('dashboardLoader').style.display = 'flex';

    window.location.href = window.location.pathname + '?loadData=1';
}
</script>

<script>
const content = document.getElementById("dashboardContent");
const loader = document.getElementById("dashboardLoader");

// 🔥 show blur + loader
function showLoading() {
    content.classList.add("sad-blur");
    loader.classList.add("sad-loader-active");
}

// 🔥 remove blur + loader
function hideLoading() {
    content.classList.remove("sad-blur");
    loader.classList.remove("sad-loader-active");
}

// 🔥 your reload logic
if (!window.location.search.includes('loadData=1')) {
    showLoading();

    setTimeout(() => {
        window.location.href = window.location.pathname + '?loadData=1';
    }, 300); // small delay for smooth UX
} else {
    // second load → data ready
    window.addEventListener("load", hideLoading);
}
</script>