<link href="/template/dist/css/operator-page.css" rel="stylesheet">

<div class="op-page-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card op-card">
                    <div class="card-body">

                        <!-- HEADER -->
                        <div class="op-header">
                            <div class="op-title-group">
                                <div class="op-icon-badge ml-2">
                                    <i data-feather="edit-3"></i>
                                </div>
                                 <button type="button" class="op-back-btn" id="back" title="Go Back">
                                    <i data-feather="arrow-left"></i>
                                </button>
                                <h3 class="op-edit-title">Edit GST Configuration</h3>
                            </div>
                        </div>

                        <!-- FORM CONTENT -->
                        <form action="/gst/save_edit_gst" id="myForm" method="post" class="mt-4">
                            <input type="hidden" name="gst_id" value="<%= data.msg[0].gst_id %>">

                            <div class="op-form-group">
                                <label class="op-label">GST Category</label>
                                <div class="d-flex align-items-center gap-4 mt-2">
                                    <label class="d-flex align-items-center gap-2 mb-0" style="cursor: pointer;">
                                        <input type="radio" name="gst_type" value="CS" <%= data.msg[0].gst_mode === 'CS' ? 'checked' : '' %> onclick="toggleGSTType()"> 
                                        <span style="font-size: 0.9rem; margin-left: 6px;">CGST / SGST</span>
                                    </label>
                                    <label class="d-flex align-items-center gap-2 mb-0 ml-4" style="cursor: pointer;">
                                        <input type="radio" name="gst_type" value="I" <%= data.msg[0].gst_mode === 'I' ? 'checked' : '' %> onclick="toggleGSTType()"> 
                                        <span style="font-size: 0.9rem; margin-left: 6px;">IGST</span>
                                    </label>
                                </div>
                            </div>

                            <div class="row mt-3">
                                <div class="col-md-6 op-form-group">
                                    <label class="op-label">GST Number</label>
                                    <input type="text" class="op-input" name="gst_num" id="gst_num" value="<%=data.msg[0].gst_number %>" placeholder="Enter Registration GSTIN" required>
                                </div>
                                <div class="col-md-6 op-form-group">
                                    <label class="op-label">Total GST Rate (%)</label>
                                    <select name="total_gst" class="op-input op-select" id="total_gst" required>
                                        <option value="0" <%= data.msg[0].total_gst=='0.00' ? 'selected' : '' %>>0%</option>
                                        <option value="5" <%= data.msg[0].total_gst=='5.00' ? 'selected' : '' %>>5%</option>
                                        <option value="12" <%= data.msg[0].total_gst=='12.00' ? 'selected' : '' %>>12%</option>
                                        <option value="18" <%= data.msg[0].total_gst=='18.00' ? 'selected' : '' %>>18%</option>
                                        <option value="28" <%= data.msg[0].total_gst=='28.00' ? 'selected' : '' %>>28%</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 op-form-group" id="cgstDiv">
                                    <label class="op-label">CGST Component</label>
                                    <input type="text" class="op-input" name="cgst" id="cgst" value="<%= data.msg[0].cgst %>" placeholder="Automatic" readonly style="background-color: var(--gray-100);">
                                </div>
                                <div class="col-md-4 op-form-group" id="sgstDiv">
                                    <label class="op-label">SGST Component</label>
                                    <input type="text" class="op-input" name="sgst" id="sgst" value="<%= data.msg[0].sgst %>" placeholder="Automatic" readonly style="background-color: var(--gray-100);">
                                </div>
                                <div class="col-md-4 op-form-group" id="igstDiv" style="display:none;">
                                    <label class="op-label">IGST Component</label>
                                    <input type="text" class="op-input" name="igst" id="igst" value="<%= data.msg[0].igst %>" placeholder="Automatic" readonly style="background-color: var(--gray-100);">
                                </div>
                            </div>

                            <div class="text-center mt-2">
                                <button type="submit" id="submitBtn" class="op-submit-btn" style="width: auto; padding: 10px 40px;" disabled>Update GST Details</button>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleGSTType() {
        const gstType = document.querySelector('input[name="gst_type"]:checked').value;
        const totalGST = parseFloat(document.getElementById('total_gst').value) || 0;

        if (gstType === "CS") {
            $("#cgstDiv").show();
            $("#sgstDiv").show();
            $("#igstDiv").hide();
            $("#cgst").val((totalGST / 2) + "%");
            $("#sgst").val((totalGST / 2) + "%");
            $("#igst").val("");
        } else {
            $("#cgstDiv").hide();
            $("#sgstDiv").hide();
            $("#igstDiv").show();
            $("#igst").val(totalGST + "%");
            $("#cgst").val("");
            $("#sgst").val("");
        }
    }

    $(document).ready(function () {
        // Feather Icons
        if (typeof feather !== 'undefined') {
            feather.replace();
        }

        // Initialize Select2
        $('.op-select').select2({
            width: '100%'
        });

        // Back button
        $("#back").click(function () {
            window.location.href = "/gst/show_gst";
        });

        // Change detection logic
        const initialValues = {
            gst_num: $("#gst_num").val(),
            total_gst: $("#total_gst").val(),
            gst_type: $('input[name="gst_type"]:checked').val()
        };

        function checkForChanges() {
            let changed =
                $("#gst_num").val() !== initialValues.gst_num ||
                $("#total_gst").val() !== initialValues.total_gst ||
                $('input[name="gst_type"]:checked').val() !== initialValues.gst_type;

            $("#submitBtn").prop("disabled", !changed);
        }

        // Initial run
        toggleGSTType();

        // Bind events
        $("#gst_num").on("input", checkForChanges);
        $("#total_gst").change(function () {
            toggleGSTType();
            checkForChanges();
        });
        $('input[name="gst_type"]').change(function () {
            toggleGSTType();
            checkForChanges();
        });
    });
</script>
