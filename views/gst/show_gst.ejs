<link href="/template/dist/css/operator-page.css" rel="stylesheet">

<!-- DataTables CSS/JS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<div class="op-page-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card op-card">
                    <div class="card-body">

                        <!-- HEADER -->
                        <div class="op-header">
                            <div class="op-title-group">
                                <div class="op-icon-badge">
                                    <i data-feather="tag"></i>
                                </div>
                                <h3 class="op-page-title">Manage GST</h3>
                            </div>
                            <button type="button" class="op-add-btn" id="myBtn">
                                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add GST
                            </button>
                        </div>

                        <!-- TABLE CONTENT -->
                        <div class="op-table-wrap mt-3">
                            <table id="example" class="table op-table no-wrap display">
                                <thead>
                                    <tr>
                                        <th>Sl. No.</th>
                                        <th>GST No.</th>
                                        <th>GST Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if(data.msg && data.msg.length> 0) { %>
                                        <% data.msg.forEach(function(item,index) { %>
                                            <tr>
                                                <td><%=(index+1)%></td>
                                                <td style="font-weight: 600; color: var(--gray-800);">
                                                    <code><%=item.gst_number %></code>
                                                </td>
                                                <td>
                                                    <span class="badge <%=(item.gst_flag=='Y')?'badge-success':'badge-danger'%>"
                                                        style="font-size: 0.8rem; padding: 5px 12px; border-radius: 20px;">
                                                        <%=(item.gst_flag=='Y')?"Active":"Deactive"%>
                                                    </span>
                                                </td>
                                                <td>
                                                    <a href="/gst/gst_edit?customer_id=<%=item.customer_id%>&&gst_id=<%= item.gst_id%>"
                                                        class="action-btn-edit" title="Edit GST">
                                                        <i class="fa fa-edit"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" style="color: var(--danger); font-weight: 500; padding: 30px; text-align: center;">No GST data available</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add GST</b></h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                <form action="/gst/save_add_gst" method="post" id="myForm">
                    
                    <div class="op-form-group">
                        <label class="op-label">GST Category</label>
                        <div class="d-flex align-items-center gap-4 mt-2">
                            <label class="d-flex align-items-center gap-2 mb-0" style="cursor: pointer;">
                                <input type="radio" name="gst_type" value="CS" checked onclick="toggleGSTType()"> 
                                <span style="font-size: 0.9rem; margin-left: 6px;">CGST / SGST</span>
                            </label>
                            <label class="d-flex align-items-center gap-2 mb-0 ml-4" style="cursor: pointer;">
                                <input type="radio" name="gst_type" value="I" onclick="toggleGSTType()"> 
                                <span style="font-size: 0.9rem; margin-left: 6px;">IGST</span>
                            </label>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6 op-form-group">
                            <label class="op-label">GST Number</label>
                            <input type="text" class="op-input" name="gst_num" id="gst_num" placeholder="Enter Registration GSTIN" required>
                        </div>
                        <div class="col-md-6 op-form-group">
                            <label class="op-label">Total GST Rate (%)</label>
                            <select name="total_gst" class="op-input op-select" id="total_gst" required>
                                <option value="">Select Rate</option>
                                <option value="0">0%</option>
                                <option value="5">5%</option>
                                <option value="12">12%</option>
                                <option value="18">18%</option>
                                <option value="28">28%</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 op-form-group" id="cgstDiv">
                            <label class="op-label">CGST Component</label>
                            <input type="text" class="op-input" name="cgst" id="cgst" value="" placeholder="Automatic" readonly style="background-color: var(--gray-100);">
                        </div>
                        <div class="col-md-4 op-form-group" id="sgstDiv">
                            <label class="op-label">SGST Component</label>
                            <input type="text" class="op-input" name="sgst" id="sgst" value="" placeholder="Automatic" readonly style="background-color: var(--gray-100);">
                        </div>
                        <div class="col-md-4 op-form-group" id="igstDiv" style="display:none;">
                            <label class="op-label">IGST Component</label>
                            <input type="text" class="op-input" name="igst" id="igst" value="" placeholder="Automatic" readonly style="background-color: var(--gray-100);">
                        </div>
                    </div>

                    <div class="text-center mt-2">
                        <button type="submit" class="op-submit-btn" style="width: auto; padding: 10px 40px;">Save GST Config</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleGSTType() {
        const gstType = document.querySelector('input[name="gst_type"]:checked').value;
        const totalGST = parseFloat(document.getElementById('total_gst').value) || 0;

        if (gstType === "CS") {
            $("#cgstDiv").show();
            $("#sgstDiv").show();
            $("#igstDiv").hide();
            document.getElementById('cgst').value = (totalGST / 2) + "%";
            document.getElementById('sgst').value = (totalGST / 2) + "%";
            document.getElementById('igst').value = "";
        } else {
            $("#cgstDiv").hide();
            $("#sgstDiv").hide();
            $("#igstDiv").show();
            document.getElementById('igst').value = totalGST + "%";
            document.getElementById('cgst').value = "";
            document.getElementById('sgst').value = "";
        }
    }

    $(document).ready(function () {
        // Feather Icons
        if (typeof feather !== 'undefined') {
            feather.replace();
        }

        // Show Modal
        $("#myBtn").click(function () {
            $("#myModal").modal('show');
        });

        // Initialize Select2
        $('.op-select').select2({
            width: '100%'
        });

        // Modal compatibility
        $('#myModal').on('shown.bs.modal', function() {
            $('.op-select', this).select2({
                width: '100%',
                dropdownParent: $('#myModal')
            });
        });

        // DataTable Initialization matching Operator section
        $('#example').DataTable({
            pageLength: 10,
            lengthMenu: [10, 25, 50, 100],
            ordering: false,
            responsive: true,
            autoWidth: false,
            language: {
                search: "Search GST:",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ entries",
                paginate: {
                    previous: "Prev",
                    next: "Next"
                }
            },
            drawCallback: function() {
                var api = this.api();
                var start = api.page.info().start;
                api.column(0, {page:'current'}).nodes().each(function(cell, i) {
                    cell.innerHTML = start + i + 1;
                });
                if (typeof feather !== 'undefined') {
                    feather.replace();
                }
            }
        });

        // Link change event
        $('#total_gst').on('change', toggleGSTType);
    });
</script>
