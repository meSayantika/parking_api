<link href="/template/dist/css/gst-page.css" rel="stylesheet">

<div class="gst-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card gst-card">
          <div class="card-body">
            
            <!-- HEADER -->
            <div class="gst-header" style="margin-bottom:10px;">
                <div class="gst-title-group">
                    <div class="gst-icon-badge">
                        <i data-feather="edit-3"></i>
                    </div>
                    <span class="gst-back-btn" id="back_btn" title="Back to GST" style="cursor:pointer;">
                        <i data-feather="arrow-left"></i>
                    </span>
                    <h3 class="gst-edit-title">Edit GST Details</h3>
                </div>
            </div>

            <!-- FORM -->
            <form action="/superadmin/gst_save" id="myForm" method="post">
                
                <div class="gst-form-group mt-4">
                    <label class="gst-label">GST Category</label>
                    <div class="gst-radio-group">
                        <label class="d-flex align-items-center gap-2 mb-0">
                            <input type="radio" name="gst_type" value="CS" <%= data && data[0] && data[0].gst_mode === 'CS' ? 'checked' : '' %> onclick="toggleGSTType()" class="gst-radio-input"> 
                            <span style="font-size: 0.9rem; margin-left: 4px;">CGST / SGST</span>
                        </label>
                        <label class="d-flex align-items-center gap-2 mb-0">
                            <input type="radio" name="gst_type" value="I" <%= data && data[0] && data[0].gst_mode === 'I' ? 'checked' : '' %> onclick="toggleGSTType()" class="gst-radio-input"> 
                            <span style="font-size: 0.9rem; margin-left: 4px;">IGST</span>
                        </label>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 gst-form-group">
                        <label class="gst-label">Customer Name</label>
                        <select name="cust_id_view" class="gst-select" id="cust_id" disabled style="background-color: var(--gray-100); cursor: not-allowed;">
                            <option value="">Select Customer Name</option>
                            <% customer.forEach(dt => { %>
                                <option value="<%= dt.customer_id %>" <%= dt.customer_id == data[0].customer_id ? 'selected' : '' %>><%= dt.customer_name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-6 gst-form-group">
                        <label class="gst-label">GST Number</label>
                        <input type="text" class="gst-input" name="gst_num" id="gst_num" value="<%=data[0].gst_number %>" placeholder="Enter Registration GSTIN" required>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 gst-form-group">
                        <label class="gst-label">Total GST Rate (%)</label>
                        <select name="total_gst" class="gst-select" id="total_gst" required>
                            <option value="0" <%= data[0].total_gst=='0.00' ? 'selected' : '' %>>0%</option>
                            <option value="5" <%= data[0].total_gst=='5.00' ? 'selected' : '' %>>5%</option>
                            <option value="12" <%= data[0].total_gst=='12.00' ? 'selected' : '' %>>12%</option>
                            <option value="18" <%= data[0].total_gst=='18.00' ? 'selected' : '' %>>18%</option>
                            <option value="28" <%= data[0].total_gst=='28.00' ? 'selected' : '' %>>28%</option>
                        </select>
                    </div>
                    <div class="col-md-3 gst-form-group" id="cgstDiv">
                        <label class="gst-label">CGST Component</label>
                        <input type="text" class="gst-input" name="cgst" id="cgst" value="<%=data[0].cgst %>" readonly style="background-color: var(--gray-100);">
                    </div>
                    <div class="col-md-3 gst-form-group" id="sgstDiv">
                        <label class="gst-label">SGST Component</label>
                        <input type="text" class="gst-input" name="sgst" id="sgst" value="<%=data[0].sgst %>" readonly style="background-color: var(--gray-100);">
                    </div>
                    <div class="col-md-3 gst-form-group" id="igstDiv" style="display:none;">
                        <label class="gst-label">IGST Component</label>
                        <input type="text" class="gst-input" name="igst" id="igst" value="<%=data[0].igst %>" readonly style="background-color: var(--gray-100);">
                    </div>
                </div>

                <div class="text-center mt-4 pt-2">
                    <input type="hidden" name="id" value="<%= id %>">
                    <input type="hidden" name="cust_id" value="<%= customer_id %>">
                    <button type="submit" id="submitBtn" class="gst-submit-btn" disabled>
                        Update GST Configuration
                    </button>
                </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleGSTType() {
    const gstType = document.querySelector('input[name="gst_type"]:checked').value;
    const totalGST = parseFloat(document.getElementById('total_gst').value) || 0;

    if (gstType === "CS") {
      $("#cgstDiv").show();
      $("#sgstDiv").show();
      $("#igstDiv").hide();

      document.getElementById('cgst').value = (totalGST / 2) + "%";
      document.getElementById('sgst').value = (totalGST / 2) + "%";
      document.getElementById('igst').value = "";
    } else {
      $("#cgstDiv").hide();
      $("#sgstDiv").hide();
      $("#igstDiv").show();

      document.getElementById('igst').value = totalGST + "%";
      document.getElementById('cgst').value = "";
      document.getElementById('sgst').value = "";
    }
  }

  $(document).ready(function () {
    // Initialize Select2
    $('.gst-select').select2({
      placeholder: 'Select an option',
      width: '100%'
    });

    // Back behavior
    $("#back_btn").click(function () {
        window.location.href = "/superadmin/gst";
    });

    // FUNCTION TO CALCULATE CGST/SGST
    function updateGST() {
        const gstValue = $("#total_gst").val();
        if (gstValue) {
            const half = gstValue / 2;
            $("#cgst").val(half + "%");
            $("#sgst").val(half + "%");
        } else {
            $("#cgst").val("");
            $("#sgst").val("");
        }
    }

    // Capture initial values for change detection
    const initialValues = {
        gst_num: $("#gst_num").val(),
        total_gst: $("#total_gst").val(),
        gst_type: $('input[name="gst_type"]:checked').val()
    };

    function checkForChanges() {
        let changed =
            $("#gst_num").val() !== initialValues.gst_num ||
            $("#total_gst").val() !== initialValues.total_gst ||
            $('input[name="gst_type"]:checked').val() !== initialValues.gst_type;

        $("#submitBtn").prop("disabled", !changed);
    }

    // Initial toggle
    toggleGSTType();

    // Event listeners
    $("#gst_num").on("input", checkForChanges);
    $("#total_gst").change(function () {
        toggleGSTType();
        checkForChanges();
    });
    $('input[name="gst_type"]').change(function () {
        toggleGSTType();
        checkForChanges();
    });
  });
</script>