<link href="/template/dist/css/gst-page.css" rel="stylesheet">

<div class="gst-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card gst-card">
          <div class="card-body">
            
            <!-- HEADER -->
            <div class="gst-header">
                <div class="gst-title-group">
                    <div class="gst-icon-badge">
                        <i data-feather="tag"></i>
                    </div>
                    <h3 class="gst-page-title">GST Management</h3>
                </div>
                <button type="button" class="gst-add-btn" data-toggle="modal" data-target="#myModal">
                    <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add GST Config
                </button>
            </div>

            <!-- TABLE -->
            <div class="gst-table-wrap mt-4">
              <table id="dataTable" class="table gst-table no-wrap">
                  <thead>
                      <tr>
                          <th>Sl No.</th>
                          <th>Customer Name</th>
                          <th>GST Number</th>
                          <th>Status</th>
                          <th>Action</th>
                      </tr>
                  </thead>
                  <tbody>
                    <% if(data.msg && data.msg.length> 0) { %>
                      <% data.msg.forEach(function(item,index) { %>
                        <tr>
                          <td><%=(index+1)%></td>
                          <td style="font-weight: 600; color: var(--gray-800);"><%=item.customer_name %></td>
                          <td><code><%=item.gst_number %></code></td>
                          <td>
                            <span class="gst-status-badge <%=(item.gst_flag=='Y')?'badge-active':'badge-inactive'%>">
                              <%=(item.gst_flag=='Y')?"Active":"Inactive"%>
                            </span>
                          </td>
                          <td>
                            <a href="edit_gst?id=<%= item.gst_id %>&customer_id=<%= item.customer_id %>"
                              class="action-btn-edit" title="Edit GST Config">
                              <i class="fa fa-edit"></i>
                            </a>
                          </td>
                        </tr>
                        <% }); %>
                      <% } else { %>
                        <tr>
                          <td colspan="5" style="color: var(--danger); font-weight: 500; padding: 30px; text-align: center;">No GST configuration found</td>
                        </tr>
                      <% } %>
                  </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add GST Configuration</b></h4>
          <button type="button" class="close" data-dismiss="modal">&times;</button>
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/superadmin/gst_save" method="post" id="myForm">
            
            <div class="gst-form-group">
                <label class="gst-label">GST Category</label>
                <div class="gst-radio-group">
                    <label class="d-flex align-items-center gap-2 mb-0">
                        <input type="radio" name="gst_type" value="CS" checked onclick="toggleGSTType()" class="gst-radio-input"> 
                        <span style="font-size: 0.9rem; margin-left: 4px;">CGST / SGST</span>
                    </label>
                    <label class="d-flex align-items-center gap-2 mb-0">
                        <input type="radio" name="gst_type" value="I" onclick="toggleGSTType()" class="gst-radio-input"> 
                        <span style="font-size: 0.9rem; margin-left: 4px;">IGST</span>
                    </label>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 gst-form-group">
                    <label class="gst-label">Customer Name</label>
                    <select name="cust_name" class="gst-select" id="cust_name" required>
                        <option value="">Select Customer</option>
                        <% customer.forEach(dt => { %>
                          <option value="<%= dt.customer_id %>"><%= dt.customer_name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-6 gst-form-group">
                    <label class="gst-label">GST Number</label>
                    <input type="text" class="gst-input" name="gst_num" id="gst_num" placeholder="Enter Registration GSTIN" required>
                </div>
            </div>

            <div class="row align-items-end">
                <div class="col-md-3 gst-form-group">
                    <label class="gst-label">Total GST Rate (%)</label>
                    <select name="total_gst" class="gst-select" id="total_gst" required>
                      <option value="">Select Rate</option>
                      <option value="0">0%</option>
                      <option value="5">5%</option>
                      <option value="12">12%</option>
                      <option value="18">18%</option>
                      <option value="28">28%</option>
                    </select>
                </div>
                <div class="col-md-3 gst-form-group" id="cgstDiv">
                    <label class="gst-label">CGST Component</label>
                    <input type="text" class="gst-input" name="cgst" id="cgst" value="" placeholder="Automatic" readonly style="background-color: var(--gray-100);">
                </div>
                <div class="col-md-3 gst-form-group" id="sgstDiv">
                    <label class="gst-label">SGST Component</label>
                    <input type="text" class="gst-input" name="sgst" id="sgst" value="" placeholder="Automatic" readonly style="background-color: var(--gray-100);">
                </div>
                <div class="col-md-3 gst-form-group" id="igstDiv" style="display:none;">
                    <label class="gst-label">IGST Component</label>
                    <input type="text" class="gst-input" name="igst" id="igst" value="" placeholder="Automatic" readonly style="background-color: var(--gray-100);">
                </div>
            </div>

            <div class="text-center mt-4 pt-2">
                <button type="submit" class="gst-submit-btn">Save GST Configuration</button>
            </div>
          </form>
        </div>
      </div>
    </div>
</div>

<script>
  function toggleGSTType() {
    const gstType = document.querySelector('input[name="gst_type"]:checked').value;
    const totalGST = parseFloat(document.getElementById('total_gst').value) || 0;

    if (gstType === "CS") {
      $("#cgstDiv").show();
      $("#sgstDiv").show();
      $("#igstDiv").hide();

      document.getElementById('cgst').value = (totalGST / 2) + "%";
      document.getElementById('sgst').value = (totalGST / 2) + "%";
      document.getElementById('igst').value = "";
    } else {
      $("#cgstDiv").hide();
      $("#sgstDiv").hide();
      $("#igstDiv").show();

      document.getElementById('igst').value = totalGST + "%";
      document.getElementById('cgst').value = "";
      document.getElementById('sgst').value = "";
    }
  }

  $(document).ready(function () {
    // Initialize Select2
    $('.gst-select').select2({
      placeholder: 'Select an option',
      width: '100%'
    });

    // Modal compatibility
    $('#myModal').on('shown.bs.modal', function() {
      $('.gst-select', this).select2({
        placeholder: 'Select an option',
        width: '100%',
        dropdownParent: $('#myModal')
      });
    });

    // Modal logic handled by data attributes
    $('#total_gst').on('change', toggleGSTType);
  });
</script>