<link href="/template/dist/css/customer-page.css" rel="stylesheet">

<div class="cust-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card cust-card">
          <div class="card-body">
            <!-- HEADER -->
            <div class="cust-header">
                <div class="cust-title-group">
                    <div class="cust-icon-badge">
                        <i data-feather="users"></i>
                    </div>
                    <h3 class="cust-page-title">Customer</h3>
                    <% if(data && data.length > 0) { %>
                      <span class="cust-count-badge">
                        <%= data.length %> total
                      </span>
                    <% } %>
                </div>
                <button type="button" class="cust-add-btn" data-toggle="modal" data-target="#myModal">
                    <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Customer
                </button>
            </div>

            <!-- TABLE -->
            <div class="table-responsive cust-table-wrap mt-4">
              <table id="dataTable" class="table cust-table no-wrap">
                <thead>
                  <tr>
                    <th>Sl No.</th>
                    <th>Customer Name</th>
                    <th>Seller Name</th>
                    <th>Mobile No.</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(data && data.length> 0) { %>
                    <% data.forEach(function(item,index) { %>
                      <tr>
                        <td><%=(index+1)%></td>
                        <td><b><%=item.customer_name %></b></td>
                        <td><%=item.seller_name %></td>
                        <td><%=item.mobile_no %></td>
                        <td>
                          <a href="edit_customer?id=<%= item.customer_id %>" class="cust-edit-btn" title="Edit Customer">
                            <i class="fa fa-edit"></i>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="sell-no-data">No customer data available</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i data-feather="plus-circle"></i><b> Add New Customer</b></h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/superadmin/customer_save" method="post" id="myForm">
          <div class="row">
            <div class="col-md-6 cust-form-group">
                <label class="cust-label">Seller Name</label>
                <select name="sell_name" class="cust-select" id="sell_name" required>
                  <option value="">Select Seller Name</option>
                  <% sell.forEach(dt=> { %>
                    <option value="<%= dt.seller_id %>"><%= dt.seller_name %></option>
                  <% })%>
                </select>
            </div>

            <div class="col-md-6 cust-form-group">
                <label class="cust-label">Customer Name</label>
                <input type="text" class="cust-input" id="cust_name" name="cust_name" placeholder="Full name of customer" required>
            </div>

            <div class="col-md-6 cust-form-group">
                <label class="cust-label">Location Name</label>
                <select name="loc_name" class="cust-select" id="loc_name" required>
                  <option value="">Select Location Name</option>
                  <% location.forEach(dt=> { %>
                    <option value="<%= dt.location_id %>"><%= dt.loction %></option>
                  <% })%>
                </select>
            </div>

            <div class="col-md-6 cust-form-group">
                <label class="cust-label">Phone Number</label>
                <input type="text" class="cust-input" id="phone" name="phone" placeholder="Contact number" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)" required>
            </div>

            <div class="col-md-6 cust-form-group">
                <label class="cust-label">Email Address</label>
                <input type="email" class="cust-input" id="email" name="email" placeholder="Email contact" required>
            </div>

            <div class="col-md-6 cust-form-group">
                <label class="cust-label">Mode</label>
                <select name="dev_mode" class="cust-select" id="dev_mode" required>
                  <option value="">Select Mode</option>
                  <option value="D">Dual</option>
                  <option value="F">Fixed</option>
                </select>
            </div>

            <div class="col-md-6 cust-form-group">
                <label class="cust-label">No. of Device</label>
                <input type="text" class="cust-input" id="no_device" name="no_device" placeholder="e.g. 1, 2, 3" required>
            </div>

            <div class="col-md-6 cust-form-group">
                <label class="cust-label">Customer Type</label>
                <select name="cust_type" class="cust-select" id="cust_type" required>
                  <option value="">Select Customer Type</option>
                  <option value="P">Parking</option>
                  <option value="T">Toll Plaza</option>
                </select>
            </div>

            <div class="col-md-6 cust-form-group">
                <label class="cust-label">Password</label>
                <input type="password" class="cust-input" id="password" name="password" placeholder="Set login password" required>
            </div>
    
            <div class="col-md-6 cust-form-group" id="upi_section" style="display:none;">
                <label class="cust-label">UPI ID</label>
                <input type="text" id="upi_id" name="upi_id" class="cust-input" placeholder="Enter UPI ID for payments">
            </div>

            <div class="col-md-12 cust-form-group">
                <label class="cust-label">Customer Address</label>
                <textarea class="cust-textarea" rows="3" id="cust_add" name="cust_add" placeholder="Complete office/business address..."></textarea>
            </div>
          </div>

          <div class="text-center mt-4 pt-2">
            <input type="hidden" name="id" value="0">
            <button type="submit" class="cust-submit-btn">Register Customer</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // Modal Select2 logic

    // Initialize Select2 on Modal open
    $('#myModal').on('shown.bs.modal', function () {
        $('.cust-select').select2({
          dropdownParent: $('#myModal'),
          placeholder: 'Select an option',
          width: '100%'
        });
    });

    // Device mode toggle logic
    $("#dev_mode").on("change", function () {
        if ($(this).val() === "F") {
            $("#upi_section").fadeIn();
        } else {
            $("#upi_section").fadeOut();
        }
    });
  });
</script>
