<link href="/template/dist/css/device_setting.css" rel="stylesheet">

<div class="dev-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card dev-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="dev-header">
              <div class="dev-title-group">
                <div class="dev-icon-badge">
                  <i data-feather="slack"></i>
                </div>
                <h3 class="dev-page-title">Device Setting</h3>
              </div>
              <button type="button" class="dev-add-btn" id="myBtn" data-toggle="modal" data-target="#myModal">
                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Device
              </button>
            </div>

            <!-- FILTER SECTION -->
            <div class="dev-filter-sec">
              <form action="/superadmin/device_setting" method="post">
                <div class="row align-items-end">
                  <div class="col-md-4 dev-form-group mb-0">
                    <label for="cust_name" class="dev-label">
                      <i data-feather="users" style="width:14px;height:14px;margin-right:4px;"></i> Customer Name
                    </label>
                    <select name="cust_name" class="dev-select" id="cust_name_filter" required>
                      <option value="">Select Customer Name</option>
                      <% customer.forEach(dt=> {
                        var _selected = ''
                        if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                        <option value="<%= dt.customer_id %>" <%=_selected %>><%= dt.customer_name %>
                        </option>
                        <% }) %>
                    </select>
                  </div>
                  <div class="col-md-4 dev-form-group mb-0">
                    <label for="dev_id_sel" class="dev-label">
                      <i data-feather="tablet" style="width:14px;height:14px;margin-right:4px;"></i> Device ID
                    </label>
                    <select name="dev_id" class="dev-select" id="dev_id_sel" required>
                      <option value="">Select Device ID</option>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <div style="white-space: nowrap;">
                      <button type="submit" class="dev-submit-btn" id="submitBtn">
                        <i data-feather="search" style="width:15px;height:15px;margin-right:6px;"></i> Filter
                      </button>
                      <a href="/superadmin/device_setting" class="dev-refresh-btn" style="margin-left:8px;" title="Refresh Page">
                        <i data-feather="refresh-cw"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </form>
            </div>

            <% if(selected.cust_id > 0){ %>
              <!-- TABLE CONTENT -->
              <div class="dev-table-wrap mt-4">
                <table id="dataTable" class="table dev-table no-wrap show_data">
                  <thead>
                    <tr>
                      <th>Sl No.</th>
                      <th>App ID</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if(data.length > 0){
                      var i = 1
                      data.forEach(dt => { %>
                      <tr>
                        <td>
                          <%= i %>
                        </td>
                        <td style="font-weight: 600; color: var(--gray-800);">
                          <%= dt.app_id %>
                        </td>
                        <td>
                          <a href='/superadmin/edit_device_setting?customer_id=<%= selected.cust_id %>&id=<%= dt.setting_id %>' class='action-btn-edit' title="Edit Device">
                            <i class="fa fa-edit"></i>
                          </a>
                        </td>
                      </tr>
                      <% i++; }) }else{ %>
                        <tr>
                          <td colspan="3" style="color: var(--danger); font-weight: 500; padding: 30px; text-align: center;">No data found</td>
                        </tr>
                        <% } %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-5 mt-4" style="background: var(--gray-50); border-radius: 12px; border: 1px dashed var(--gray-300);">
                <i data-feather="info" style="color: var(--gray-400); margin-bottom: 12px;"></i>
                <p style="color: var(--gray-500); font-size: 0.9rem;">Please select a customer and device above to view settings.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Bootstrap Toggle CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap4-toggle/css/bootstrap4-toggle.min.css" rel="stylesheet">

<!-- Bootstrap Toggle JS -->
<script defer src="https://cdn.jsdelivr.net/npm/bootstrap4-toggle/js/bootstrap4-toggle.min.js"></script>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add Device Setting</b></h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/superadmin/save_device_setting" method="post" id="myForm">
          <div class="row">
            <div class="col-md-3 dev-form-group">
              <label for="cust_id" class="dev-label">Customer Name</label>
              <select name="cust_id" class="dev-select" id="cust_id" required>
                <option value="">Select Customer Name</option>
                <% customer.forEach(dt=> { %>
                  <option value="<%= dt.customer_id %>">
                    <%= dt.customer_name %>
                  </option>
                  <% }) %>
              </select>
            </div>
            <div class="col-md-3 dev-form-group">
              <label for="dev_mode" class="dev-label">Mode</label>
              <select name="dev_mode" class="dev-select" id="dev_mode" readonly>
                <option value="">Select Mode</option>
              </select>
            </div>
            <div class="col-md-3 dev-form-group">
              <label for="app_id" class="dev-label">Device ID</label>
              <input type="text" class="dev-input" id="app_id" name="app_id" placeholder="Enter Device ID...." value="">
            </div>
            <div class="col-md-3 dev-form-group">
              <label for="dev_type" class="dev-label">Device Type</label>
              <select name="dev_type" class="dev-select" id="dev_type">
                <option value="">Select Device Type</option>
                <option value="H">Handheld Device</option>
                <option value="M">Mobile Device</option>
                <option value="A">Amigos Blue Handheld Device</option>
              </select>
            </div>

            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">GST Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="gst_flag" id="gst_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Report Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="report_flag" id="report_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Total Collection</label>
                <label class="dev-switch">
                  <input type="checkbox" name="tot_col" id="tot_col" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Redirection (H/B)</label>
                <label class="dev-switch switch-info">
                  <input type="checkbox" name="redirect_flag" id="redirect_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>

            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Grace Period</label>
                <label class="dev-switch">
                  <input type="checkbox" name="grace_flag" id="grace_flag" value="Y" checked>
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group" id="hide_grace">
              <label for="grace_value" class="dev-label">Grace Value (Min)</label>
              <input type="text" name="grace_value" id="grace_value" class="dev-input" value="00">
            </div>

            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Advance Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="adv_pay_flag" id="adv_pay_flag" value="Y" checked>
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group" id="hide_adv">
              <label for="adv_value" class="dev-label">Advance Value</label>
              <input type="text" name="adv_value" id="adv_value" class="dev-input" value="00">
            </div>

            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">Pay Mode Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="pay_mode_flag" id="pay_mode_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group">
              <div class="switch-container">
                <label class="dev-label">QR Code Flag</label>
                <label class="dev-switch">
                  <input type="checkbox" name="qr_code_flag" id="qr_code_flag" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group" id="day_wise_rate_container" style="display:none;">
              <div class="switch-container">
                <label class="dev-label">Day Wise Rate</label>
                <label class="dev-switch">
                  <input type="checkbox" name="day_wise_rate" id="day_wise_rate" value="Y">
                  <span class="dev-slider round"></span>
                </label>
              </div>
            </div>
            <div class="col-md-3 dev-form-group" id="default_pay_mode_box" style="display:none;">
              <label for="default_payment_mode" class="dev-label">Default Payment Mode</label>
              <select name="default_payment_mode" class="dev-select" id="default_payment_mode">
                <option value="">Select Payment Mode</option>
                <option value="C">CASH</option>
                <option value="U">UPI</option>
              </select>
            </div>
          </div>

          <div class="row mt-1">
            <input type="hidden" name="id" value="0">
            <div class="col-12 text-center">
              <button type="submit" id="set_dev_sub" class="dev-submit-btn">Register Device</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // Initialize Select2
    $('.dev-select').select2({
      placeholder: 'Select an option',
      width: '100%'
    });

    // Handle modal Select2 focus
    $('#myModal').on('shown.bs.modal', function () {
      $('.dev-select', this).select2({
        placeholder: 'Select an option',
        width: '100%',
        dropdownParent: $('#myModal')
      });
    });

    $("#myBtn").click(function () {
      $("#myModal").modal();
    });

    // Grace Period Toggle
    $('#grace_flag').on('change', function () {
      if ($(this).is(':checked')) {
        $('#hide_grace').show();
        $('#grace_value').attr('required', 'required');
      } else {
        $('#grace_value').removeAttr('required').val('00');
        $('#hide_grace').hide();
      }
    });

    // Advance Pay Toggle
    $('#adv_pay_flag').on('change', function () {
      if ($(this).is(':checked')) {
        $('#hide_adv').show();
        $('#adv_value').attr('required', 'required');
      } else {
        $('#adv_value').removeAttr('required').val('00');
        $('#hide_adv').hide();
      }
    });

    // GST vs Advance Logic
    $('#gst_flag').on('change', function () {
      if ($(this).prop('checked')) {
        $('#adv_pay_flag').prop('checked', false).trigger('change');
        $('#adv_pay_flag').closest('.dev-switch').addClass('disabled-opacity');
      } else {
        $('#adv_pay_flag').closest('.dev-switch').removeClass('disabled-opacity');
      }
    });

    $('#adv_pay_flag').change(function () {
      if ($('#gst_flag').prop('checked')) {
        $(this).prop('checked', false);
        return false;
      }
    });

    // Initial load for Customer Change
    var flag = <%= selected.dev_name != '' ? true : false %>;
    if (flag) {
      var cust_name = "<%= selected.cust_id != '' ? selected.cust_id : '' %>";
      change_cust(cust_name);
    }

    $('#cust_name_filter').on('change', function () {
      change_cust($(this).val());
    });

    function change_cust(cust_name) {
      $.ajax({
        type: "POST",
        url: "/superadmin/device_dt",
        data: { cust_name: cust_name },
        success: function (response) {
          $('#dev_id_sel').empty().append(`<option value="">Select Device ID</option>`);
          var sel_dev_id = "<%= selected.dev_name != '' ? selected.dev_name : 0 %>";
          response.SUCCESS.dev_id.msg.forEach(function (resData) {
            var _selected = (sel_dev_id == resData.app_id);
            $('#dev_id_sel').append($('<option>', { value: resData.app_id, text: resData.app_id, selected: _selected }));
          });
          $('#dev_id_sel').trigger('change');
        }
      });
    }

    // Modal Customer Change Logic
    $('#cust_id').change(function () {
      change_mod($(this).val());
    });

    function change_mod(cust_id) {
      $.ajax({
        type: "POST",
        url: "/superadmin/dev_dt",
        data: { cust_id: cust_id },
        success: function (response) {
          $('#dev_mode').empty().append(`<option value="">Select Mode</option>`);
          response.SUCCESS.dev_mod.msg.forEach(function (resData) {
            $('#dev_mode').append($('<option>', { 
              value: resData.dev_mod, 
              text: resData.dev_mod == 'D' ? 'Dual' : 'Fixed', 
              selected: true 
            }));
            toggleDayWiseRate(resData.dev_mod);
            toggleDefaultPaymentMode(resData.dev_mod);
          });
          $('#dev_mode').trigger('change');
        }
      });
    }

    function toggleDayWiseRate(mode) {
      if (mode === 'D') {
        $('#day_wise_rate_container').show();
      } else {
        $('#day_wise_rate_container').hide();
        $('#day_wise_rate').prop('checked', false).change();
      }
    }

    function toggleDefaultPaymentMode(mode) {
      if (mode === 'F') {
        $('#default_pay_mode_box').show();
        $('#default_payment_mode').attr('required', 'required'); 
      } else {
        $('#default_pay_mode_box').hide();
        $('#default_payment_mode').removeAttr('required').val("").trigger('change');
      }
    }

    $('#dev_mode').on('change', function () {
      toggleDefaultPaymentMode($(this).val());
      toggleDayWiseRate($(this).val());
    });
  });
</script>

