<link href="/template/dist/css/vehicle-page.css" rel="stylesheet">

<div class="veh-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card veh-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="veh-header">
              <div class="veh-title-group">
                <div class="veh-icon-badge">
                  <i data-feather="truck"></i>
                </div>
                <h3 class="veh-page-title">Vehicle Management</h3>
              </div>
              <button type="button" class="veh-add-btn" data-toggle="modal" data-target="#myModal">
                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Vehicle Type
              </button>
            </div>

            <!-- FILTER SECTION -->
            <div class="veh-filter-sec">
              <form action="/superadmin/vehicle" method="post">
                <div class="row align-items-end">
                  <div class="col-md-5 veh-form-group mb-0">
                    <label class="veh-label"><i data-feather="users"
                        style="width:14px;height:14px;margin-right:4px;"></i> Customer Name</label>
                    <select name="cust_name" class="veh-select" id="cust_name_filter" required>
                      <option value="">Select Customer to filter...</option>
                      <% customer.forEach(dt=> {
                        var _selected = ''
                        if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                        <option value="<%= dt.customer_id %>" <%=_selected %>><%= dt.customer_name %>
                        </option>
                        <% })%>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <div style="white-space: nowrap;">
                      <button type="submit" class="veh-submit-btn" id="submitBtn">
                        <i data-feather="search" style="width:15px;height:15px;margin-right:6px;"></i> Filter Results
                      </button>
                      <a href="/superadmin/vehicle" class="veh-refresh-btn" style="margin-left:8px;"
                        title="Refresh Page">
                        <i data-feather="refresh-cw"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </form>
            </div>

            <% if(selected.cust_id> 0){ %>
              <!-- TABLE -->
              <div class="veh-table-wrap mt-3">
                <table id="dataTable" class="table veh-table no-wrap">
                  <thead>
                    <tr>
                      <th>Sl No.</th>
                      <th>Vehicle Name</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if(data.length> 0){
                      var i = 1
                      data.forEach(dt => { %>
                      <tr>
                        <td>
                          <%= i %>
                        </td>
                        <td style="font-weight: 600; color: var(--gray-800);">
                          <%= dt.vehicle_name %>
                        </td>
                        <td>
                          <a href='/superadmin/edit_vehicle?customer_id=<%= selected.cust_id %>&id=<%= dt.vehicle_id %>'
                            class='action-btn-edit' title="Edit Vehicle">
                            <i class="fa fa-edit"></i>
                          </a>
                        </td>
                      </tr>
                      <% i++; }) }else{ %>
                        <tr>
                          <td colspan="3"
                            style="color: var(--danger); font-weight: 500; padding: 30px; text-align: center;">No
                            vehicles found for this customer</td>
                        </tr>
                        <% } %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
                <div class="text-center py-5"
                  style="background: var(--gray-50); border-radius: 12px; border: 1px dashed var(--gray-300);">
                  <i data-feather="info" style="color: var(--gray-400); margin-bottom: 12px;"></i>
                  <p style="color: var(--gray-500); font-size: 0.9rem;">Please select a customer above to view and
                    manage vehicles.</p>
                </div>
                <% } %>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add Vehicle
            Type</b></h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/superadmin/vehicle_save" method="post" id="myForm">
          <div class="row">
            <div class="col-md-6 veh-form-group">
              <label class="veh-label">Customer Name</label>
              <select name="cust_name" class="veh-select" id="cust_name_modal" required>
                <option value="">Select Customer</option>
                <% customer.forEach(dt=> { %>
                  <option value="<%= dt.customer_id %>">
                    <%= dt.customer_name %>
                  </option>
                  <% }) %>
              </select>
            </div>
            <div class="col-md-6 veh-form-group">
              <label class="veh-label">Vehicle Name</label>
              <input type="text" class="veh-input" id="veh_name" name="veh_name" placeholder="e.g. Car, Bike, Truck"
                required>
            </div>
          </div>

          <div class="text-center mt-4 pt-2">
            <input type="hidden" name="id" value="0">
            <button type="submit" class="veh-submit-btn">Register Vehicle Type</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // Initialize Select2
    $('.veh-select').select2({
      placeholder: 'Select an option',
      width: '100%'
    });

    // Modal compatibility
    $('#myModal').on('shown.bs.modal', function () {
      $('.veh-select', this).select2({
        placeholder: 'Select an option',
        width: '100%',
        dropdownParent: $('#myModal')
      });
    });

    // Initialize DataTable matching Operator section
    $('#dataTable').DataTable({
        pageLength: 10,
        lengthMenu: [10, 25, 50, 100],
        ordering: false,
        responsive: true,
        autoWidth: false,
        language: {
            search: "Search Vehicle:",
            lengthMenu: "Show _MENU_ entries",
            info: "Showing _START_ to _END_ of _TOTAL_ vehicles",
            paginate: {
                previous: "Prev",
                next: "Next"
            }
        },
        drawCallback: function() {
            if (typeof feather !== 'undefined') {
                feather.replace();
            }
        }
    });

    if (typeof feather !== 'undefined') {
        feather.replace();
    }
  });
</script>