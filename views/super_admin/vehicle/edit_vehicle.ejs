<link href="/template/dist/css/vehicle-page.css" rel="stylesheet">

<div class="veh-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card veh-card">
          <div class="card-body">
            
            <!-- HEADER -->
            <div class="veh-header" style="margin-bottom:20px;">
                <div class="veh-title-group">
                    <div class="veh-icon-badge">
                        <i data-feather="edit-3"></i>
                    </div>
                    <span class="veh-back-btn" id="back_btn" title="Back to Vehicle" style="cursor:pointer;">
                        <i data-feather="arrow-left"></i>
                    </span>
                    <h3 class="veh-edit-title">Edit Vehicle Type</h3>
                </div>
            </div>

            <!-- FORM -->
            <form action="/superadmin/vehicle_save" id="myForm" method="post">
                <div class="row mt-4">
                    <div class="col-md-6 veh-form-group">
                        <label class="veh-label">Customer Name</label>
                        <select name="cust_name_view" class="veh-select" id="cust_name" disabled style="background-color: var(--gray-100); cursor: not-allowed;">
                            <option value="">Select Customer Name</option>
                            <% customer.forEach(dt =>{ %>
                                <option value="<%= dt.customer_id %>" <%= dt.customer_id == data[0].customer_id ? 'selected' : '' %>><%= dt.customer_name %></option>
                             <% }) %>
                        </select>
                        <input type="hidden" name="cust_name" value="<%= data[0].customer_id %>">
                    </div>

                    <div class="col-md-6 veh-form-group">
                        <label class="veh-label">Vehicle Name</label>
                        <input type="text" class="veh-input" id="veh_name" name="veh_name" value="<%= data[0].vehicle_name%>" required placeholder="Name of the vehicle type">
                    </div> 
                </div>

                <div class="text-center mt-4 pt-2">
                    <input type="hidden" name="id" value="<%= id %>">
                    <input type="hidden" name="cust_id" value="<%= customer_id %>">
                    <button type="submit" id="submitBtn" class="veh-submit-btn" disabled>
                        Update Vehicle Type
                    </button>
                </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
    $(document).ready(function () {
        $("#back_btn").click(function () {
            window.location.href = "/superadmin/vehicle";
        });

        const $vehicleName = $("#veh_name");
        const $submitBtn = $("#submitBtn");
        const initialName = $vehicleName.val();

        // Enable when changed
        $vehicleName.on("input", function () {
            if ($(this).val().trim() !== initialName.trim()) {
                $submitBtn.prop("disabled", false);
            } else {
                $submitBtn.prop("disabled", true);
            }
        });
    });
</script>
