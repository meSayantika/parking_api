<link href="/template/dist/css/header_footer.css" rel="stylesheet">
<div class="hf-page-wrapper">
<div class="container-fluid">
    <div class="row">
      <div class="col-sm-12 col-md-12 col-lg-12">
        <div class="card hf-card">
          <div class="card-body">
          
            <!-- HEADER -->
            <div class="hf-header">
              <div class="hf-title-group">
                  <div class="hf-icon-badge">
                      <i data-feather="activity"></i>
                  </div>
                  <h3 class="hf-page-title">Header & Footer</h3>
                  <% if(data.msg && data.msg.length > 0) { %>
                    <span class="hf-count-badge"><%= data.msg.length %> total</span>
                  <% } %>
              </div>
              <button type="button" class="hf-add-btn" data-toggle="modal" data-target="#myModal">
                  <i data-feather="plus"></i> Add Header/Footer
              </button>
            </div>

            <div class="row">
              <div class="col-md-12">
                <div class="table-responsive hf-table-wrap mt-4">
                  <table id="dataTable" class="table hf-table no-wrap show_data">
                    <thead>
                        <tr>
                            <th>Sl No.</th>
                            <th>Customer Name</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                      <% if(data.msg && data.msg.length> 0) { %>
                        <% data.msg.forEach(function(item,index) { %>
                          <tr>
                            <td class="text-center">
                              <%=(index+1)%>
                            </td>
                            <td class="text-center"><b><%=item.customer_name %></b></td>
                            <td class="text-center">
                              <a href="edit_header_footer?id=<%= item.receipt_setting_id %>&customer_id=<%= item.customer_id %>"
                                class="action-btn-edit" title="Edit Details"><i class="fa fa-edit"></i></a>
                            </td>
                          </tr>
                          <% }); %>
                            <% } else { %>
                              <tr>
                                <td colspan="3" class="hf-no-data">No header & footer data available</td>
                              </tr>
                              <% } %>
                   
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
  <div class="modal fade loc-modal" id="myModal">
    <div class="modal-dialog modal-xl">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add Header Footer</b></h4>
          <button type="button" class="close" data-dismiss="modal">&times;</button>
        </div>

        <!-- Modal body -->
        <div class="modal-body">
          <form action="/superadmin/save_header_footer" method="post" id="myForm">
            <div class="row">
              <div class="col-12">
                <!-- <div class="hf-modal-intro">
                  Configure receipt header lines, footer lines, and print visibility in one clean setup panel.
                </div> -->
              </div>

              <div class="col-12">
                <div class="form-group hf-form-group">
                  <label for="cust_id" class="hf-label">Customer Name</label>
                  <select name="cust_id" class="hf-select hf-select2" id="cust_id">
                  <option value="">Select Customer Name</option>
                  <% customer.forEach(dt => { %>
                    <option value="<%= dt.customer_id %>"><%= dt.customer_name %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="col-12">
                <div class="hf-section-title">Header Lines</div>
              </div>

              <div class="col-md-9">
                <div class="form-group hf-form-group">
                  <label for="header_1" class="hf-label">Header 1 <span id="charCount1" class="char-count"><b>(0/30)</b></span></label>
                  <textarea class="hf-textarea" id="header_1" name="header_1" rows="2" placeholder="Enter header line 1"
                    maxlength="30" oninput="updateCharCount('header_1','charCount1')"></textarea>
                </div>
              </div>
              <div class="col-md-3 hf-form-group hf-inline-flag-group">
                <label for="header_1_flag" class="hf-label">Header 1 Flag</label>
                <label class="hf-modern-toggle" for="header_1_flag">
                  <input type="checkbox" value="1" id="header_1_flag" name="header_1_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui" aria-hidden="true">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>
  
              <div class="col-md-9">
                <div class="form-group hf-form-group">
                  <label for="header_2" class="hf-label">Header 2 <span id="charCount2"
                      class="char-count"><b>(0/30)</b></span></label>
                  <textarea class="hf-textarea" id="header_2" name="header_2" rows="2" placeholder="Enter header line 2"
                    maxlength="30" oninput="updateCharCount('header_2','charCount2')"></textarea>
                </div>
              </div>
              <div class="col-md-3 hf-form-group hf-inline-flag-group">
                <label for="header_2_flag" class="hf-label">Header 2 Flag</label>
                <label class="hf-modern-toggle" for="header_2_flag">
                  <input type="checkbox" value="1" id="header_2_flag" name="header_2_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui" aria-hidden="true">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>
  
              <div class="col-md-9">
                <div class="form-group hf-form-group">
                  <label for="header_3" class="hf-label">Header 3 <span id="charCount3"
                      class="char-count"><b>(0/30)</b></span></label>
                  <textarea class="hf-textarea" id="header_3" name="header_3" rows="2" placeholder="Enter header line 3"
                    maxlength="30" oninput="updateCharCount('header_3','charCount3')"></textarea>
                </div>
              </div>
  
              <div class="col-md-3 hf-form-group hf-inline-flag-group">
                <label for="header_3_flag" class="hf-label">Header 3 Flag</label>
                <label class="hf-modern-toggle" for="header_3_flag">
                  <input type="checkbox" value="1" id="header_3_flag" name="header_3_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui" aria-hidden="true">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>
  
              <div class="col-md-9">
                <div class="form-group hf-form-group">
                  <label for="header_4" class="hf-label">Header 4 <span id="charCount4"
                      class="char-count"><b>(0/30)</b></span></label>
                  <textarea class="hf-textarea" id="header_4" name="header_4" rows="2" placeholder="Enter header line 4"
                    maxlength="30" oninput="updateCharCount('header_4','charCount4')"></textarea>
                </div>
              </div>
  
              <div class="col-md-3 hf-form-group hf-inline-flag-group">
                <label for="header_4_flag" class="hf-label">Header 4 Flag</label>
                <label class="hf-modern-toggle" for="header_4_flag">
                  <input type="checkbox" value="1" id="header_4_flag" name="header_4_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui" aria-hidden="true">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>

              <div class="col-12">
                <div class="hf-section-title">Footer Lines</div>
              </div>

              <div class="col-md-9">
                <div class="form-group hf-form-group">
                  <label for="footer_1" class="hf-label">Footer 1 <span id="charCount5"
                      class="char-count"><b>(0/30)</b></span></label>
                  <textarea class="hf-textarea" id="footer_1" name="footer_1" rows="2" placeholder="Enter footer line 1"
                    maxlength="30" oninput="updateCharCount('footer_1','charCount5')"></textarea>
                </div>
              </div>
  
              <div class="col-md-3 hf-form-group hf-inline-flag-group">
                <label for="footer_1_flag" class="hf-label">Footer 1 Flag</label>
                <label class="hf-modern-toggle" for="footer_1_flag">
                  <input type="checkbox" value="1" id="footer_1_flag" name="footer_1_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui" aria-hidden="true">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>
  
              <div class="col-md-9">
                <div class="form-group hf-form-group">
                  <label for="footer_2" class="hf-label">Footer 2 <span id="charCount6"
                      class="char-count"><b>(0/30)</b></span></label>
                  <textarea class="hf-textarea" id="footer_2" name="footer_2" rows="2" placeholder="Enter footer line 2"
                    maxlength="30" oninput="updateCharCount('footer_2','charCount6')"></textarea>
                </div>
              </div>
  
              <div class="col-md-3 hf-form-group hf-inline-flag-group">
                <label for="footer_2_flag" class="hf-label">Footer 2 Flag</label>
                <label class="hf-modern-toggle" for="footer_2_flag">
                  <input type="checkbox" value="1" id="footer_2_flag" name="footer_2_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui" aria-hidden="true">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>
  
              <div class="col-md-9">
                <div class="form-group hf-form-group">
                  <label for="footer_3" class="hf-label">Footer 3 <span id="charCount7"
                      class="char-count"><b>(0/30)</b></span></label>
                  <textarea class="hf-textarea" id="footer_3" name="footer_3" rows="2" placeholder="Enter footer line 3"
                    maxlength="30" oninput="updateCharCount('footer_3','charCount7')"></textarea>
                </div>
              </div>
  
              <div class="col-md-3 hf-form-group hf-inline-flag-group">
                <label for="footer_3_flag" class="hf-label">Footer 3 Flag</label>
                <label class="hf-modern-toggle" for="footer_3_flag">
                  <input type="checkbox" value="1" id="footer_3_flag" name="footer_3_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui" aria-hidden="true">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>
  
              <div class="col-md-9">
                <div class="form-group hf-form-group">
                  <label for="footer_4" class="hf-label">Footer 4 <span id="charCount8"
                      class="char-count"><b>(0/30)</b></span></label>
                  <textarea class="hf-textarea" id="footer_4" name="footer_4" rows="2" placeholder="Enter footer line 4"
                    maxlength="30" oninput="updateCharCount('footer_4','charCount8')"></textarea>
                </div>
              </div>
  
              <div class="col-md-3 hf-form-group hf-inline-flag-group">
                <label for="footer_4_flag" class="hf-label">Footer 4 Flag</label>
                <label class="hf-modern-toggle" for="footer_4_flag">
                  <input type="checkbox" value="1" id="footer_4_flag" name="footer_4_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui" aria-hidden="true">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>

              <div class="col-12">
                <div class="hf-section-title">Print Visibility</div>
              </div>

              <div class="col-md-4 hf-form-group">
                <div class="hf-toggle-card">
                  <label for="in_on_off_flag" class="hf-label">IN Receipt</label>
                  <label class="hf-modern-toggle" for="in_on_off_flag">
                    <input type="checkbox" value="Y" id="in_on_off_flag" name="in_on_off_flag" class="hf-toggle-input">
                    <span class="hf-toggle-ui" aria-hidden="true">
                      <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                      <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                      <span class="hf-toggle-thumb"></span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="col-md-4 hf-form-group">
                <div class="hf-toggle-card">
                  <label for="out_on_off_flag" class="hf-label">OUT Receipt</label>
                  <label class="hf-modern-toggle" for="out_on_off_flag">
                    <input type="checkbox" value="Y" id="out_on_off_flag" name="out_on_off_flag" class="hf-toggle-input">
                    <span class="hf-toggle-ui" aria-hidden="true">
                      <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                      <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                      <span class="hf-toggle-thumb"></span>
                    </span>
                  </label>
                </div>
              </div>

              <div class="col-md-4 hf-form-group">
                <div class="hf-toggle-card">
                  <label for="report_flag" class="hf-label">Report</label>
                  <label class="hf-modern-toggle" for="report_flag">
                    <input type="checkbox" value="Y" id="report_flag" name="report_flag" class="hf-toggle-input">
                    <span class="hf-toggle-ui" aria-hidden="true">
                      <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                      <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                      <span class="hf-toggle-thumb"></span>
                    </span>
                  </label>
                </div>
              </div>
            </div>
            <div class="row mt-5 pt-2">
              <div class="col-12 text-center">
                <button type="submit" class="hf-submit-btn">Register Header Footer</button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

<script>
    $(document).ready(function () {
      $('#myModal').on('shown.bs.modal', function () {
        if (!$('#cust_id').hasClass('select2-hidden-accessible')) {
          $('#cust_id').select2({
            dropdownParent: $('#myModal'),
            placeholder: 'Select Customer Name',
            width: '100%'
          });
        }
      });
    });
  </script>

<script>
  function updateCharCount(textareaId, countId) {
    var textarea = document.getElementById(textareaId);
    var charCount = document.getElementById(countId);

    if (textarea && charCount) {
      var count = textarea.value.length;
      charCount.innerHTML = '<span style="font-weight: bold;">(' + count + '/30)</span>';
    }
  }
</script>
