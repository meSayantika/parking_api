<script>
    updateCharCount('header_1', 'charCount1');
    updateCharCount('header_2', 'charCount2');
    updateCharCount('header_3', 'charCount3');
    updateCharCount('header_4', 'charCount4');
    updateCharCount('footer_1', 'charCount5');
    updateCharCount('footer_2', 'charCount6');
    updateCharCount('footer_3', 'charCount7');
    updateCharCount('footer_4', 'charCount8');
    function updateCharCount(textareaId, countId) {
      var textarea = document.getElementById(textareaId);
      var charCount = document.getElementById(countId);
  
      if (textarea && charCount) {
      var count = textarea.value.length;
      charCount.innerHTML  ='<span style="font-weight: bold;">(' + count + '/30)</span>';
    }
  }
  </script>

<script>
(function () {
  // DROP-IN: Paste this after jQuery + bootstrap-toggle scripts
  const DEBUG = true; // set false to silence debug logs

  function dbg(...args) { if (DEBUG) console.log(...args); }

  // All fields to track (IDs as used in your HTML)
  const FIELDS = [
    "header_1","header_1_flag",
    "header_2","header_2_flag",
    "header_3","header_3_flag",
    "header_4","header_4_flag",
    "footer_1","footer_1_flag",
    "footer_2","footer_2_flag",
    "footer_3","footer_3_flag",
    "footer_4","footer_4_flag",
    "in_on_off_flag",
    "out_on_off_flag",
    "report_flag"
  ];

  // helper: ensure bootstrap-toggle is initialized on inputs with data-toggle
  function initBootstrapToggles() {
    $('input[data-toggle="toggle"]').each(function () {
      try { $(this).bootstrapToggle(); } catch (e) { /* ignore */ }
    });
  }

  // helper: return normalized value for an element id
  function getFieldValue(id) {
    const $el = $('#' + id);
    if (!$el.length) return null;

    // checkbox (toggle)
    if ($el.is(':checkbox')) {
      // normalize to "1" or "0" (fits your backend markup)
      return $el.prop('checked') ? '1' : '0';
    }

    // textarea/select/input -> trim text
    const val = $el.val();
    return (typeof val === 'string') ? val.trim() : (val == null ? '' : String(val));
  }

  // query valid fields that exist on page
  function getValidFields() {
    return FIELDS.filter(id => $('#' + id).length > 0);
  }

  // compute snapshot object for given field list
  function snapshot(fields) {
    const s = {};
    fields.forEach(id => s[id] = getFieldValue(id));
    return s;
  }

  // compare two snapshots: return {changed: bool, diffs: array of {id, before, after}}
  function compareSnapshots(before, after) {
    const diffs = [];
    const keys = Object.keys(before);
    for (const k of keys) {
      const a = before[k];
      const b = after[k];
      // treat null/undefined and '' carefully: normalize
      if ((a || '') !== (b || '')) diffs.push({ id: k, before: a, after: b });
    }
    return { changed: diffs.length > 0, diffs };
  }

  // main initializer
  function initChangeDetection() {
    initBootstrapToggles();

    const validFields = getValidFields();
    if (!validFields.length) {
      dbg('No trackable fields found. Make sure IDs are correct.');
    }

    // Wait for toggles to render - poll until toggles present or timeout
    const pollUntilReady = (done, timeout = 1500) => {
      const start = Date.now();
      (function poll() {
        // consider ready when all checkbox inputs exist and either have .parent().find('.toggle') OR we simply allow after timeout
        const allPresent = validFields.every(id => !!$('#' + id).length);
        const togglesPresent = $('input[data-toggle="toggle"]').length === 0 || $('input[data-toggle="toggle"]').parent().find('.toggle').length > 0;
        if (allPresent && togglesPresent) return done(true);
        if (Date.now() - start > timeout) return done(false);
        setTimeout(poll, 40);
      })();
    };

    // We'll capture initial snapshot after ready
    pollUntilReady((ready) => {
      // re-init toggles in case they weren't fully init earlier
      initBootstrapToggles();

      const initial = snapshot(validFields);
      dbg('Captured initial snapshot:', initial);

      // function that reads current and updates submit state
      const $submit = $('#submitBtn');
      if (!$submit.length) {
        console.error('submitBtn not found. Ensure <input id="submitBtn"> exists.');
        return;
      }

      function evaluate() {
        const now = snapshot(validFields);
        const cmp = compareSnapshots(initial, now);
        if (cmp.changed) {
          $submit.prop('disabled', false);
        } else {
          $submit.prop('disabled', true);
        }
        dbg('Evaluate change — changed:', cmp.changed, 'diffs:', cmp.diffs);
      }

      // Debounce wrapper
      let debounceTimer = null;
      function scheduleEval(delay = 30) {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => { evaluate(); debounceTimer = null; }, delay);
      }

      // attach events robustly:
      // - inputs and textareas -> input event
      // - selects and number/time input -> change event
      // - checkboxes -> change event (toggle's UI triggers change), and click on parent toggle UI as backup
      validFields.forEach(id => {
        const $el = $('#' + id);
        if (!$el.length) return;

        if ($el.is(':checkbox')) {
          // listen to change on the checkbox
          $el.off('.chgDet').on('change.chgDet', () => scheduleEval(40));

          // also listen to clicks on the visible toggle UI (if any)
          const $ui = $el.parent().find('.toggle');
          if ($ui.length) {
            $ui.off('.chgDet').on('click.chgDet', () => scheduleEval(60));
          } else {
            // fallback: monitor clicks in parent area
            $el.parent().off('.chgDet').on('click.chgDet', () => scheduleEval(60));
          }

          // keyboard toggles
          $el.off('keyup.chgDet').on('keyup.chgDet', (e) => {
            if (e.key === ' ' || e.key === 'Enter') scheduleEval(40);
          });

        } else if ($el.is('textarea') || $el.is('input')) {
          $el.off('.chgDet').on('input.chgDet', () => scheduleEval(20));
        } else if ($el.is('select')) {
          $el.off('.chgDet').on('change.chgDet', () => scheduleEval(20));
        } else {
          // generic
          $el.off('.chgDet').on('input.chgDet change.chgDet', () => scheduleEval(20));
        }
      });

      // MutationObserver fallback: if DOM changes (some other script updates values), re-evaluate
      // const observer = new MutationObserver(() => scheduleEval(50));
      // observer.observe(document.body, { attributes: true, childList: true, subtree: true });

      // One final evaluate on load
      scheduleEval(60);

      // Expose utilities for debugging via window
      window.__changeDet = {
        initial,
        fields: validFields,
        snapshotNow: () => snapshot(validFields),
        compareNow: () => compareSnapshots(initial, snapshot(validFields))
      };

    }); // pollUntilReady
  } // initChangeDetection

  // Start on DOM ready
  $(document).ready(function () {
    try {
      initChangeDetection();
    } catch (err) {
      console.error('Change detection init error:', err);
    }
  });

})();
</script>