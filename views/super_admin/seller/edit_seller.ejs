<link href="/template/dist/css/seller-page.css" rel="stylesheet">

<div class="sell-page-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card sell-card">
                    <div class="card-body">
                        <!-- HEADER -->
                        <div class="sell-header" style="margin-bottom:20px;">
                            <div class="sell-title-group">
                                <div class="sell-icon-badge">
                                    <i data-feather="edit-3"></i>
                                </div>
                                <span class="sell-back-btn" id="back" title="Back to Seller">
                                    <i data-feather="arrow-left" class="feather-icon"></i>
                                </span>
                                <h3 class="sell-edit-title">Edit Seller</h3>
                            </div>
                        </div>

                        <!-- FORM -->
                        <form action="/superadmin/seller_add" id="myForm" method="post">
                            <div class="row mt-4">
                                <div class="col-md-6 sell-form-group">
                                    <label class="sell-label">Seller Name</label>
                                    <input type="text" class="sell-input" id="sell_name" name="sell_name" value="<%= data[0].seller_name%>" required>
                                </div>

                                <div class="col-md-6 sell-form-group">
                                    <label class="sell-label">Phone Number</label>
                                    <input type="text" class="sell-input" id="phone" name="phone" value="<%= data[0].seller_mob%>" maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)" required>
                                </div>

                                <div class="col-md-6 sell-form-group">
                                    <label class="sell-label">Email Address</label>
                                    <input type="email" class="sell-input" id="email" name="email" value="<%= data[0].email%>" required>
                                </div>

                                <div class="col-md-6 sell-form-group">
                                    <label class="sell-label">Location Name</label>
                                    <select name="loc_name" class="sell-select" id="loc_name" required>
                                        <option value="">Select Location</option>
                                        <% location.forEach(dt => { %>
                                            <option value="<%= dt.location_id %>" <% if (dt.location_id == data[0].location_id) { %> selected <% } %>><%= dt.loction %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="col-md-12 sell-form-group">
                                    <label class="sell-label">Seller Address</label>
                                    <textarea class="sell-textarea" rows="3" id="sell_add" name="sell_add" required><%= data[0].seller_addr%></textarea>
                                </div>
                            </div>

                            <div class="text-center mt-4 pt-2">
                                <input type="hidden" name="id" value="<%= id %>">
                                <button type="submit" class="sell-submit-btn">Update Seller Details</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scripts for Select2 initialized via main.ejs -->
<script>
    $(document).ready(function () {
      $("#back").click(function () {
        window.location.href = "/superadmin/seller";
      });

      // Initialize Select2
      $('.sell-select').select2({
        placeholder: 'Select an option',
        width: '100%'
      });
    });
</script>