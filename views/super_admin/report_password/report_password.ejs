<style>
  .cust-toggle1 .toggle {
      width: 100% !important;
  }
</style>
<link href="/template/dist/css/report_password.css" rel="stylesheet">
<div class="rp-page-wrapper">
<div class="container-fluid">
  <div class="col-sm-12 col-md-12 col-lg-12">
    <div class="card rp-card">
      <div class="card-body">
        
        <!-- HEADER -->
        <div class="rp-header">
            <div class="rp-title-group">
                <div class="rp-icon-badge">
                    <i data-feather="key"></i>
                </div>
                <h3 class="rp-page-title">Report Password</h3>
            </div>
        </div>

        <div class="row">
          <div class="col-md-12">
            <div class="rp-table-wrap mt-3">
              <table id="dataTable" class="table rp-table no-wrap show_data">
                  <thead>
                      <tr>
                          <th>Sl No.</th>
                          <th>Customer Name</th>
                          <th>Action</th>
                      </tr>
                  </thead>
                  <tbody>
                    <% if(data.msg && data.msg.length> 0) { %>
                      <% data.msg.forEach(function(item,index) { %>
                        <tr>
                          <td class="text-center">
                            <%=(index+1)%>
                          </td>
                          <td class="text-center" style="font-weight: 600; color: var(--gray-800);">
                            <%=item.customer_name %>
                          </td>
                          <td class="text-center">
                            <a href="edit_report_pass?customer_id=<%= item.customer_id %>"
                              class="action-btn-edit" title="Edit Password"><i class="fa fa-edit"></i></a>
                          </td>
                        </tr>
                        <% }); %>
                          <% } else { %>
                            <tr>
                              <td colspan="3" class="text-danger text-center">No data available</td>
                            </tr>
                            <% } %>
                 
                  </tbody>
                  <tfoot>
                     
                  </tfoot>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

<link href="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/css/bootstrap4-toggle.min.css"
rel="stylesheet">
<script src="https://cdn.jsdelivr.net/gh/gitbrent/bootstrap4-toggle@3.6.1/js/bootstrap4-toggle.min.js"></script>

<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add Report Password</b></h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/superadmin/save_report_pass" method="post" id="myForm">
          <div class="row">
              <div class="form-group rp-form-group col-md-12">
                  <label for="cust_id" class="rp-label">Customer Name</label>
                  <select name="cust_id" class="rp-select" id="cust_id">
                    <option value="">Select Customer Name</option>
                      <% customer.forEach(dt => { %>
                        <option value="<%= dt.customer_id %>"><%= dt.customer_name %></option>
                      <% }) %>
                  </select>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6 rp-form-group">
                        <div class="switch-container">
                            <label class="rp-label">Report Password Flag</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="report_pwd" name="report_pwd" checked>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6 rp-form-group" id="details">
                        <label class="rp-label">New Password</label>
                        <div class="input-group">
                            <input type="password" id="pwd" name="pwd" class="rp-input" placeholder="Enter new password here.....">
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword" style="border-radius: 0 10px 10px 0; border: 1.5px solid var(--gray-200); border-left: none; background: var(--gray-100);">
                                    <i class="fa fa-eye-slash" id="eyeIcon"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
          </div>
          <div class="row mt-4 pt-2">
              <input type="hidden" name="id" value="0">
              <div class="col-12 text-center">
                  <button type="submit" id="submitButton" class="rp-submit-btn">Register Password</button>
              </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    $("#myBtn").click(function () {
      $("#myModal").modal();
    });
  });
</script>

<script>
  function checkInput() {
      var pwd = document.getElementById("pwd");
      var submitButton = document.getElementById("submitButton");

      if (pwd.value.trim() !== "") {
          submitButton.disabled = false;
      } else {
          submitButton.disabled = true;
      }
  }
</script>

<script>
  document.getElementById("togglePassword").addEventListener("click", function () {
    const pwdField = document.getElementById("pwd");
    if (pwdField.type === "password") {
      pwdField.type = "text";
    } else {
      pwdField.type = "password";
    }
  });
</script>

<script>
  $('#report_pwd').on('change', function () {
    if ($(this).is(':checked')) {
      $('#details').show()
      if($('#pwd').val().length == 0)
        $('#submitButton').attr('disabled', true)
    } else {
      $('#submitButton').removeAttr('disabled')
      $('#details').hide()
    }
  })
  $(document).ready(function(){
    var chk_flag = "Y"
    if(chk_flag != 'N'){
      $('#details').show()
      console.log($('#pwd').val().length, 'val');
      if($('#pwd').val().length == 0)
        $('#submitButton').attr('disabled', true)
    }else{
      $('#submitButton').removeAttr('disabled')
      $('#details').hide();
    }
  })
</script>