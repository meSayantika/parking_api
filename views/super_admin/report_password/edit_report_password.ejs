<link href="/template/dist/css/report_password.css" rel="stylesheet">

<div class="rp-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card rp-card">
          <div class="card-body">
            
            <!-- HEADER -->
            <div class="rp-header" style="margin-bottom:20px;">
                <div class="rp-title-group">
                    <div class="rp-icon-badge">
                        <i data-feather="key"></i>
                    </div>
                    <span class="rp-back-btn" id="back" title="Back to Report Passwords">
                        <i data-feather="arrow-left"></i>
                    </span>
                    <h3 class="rp-edit-title">Edit Report Password</h3>
                </div>
            </div>

            <!-- FORM -->
            <form action="/superadmin/save_report_pass" id="myForm" method="post">
                <div class="row mt-1">
                    <div class="col-md-2 rp-form-group">
                        <div class="switch-container">
                            <label class="rp-label">Report Password Flag</label>
                            <label class="dev-switch">
                                <input type="checkbox" value="Y" id="report_pwd" name="report_pwd" <%= data[0].report_password_flag != 'N' ? 'checked' : '' %>>
                                <span class="dev-slider round"></span>
                            </label>
                        </div>
                    </div>

                    <div class="col-md-4 rp-form-group" id="details">
                        <label class="rp-label">New Password</label>
                        <div class="input-group">
                            <input type="password" id="pwd" name="pwd" class="rp-input" placeholder="Enter new password here.....">
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="fa fa-eye-slash" id="eyeIcon"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2 rp-form-group d-flex align-items-end" style="margin-bottom: 20px;">
                        <input type="hidden" name="id" value="<%= id %>">
                        <input type="hidden" name="cust_id" value="<%= customer_id %>">
                        <button type="submit" id="submitButton" class="rp-submit-btn" style="height: 48px; width: 100%;" disabled>Update</button>
                    </div>
                </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
    $(document).ready(function () {
        // Feather Icons
        feather.replace();

        // Back button
        $("#back").click(function () {
            window.location.href = "/superadmin/report_pass";
        });

        // Toggle Password Visibility
        $("#togglePassword").click(function() {
            const pwdField = $("#pwd");
            const icon = $("#eyeIcon");
            if (pwdField.attr("type") === "password") {
                pwdField.attr("type", "text");
                icon.removeClass("fa-eye-slash").addClass("fa-eye");
            } else {
                pwdField.attr("type", "password");
                icon.removeClass("fa-eye").addClass("fa-eye-slash");
            }
        });

        const $report = $("#report_pwd");
        const $pwd = $("#pwd");
        const $details = $("#details");
        const $submit = $("#submitButton");

        // Capture initial state
        const initial = {
            report_pwd: $report.prop("checked") ? "Y" : "N",
            pwd: "" // initial password always blank for change detection
        };

        // UI Initialization
        if (initial.report_pwd === "Y") {
            $details.show();
        } else {
            $details.hide();
        }

        function evaluateChanges() {
            const now = {
                report_pwd: $report.prop("checked") ? "Y" : "N",
                pwd: ($pwd.val() || "").trim()
            };

            let changed = false;

            if (initial.report_pwd === "N") {
                if (now.report_pwd === "Y") {
                    changed = now.pwd.length > 0;
                }
            } else {
                if (now.report_pwd === "N") {
                    changed = true; // turning OFF is a change
                } else {
                    changed = now.pwd.length > 0; // new pwd required if staying ON
                }
            }

            $submit.prop("disabled", !changed);
        }

        // Events
        $report.on("change", function () {
            if ($(this).is(":checked")) {
                $details.show();
            } else {
                $details.hide();
                $pwd.val("");
            }
            evaluateChanges();
        });

        $pwd.on("input", evaluateChanges);
    });
</script>
