<link href="/template/dist/css/shift.css" rel="stylesheet">

<div class="shift-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card shift-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="shift-header">
              <div class="shift-title-group">
                <div class="shift-icon-badge">
                  <i data-feather="clock"></i>
                </div>
                <h3 class="shift-page-title">Shift Management</h3>
              </div>
              <button type="button" class="shift-add-btn" data-toggle="modal" data-target="#myModal">
                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Shift
              </button>
            </div>

            <!-- FILTER SECTION -->
            <div class="shift-filter-sec">
              <form action="/superadmin/shift" method="post">
                <div class="row align-items-end">
                  <div class="col-md-5 shift-form-group mb-0">
                    <label class="shift-label"><i data-feather="users"
                        style="width:14px;height:14px;margin-right:4px;"></i> Customer Name</label>
                    <select name="cust_name" class="shift-select" id="cust_name_filter" required>
                      <option value="">Select Customer to filter...</option>
                      <% customer.forEach(dt=> {
                        var _selected = ''
                        if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                        <option value="<%= dt.customer_id %>" <%=_selected %>><%= dt.customer_name %>
                        </option>
                        <% })%>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <div style="white-space: nowrap;">
                      <button type="submit" class="shift-submit-btn" id="submitBtn">
                        <i data-feather="search" style="width:15px;height:15px;margin-right:6px;"></i> Filter Results
                      </button>
                      <a href="/superadmin/shift" class="shift-refresh-btn" style="margin-left:8px;"
                        title="Refresh Page">
                        <i data-feather="refresh-cw"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </form>
            </div>

            <% if(selected.cust_id> 0){ %>
              <!-- TABLE -->
              <div class="shift-table-wrap mt-5">
                <table id="dataTable" class="table shift-table no-wrap">
                  <thead>
                    <tr>
                      <th>Sl No.</th>
                      <th>Shift Name</th>
                      <th>From Time</th>
                      <th>To Time</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if(data.length> 0){
                      var i = 1
                      data.forEach(dt => { %>
                      <tr>
                        <td>
                          <%= i %>
                        </td>
                        <td style="font-weight: 600; color: var(--gray-800);">
                          <%= dt.shift_name %>
                        </td>
                        <td><span class="badge badge-light px-3 py-2" style="border-radius: 6px; font-weight: 600;">
                            <%= dt.f_time %>
                          </span></td>
                        <td><span class="badge badge-light px-3 py-2" style="border-radius: 6px; font-weight: 600;">
                            <%= dt.t_time %>
                          </span></td>
                        <td>
                          <a href='/superadmin/edit_shift?customer_id=<%= selected.cust_id %>&id=<%= dt.shift_id %>'
                            class='action-btn-edit' title="Edit Shift">
                            <i class="fa fa-edit"></i>
                          </a>
                        </td>
                      </tr>
                      <% i++; }) }else{ %>
                        <tr>
                          <td colspan="5"
                            style="color: var(--danger); font-weight: 500; padding: 30px; text-align: center;">No shifts
                            found for this customer</td>
                        </tr>
                        <% } %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
                <div class="text-center py-5 mt-5"
                  style="background: var(--gray-50); border-radius: 12px; border: 1px dashed var(--gray-300);">
                  <i data-feather="info" style="color: var(--gray-400); margin-bottom: 12px;"></i>
                  <p style="color: var(--gray-500); font-size: 0.9rem;">Please select a customer above to view and
                    manage shifts.</p>
                </div>
                <% } %>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add Shift
            Details</b></h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/superadmin/save_shift" method="post" id="myForm">
          <div class="row">
            <div class="col-md-6 shift-form-group">
              <label class="shift-label">Customer Name</label>
              <select name="cust_id" class="shift-select" id="cust_id_modal" required>
                <option value="">Select Customer</option>
                <% customer.forEach(dt=> { %>
                  <option value="<%= dt.customer_id %>">
                    <%= dt.customer_name %>
                  </option>
                  <% }) %>
              </select>
            </div>
            <div class="col-md-6 shift-form-group">
              <label class="shift-label">Shift Name</label>
              <input type="text" class="shift-input" id="shift_name" name="shift_name"
                placeholder="e.g. Morning Shift, Night Shift" required>
            </div>
            <div class="col-md-6 shift-form-group">
              <label class="shift-label">From Time</label>
              <input type="time" name="frm_time" id="frm_time" class="shift-input" required>
            </div>
            <div class="col-md-6 shift-form-group">
              <label class="shift-label">To Time</label>
              <input type="time" name="to_time" id="to_time" class="shift-input" required>
            </div>
          </div>

          <div class="text-center mt-1">
            <input type="hidden" name="id" value="0">
            <button type="submit" class="shift-submit-btn">Register Shift</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // Initialize Select2
    $('.shift-select').select2({
      placeholder: 'Select an option',
      width: '100%'
    });

    // Special initialization for selects inside the modal to fix focus/z-index issues
    $('#myModal').on('shown.bs.modal', function () {
      $('.shift-select', this).select2({
        placeholder: 'Select an option',
        width: '100%',
        dropdownParent: $('#myModal')
      });
    });
  });
</script>