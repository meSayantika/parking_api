<link href="/template/dist/css/location-page.css" rel="stylesheet">

<div class="loc-page-wrapper">
  <div class="container-fluid">
    <div class="row mt-3">
      <div class="col-12">
        <div class="card loc-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="loc-header">
              <div class="loc-title-group">
                <div class="loc-icon-badge">
                  <i data-feather="map-pin"></i>
                </div>
                <h3 class="loc-page-title">Locations</h3>
                <% if(data.msg && data.msg.length > 0) { %>
                  <span class="loc-count-badge">
                    <%= data.msg.length %> total
                  </span>
                <% } %>
              </div>
              <button type="button" class="loc-add-btn" data-toggle="modal" data-target="#myModal">
                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i>
                Add Location
              </button>
            </div>

            <!-- TABLE -->
            <div class="loc-table-wrap">
              <table id="dataTable" class="table loc-table no-wrap">
                <thead>
                  <tr>
                    <th>Sl No.</th>
                    <th>Location Name</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(data.msg && data.msg.length > 0) { %>
                    <% data.msg.forEach(function(item, index) { %>
                      <tr>
                        <td><%= (index + 1) %></td>
                        <td><%= item.loction %></td>
                        <td>
                          <a href="edit_location?id=<%= item.location_id %>"
                             class="loc-edit-btn" title="Edit">
                            <i class="fa fa-edit"></i>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="3" class="loc-no-data text-center">No data available</td>
                    </tr>
                  <% } %>
                </tbody>
                <tfoot></tfoot>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MODAL — kept OUTSIDE wrapper so Bootstrap renders it correctly -->
<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">
          <i data-feather="plus-circle" style="width:20px;height:20px;"></i>
          <b>Add Location</b>
        </h3>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>
      <div class="modal-body">
        <form action="/superadmin/location_save" method="post" id="myForm">
          <div class="row">
            <div class="col-md-12">
              <div class="loc-form-group">
                <label for="loc_name" class="loc-form-label">Location Name</label>
                <textarea class="loc-textarea" rows="3" id="loc_name" name="loc_name"
                  placeholder="Enter location name..."></textarea>
              </div>
            </div>
          </div>
          <div class="row">
            <input type="hidden" name="id" value="0">
            <div class="col-12" style="text-align:right;">
              <input type="submit" value="SUBMIT" class="loc-submit-btn" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // Modal logic handled by data attributes
  });
</script>