<link href="/template/dist/css/vehicle-page.css" rel="stylesheet">

<div class="veh-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card veh-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="veh-header">
              <div class="veh-title-group">
                <div class="veh-icon-badge" style="display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; color: white; line-height: 1;">
                  ₹
                </div>
                <h3 class="veh-page-title">Vehicle Rate</h3>
              </div>
              <button type="button" class="veh-add-btn" id="myBtn">
                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Vehicle rate
              </button>
            </div>

            <!-- FILTER SECTION -->
            <div class="veh-filter-sec">
              <form action="/superadmin/vehicle_rate" method="post">
                <!-- Single Row: Fields and Buttons -->
                <div class="row align-items-end mb-2">
                  <div class="col-md-3 veh-form-group mb-0">
                    <label class="veh-label"><i data-feather="users"
                        style="width:14px;height:14px;margin-right:4px;"></i> Customer Name</label>
                    <select name="cust_name" class="veh-select" id="cust_name_sel" required>
                      <option value="" <%= !selected.cust_id ? 'selected' : '' %>>Select an option</option>
                      <% customer.forEach(dt=> {
                        var _selected = ''
                        if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                        <option value="<%= dt.customer_id %>" <%=_selected %>><%= dt.customer_name %>
                        </option>
                        <% }) %>
                    </select>
                  </div>
                  <div class="col-md-3 veh-form-group mb-0">
                    <label class="veh-label"><i data-feather="percent"
                        style="width:14px;height:14px;margin-right:4px;"></i> Rate Type</label>
                    <select name="rate_type_name" class="veh-select" id="rate_type_name" disabled>
                      <option value="">Select Rate Type</option>
                    </select>
                    <input type="hidden" name="rate_type" id="rate_type" value="">
                  </div>
                  <div class="col-md-3 veh-form-group mb-0">
                    <label class="veh-label"><i data-feather="truck"
                        style="width:14px;height:14px;margin-right:4px;"></i> Vehicle Name</label>
                    <select name="veh_id" class="veh-select" id="veh_id_sel" required>
                      <option value="">Select Vehicle Name</option>
                    </select>
                  </div>
                  <div class="col-md-3" style="padding-top: 26px;">
                    <div style="display: flex; gap: 10px; height: 100%;">
                      <button type="submit" class="veh-submit-btn flex-grow-1" id="submitBtn" style="padding: 0 16px; font-size: 0.9rem; height: 48px;">
                        <i data-feather="search" style="width:16px;height:16px;margin-right:6px;"></i> Submit
                      </button>
                      <a href="/superadmin/vehicle_rate" class="veh-refresh-btn" title="Refresh Page" style="height: 48px; width: 48px; min-width: 48px; padding: 0; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <i data-feather="refresh-cw" style="width: 20px; height: 20px;"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </form>
            </div>

            <% if(selected.cust_id> 0){ %>
              <!-- TABLE -->
              <div class="veh-table-wrap mt-3">
                <table id="dataTable" class="table veh-table no-wrap show_data">
                  <thead>
                    <tr>
                      <th class="text-center">Sl No.</th>
                      <th class="text-center">From Hour</th>
                      <th class="text-center">To Hour</th>
                      <th class="text-center">Parking Fee</th>
                      <th class="text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if(data.length> 0){
                      var i = 1
                      data.forEach(dt => { %>
                      <tr>
                        <td class="text-center">
                          <%= i %>
                        </td>
                        <td class="text-center" style="font-weight: 600; color: var(--gray-800);">
                          <%= dt.from_hour %>
                        </td>
                        <td class="text-center" style="font-weight: 600; color: var(--gray-800);">
                          <%= dt.to_hour %>
                        </td>
                        <td class="text-center" style="font-weight: 600; color: var(--green-600);">
                          <%= dt.vehicle_rate %>
                        </td>
                        <td class="text-center">
                          <a href='/superadmin/vehicle_edit_rate?customer_id=<%= selected.cust_id %>&id=<%= dt.sl_no %>'
                            class='action-btn-edit' title="Edit Rate">
                            <i class="fa fa-edit"></i>
                          </a>
                        </td>
                      </tr>
                      <% i++; }) }else{ %>
                        <tr>
                          <td colspan="5"
                            style="color: var(--danger); font-weight: 500; padding: 30px; text-align: center;">No data
                            found</td>
                        </tr>
                        <% } %>
                  </tbody>
                  <tfoot>

                  </tfoot>
                </table>
              </div>
              <% } else { %>
                <div class="text-center py-5"
                  style="background: var(--gray-50); border-radius: 12px; border: 1px dashed var(--gray-300);">
                  <i data-feather="info" style="color: var(--gray-400); margin-bottom: 12px;"></i>
                  <p style="color: var(--gray-500); font-size: 0.9rem;">Please select a customer above to view and
                    manage vehicle rates.</p>
                </div>
                <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add Vehicle
            Rate</b></h4>
        <button type="button" class="close" data-dismiss="modal">
          &times;
        </button>
      </div>

      <%- include('./vehicle_rate_modal', {seller, customer}) %>

    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // Initialize Select2 for the modern UI
    $('.veh-select').select2({
      placeholder: 'Select an option',
      width: '100%'
    });

    // Modal compatibility
    $('#myModal').on('shown.bs.modal', function () {
      $('.modal-veh-select', this).select2({
        placeholder: 'Select an option',
        width: '100%',
        dropdownParent: $('#myModal')
      });
    });

    $('#cust_name_sel').change()
    $("#myBtn").click(function () {
      $("#myModal").modal();
      // $("#myBtn").hide()
    });
  });
</script>t>

<script>
  var cust_list = <%- JSON.stringify(customer) %>;
  var rate_type = [{ id: 'D', name: 'Hourly' }, { id: 'F', name: 'Fixed' }]
  $('#cust_name_sel').on('change', function () {
    // console.log('here lalalalal');
    var cust_id = $(this).val()
    changeProcess(cust_id)
  })

  $(document).ready(function () {
    var sel_cust_id = '<%= selected.cust_id %>'
    if (sel_cust_id > 0) {
      // console.log(sel_cust_id, 'dsasda');
      changeProcess(sel_cust_id)
      // $('#cust_name_sel').change()
    }
  })

  function changeProcess(cust_id) {
    if (!cust_id) return;
    var cust_dtls = cust_list.filter(dt => dt.customer_id == cust_id);
    $('#rate_type_name').empty()
    if (cust_dtls.length > 0) {
      $('#rate_type_name').append($('<option>', { value: '', text: 'Select Rate Type' }))
      $.each(rate_type, function (i, dt) {
        var selected = false
        if (cust_dtls[0].dev_mod == dt.id) selected = true
        $('#rate_type_name').append($('<option>', { value: dt.id, text: dt.name, selected: selected }))
      })
      $('#rate_type').val(cust_dtls[0].dev_mod)
      $('#rate_type_name').trigger('change.select2');
    } else {
      alert('Please select dev mode in customer first')
    }

    // $('#cust_name').change(function () {
    //   var cust_id = $(this).val()
    //   var veh_id = $(this).val()

    $.ajax({
      type: "POST",
      url: "/superadmin/vehicle_dt",
      data: { cust_id: cust_id },
      success: function (response) {
        // console.log(response.SUCCESS.branchData.msg)
        $('#veh_id_sel').empty();
        $('#veh_id_sel').append(`<option value="">Select Vehicle Name</option>`)

        var sel_veh_id = '<%= selected.veh_id > 0 ? selected.veh_id : 0 %>'
        response.SUCCESS.veh_id.msg.forEach(function (resData) {
          var _selected = false
          if (sel_veh_id == resData.vehicle_id) _selected = true
          $('#veh_id_sel').append($('<option>', { value: resData.vehicle_id, text: resData.vehicle_name, selected: _selected }))
        });
        
        $('#veh_id_sel').trigger('change.select2');

      },
      error: function (error) {
        console.log(error);
        //   tbody.empty();
      },
    });
  }
</script>