           var _selected = false
        //    if (sel_cust_id == resData.customer_id) _selected = true
           $('#cust_name').append($('<option>', { value: resData.customer_id, text: resData.customer_name, selected: _selected }))
           // $('#veh_id').append('<option value="' + resData.vehicle_id + '">' + resData.vehicle_id + '</option>');
         });
 
       },
       error: function (error) {
