<link href="/template/dist/css/vehicle-page.css" rel="stylesheet">

<div class="veh-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card veh-card">
          <div class="card-body">
            <!-- HEADER -->
            <div class="veh-header" style="margin-bottom:20px;">
                <div class="veh-title-group">
                    <div class="veh-icon-badge">
                        <i data-feather="edit-3"></i>
                    </div>
                    <span class="veh-back-btn" id="back" title="Back to Vehicle Rates">
                        <i data-feather="arrow-left" style="color: var(--green-600);"></i>
                    </span>
                    <h3 class="veh-edit-title" style="margin: 0; font-size: 1.25rem; font-weight: 700; color: var(--gray-800);">Edit Vehicle Rate</h3>
                </div>
            </div>

            <!-- FORM -->
            <form action="/superadmin/vehicle_rate_save" id="myForm" method="post">
                <div class="row mt-4">
                  <div class="col-md-4 veh-form-group">
                      <label class="veh-label">Seller Name</label>
                      <select name="sell_id" class="veh-select" id="sell_id" disabled>
                        <option value="">Select Seller Name</option>
                        <% seller.forEach(dt =>{ %>
                          <option value="<%= dt.seller_id %>" <%= dt.seller_id == data[0].seller_id ? 'selected' : '' %>><%= dt.seller_name %></option>
                       <% }) %>
                      </select>
                  </div>

                  <div class="col-md-4 veh-form-group">
                      <label class="veh-label">Customer Name</label>
                      <select name="cust_name" class="veh-select" id="cust_name" disabled>
                        <option value="">Select Customer Name</option>
                        <% customer.forEach(dt =>{ %>
                          <option value="<%= dt.customer_id %>" <%= dt.customer_id == data[0].customer_id ? 'selected' : '' %>><%= dt.customer_name %></option>
                       <% }) %>
                      </select>
                  </div>

                  <div class="col-md-4 veh-form-group">
                      <label class="veh-label">Rate Type</label>
                      <select name="rate_name" class="veh-select" id="rate_name" disabled>
                          <option value="">Select Rate Type</option>
                          <option value="H" <% if (data[0].rate_type === 'H') { %>selected<% } %>>Hourly</option>
                          <option value="F" <% if (data[0].rate_type === 'F') { %>selected<% } %>>Fixed</option>
                      </select>
                  </div>

                  <div class="col-md-4 veh-form-group">
                      <label class="veh-label">Vehicle Name</label>
                      <select name="veh_id" class="veh-select" id="veh_id" disabled>
                        <option value="">Select Vehicle Name</option>
                        <% vehicle.forEach(dt =>{ %>
                          <option value="<%= dt.vehicle_id %>" <%= dt.vehicle_id == data[0].vehicle_id ? 'selected' : '' %>><%= dt.vehicle_name %></option>
                       <% }) %>
                      </select>
                  </div>

                  <div class="col-md-4 veh-form-group">
                      <label class="veh-label">From Hour</label>
                      <input type="number" max="24" min="0" class="veh-input" id="frm_hr" name="frm_hr" value="<%= data[0].from_hour %>">
                  </div>

                  <div class="col-md-4 veh-form-group">
                      <label class="veh-label">To Hour</label>
                      <input type="number" max="24" min="0" class="veh-input" id="to_hr" name="to_hr" value="<%= data[0].to_hour %>">
                  </div>

                  <div class="col-md-4 veh-form-group">
                      <label class="veh-label">Parking Fee</label>
                      <input type="text" class="veh-input" id="park_fee" name="park_fee" value="<%= data[0].vehicle_rate %>">
                  </div>
                </div>

                <div class="text-center mt-4 pt-2">
                    <input type="hidden" name="id" value="<%= id %>">
                    <input type="hidden" name="cust_id" value="<%= customer_id %>">
                    <button type="submit" id="submitBtn" class="veh-submit-btn" disabled>Update Vehicle Rate</button>
                </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    $("#back").click(function () {
      window.location.href = "/superadmin/vehicle_rate";
    });
  });
</script>

<script>
$(function () {
  const $frmHr = $("#frm_hr");
  const $toHr = $("#to_hr");
  const $parkFee = $("#park_fee");
  const $submitBtn = $("#submitBtn");

  // Store initial values
  const initial = {
    frmHr: $frmHr.val(),
    toHr: $toHr.val(),
    parkFee: $parkFee.val()
  };

  // Disable submit initially
  $submitBtn.prop("disabled", true);

  const checkChanges = () => {
    const changed =
      $frmHr.val() !== initial.frmHr ||
      $toHr.val() !== initial.toHr ||
      $parkFee.val().trim() !== initial.parkFee.trim();

    $submitBtn.prop("disabled", !changed);
  };

  // Bind events
  $frmHr.on("input", checkChanges);
  $toHr.on("input", checkChanges);
  $parkFee.on("input", checkChanges);
});
</script>
