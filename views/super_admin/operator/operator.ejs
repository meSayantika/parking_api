<link href="/template/dist/css/operator-page.css" rel="stylesheet">

<div class="op-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card op-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="op-header">
              <div class="op-title-group">
                <div class="op-icon-badge">
                  <i data-feather="user-check"></i>
                </div>
                <h3 class="op-page-title">Operator Management</h3>
              </div>
              <button type="button" class="op-add-btn" data-toggle="modal" data-target="#myModal">
                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Operator
              </button>
            </div>

            <!-- FILTER SECTION -->
            <div class="op-filter-sec">
              <form action="/superadmin/operator" method="post">
                <div class="row align-items-end">
                  <div class="col-md-5 op-form-group mb-0">
                    <label class="op-label"><i data-feather="users"
                        style="width:14px;height:14px;margin-right:4px;"></i> Customer Name</label>
                    <select name="cust_name" class="op-select" id="cust_name_filter" required>
                      <option value="">Select Customer to filter...</option>
                      <% customer.forEach(dt=> {
                        var _selected = ''
                        if(selected.cust_id == dt.customer_id) _selected = 'selected' %>
                        <option value="<%= dt.customer_id %>" <%=_selected %>><%= dt.customer_name %>
                        </option>
                        <% })%>
                    </select>
                  </div>
                  <div class="col-md-4">
                    <div style="white-space: nowrap;">
                      <button type="submit" class="op-submit-btn" id="submitBtn">
                        <i data-feather="search" style="width:15px;height:15px;margin-right:6px;"></i> Filter Results
                      </button>
                      <a href="/superadmin/operator" class="op-refresh-btn" style="margin-left:8px;"
                        title="Refresh Page">
                        <i data-feather="refresh-cw"></i>
                      </a>
                    </div>
                  </div>
                </div>
              </form>
            </div>

            <% if(selected.cust_id> 0){ %>
              <!-- TABLE CONTENT -->
              <div class="op-table-wrap mt-3">
                <table id="dataTable" class="table op-table no-wrap">
                  <thead>
                    <tr>
                      <th>Sl No.</th>
                      <th>Operator Name</th>
                      <th>User ID (Mobile)</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if(data.length> 0){
                      var i = 1
                      data.forEach(dt => { %>
                      <tr>
                        <td>
                          <%= i %>
                        </td>
                        <td style="font-weight: 600; color: var(--gray-800);">
                          <%= dt.operator_name %>
                        </td>
                        <td>
                          <%= dt.user_id %>
                        </td>
                        <td>
                          <a href='/superadmin/edit_operator?customer_id=<%= selected.cust_id %>&id=<%= dt.operator_id %>'
                            class='action-btn-edit' title="Edit Operator">
                            <i class="fa fa-edit"></i>
                          </a>
                        </td>
                      </tr>
                      <% i++; }) }else{ %>
                        <tr>
                          <td colspan="4"
                            style="color: var(--danger); font-weight: 500; padding: 30px; text-align: center;">No
                            operators found for this customer</td>
                        </tr>
                        <% } %>
                  </tbody>
                </table>
              </div>
              <% } else { %>
                <div class="text-center py-5"
                  style="background: var(--gray-50); border-radius: 12px; border: 1px dashed var(--gray-300);">
                  <i data-feather="info" style="color: var(--gray-400); margin-bottom: 12px;"></i>
                  <p style="color: var(--gray-500); font-size: 0.9rem;">Please select a customer above to view and
                    manage operators.</p>
                </div>
                <% } %>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add Operator</b>
        </h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/superadmin/operator_save" method="post" id="myForm">
          <div class="row">
            <div class="col-md-6 op-form-group">
              <label class="op-label">Customer Name</label>
              <select name="cust_name" class="op-select" id="cust_name_modal">
                <option value="">Select Customer</option>
                <% customer.forEach(dt=> { %>
                  <option value="<%= dt.customer_id %>">
                    <%= dt.customer_name %>
                  </option>
                  <% }) %>
              </select>
            </div>
            <div class="col-md-6 op-form-group">
              <label class="op-label">Seller Name</label>
              <select name="seller_name" class="op-select" id="seller_name">
                <option value="">Select Seller</option>
                <% seller.forEach(dt=> { %>
                  <option value="<%= dt.seller_id %>">
                    <%= dt.seller_name %>
                  </option>
                  <% }) %>
              </select>
            </div>
            <div class="col-md-6 op-form-group">
              <label class="op-label">Operator Name</label>
              <input type="text" class="op-input" id="op_name" name="op_name" placeholder="Full name of operator">
            </div>
            <div class="col-md-6 op-form-group">
              <label class="op-label">Mobile Number (User ID)</label>
              <input type="text" class="op-input" id="mobile" name="mobile" placeholder="10-digit mobile number"
                maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)" required>
            </div>
            <div class="col-md-6 op-form-group">
              <label class="op-label">Location Name</label>
              <select name="loc_name" class="op-select" id="loc_name">
                <option value="">Select Location</option>
                <% location.forEach(dt=> { %>
                  <option value="<%= dt.location_id %>">
                    <%= dt.loction %>
                  </option>
                  <% })%>
              </select>
            </div>
            <div class="col-md-6 op-form-group">
              <label class="op-label">Device ID</label>
              <input type="text" class="op-input" id="dev_id" name="dev_id" placeholder="Assign Device ID">
            </div>
            <div class="col-md-6 op-form-group">
              <label class="op-label">Password</label>
              <div class="op-password-group">
                <input type="password" class="op-input" name="pwd" id="pwd" placeholder="Enter secure password">
                <button class="op-password-toggle" type="button" id="togglePassword">
                  <i data-feather="eye-off" style="width:16px;height:16px;"></i>
                </button>
              </div>
            </div>
          </div>

          <div class="text-center mt-4 pt-2">
            <input type="hidden" name="id" value="0">
            <button type="submit" class="op-submit-btn">Register Operator</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // Initialize Select2 for filter dropdowns
    $('.op-select').select2({
      placeholder: 'Select an option',
      width: '100%'
    });

    // Special initialization for selects inside the modal to fix focus/z-index issues
    $('#myModal').on('shown.bs.modal', function () {
      $('.op-select', this).select2({
        placeholder: 'Select an option',
        width: '100%',
        dropdownParent: $('#myModal')
      });
    });

    // Password toggle
    $("#togglePassword").click(function () {
      const pwdField = $("#pwd");
      const icon = $(this).find('i');

      if (pwdField.attr("type") === "password") {
        pwdField.attr("type", "text");
        $(this).html('<i data-feather="eye" style="width:16px;height:16px;"></i>');
      } else {
        pwdField.attr("type", "password");
        $(this).html('<i data-feather="eye-off" style="width:16px;height:16px;"></i>');
      }
      feather.replace();
    });
  });
</script>