<link href="/template/dist/css/header_footer.css" rel="stylesheet">

<div class="hf-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card hf-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="hf-header">
              <div class="hf-title-group">
                <div class="hf-icon-badge">
                  <i data-feather="command"></i>
                </div>
                <h3 class="hf-page-title">Header & Footer</h3>
                <% if(data.msg && data.msg.length > 0) { %>
                  <span class="hf-count-badge"><%= data.msg.length %> total</span>
                <% } %>
              </div>
              <button type="button" class="hf-add-btn" id="myBtn">
                <i data-feather="plus"></i> Add Header/Footer
              </button>
            </div>

            <!-- TABLE -->
            <div class="table-responsive hf-table-wrap mt-4">
              <table id="example" class="table hf-table no-wrap show_data">
                <thead>
                  <tr>
                    <th>Sl. No.</th>
                    <th>Customer Name</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(data.msg && data.msg.length > 0) { %>
                    <% data.msg.forEach(function(item,index) { %>
                      <tr>
                        <td><%= (index+1) %></td>
                        <td><strong><%= item.customer_name %></strong></td>
                        <td>
                          <a href="/header/edit_header_footer_details?customer_id=<%=item.customer_id%>" 
                             class="action-btn-edit" title="Edit Details">
                            <i class="fa fa-edit"></i>
                          </a>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="3" class="hf-no-data">No header & footer data available</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title">
          <i data-feather="plus-circle" style="width:20px;height:20px;"></i>
          <b> Add Header & Footer</b>
        </h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/header/add_header_footer" method="post" id="myForm">
          <div class="row">
            <div class="col-md-12 hf-form-group">
              <label for="cust_id" class="hf-label">Customer Name</label>
              <select name="cust_id" class="hf-select" id="cust_id">
                <option value="" selected><%= user.user_data.customer_name %></option>
              </select>
            </div>

            <div class="col-12">
              <div class="hf-section-title">Header Configuration</div>
            </div>

            <% for(let i=1; i<=4; i++) { %>
            <div class="col-md-9">
              <div class="form-group hf-form-group">
                <label for="header_<%=i%>" class="hf-label">Header <%=i%> <span id="charCount<%=i%>" class="char-count"><b>(0/30)</b></span></label>
                <textarea class="hf-textarea" id="header_<%=i%>" name="header_<%=i%>" rows="2" placeholder="Enter header line <%=i%>"
                  maxlength="30" oninput="updateCharCount('header_<%=i%>','charCount<%=i%>')"></textarea>
              </div>
            </div>
            <div class="col-md-3 hf-form-group hf-inline-flag-group">
              <label for="header_<%=i%>_flag" class="hf-label">Line <%=i%> Visibility</label>
              <label class="hf-modern-toggle">
                <input type="checkbox" value="1" id="header_<%=i%>_flag" name="header_<%=i%>_flag" class="hf-toggle-input">
                <span class="hf-toggle-ui">
                  <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                  <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                  <span class="hf-toggle-thumb"></span>
                </span>
              </label>
            </div>
            <% } %>

            <div class="col-12">
              <div class="hf-section-title">Footer Configuration</div>
            </div>

            <% for(let i=1; i<=4; i++) { %>
            <div class="col-md-9">
              <div class="form-group hf-form-group">
                <label for="footer_<%=i%>" class="hf-label">Footer <%=i%> <span id="charCount<%=i+4%>" class="char-count"><b>(0/30)</b></span></label>
                <textarea class="hf-textarea" id="footer_<%=i%>" name="footer_<%=i%>" rows="2" placeholder="Enter footer line <%=i%>"
                  maxlength="30" oninput="updateCharCount('footer_<%=i%>','charCount<%=i+4%>')"></textarea>
              </div>
            </div>
            <div class="col-md-3 hf-form-group hf-inline-flag-group">
              <label for="footer_<%=i%>_flag" class="hf-label">Line <%=i%> Visibility</label>
              <label class="hf-modern-toggle">
                <input type="checkbox" value="1" id="footer_<%=i%>_flag" name="footer_<%=i%>_flag" class="hf-toggle-input">
                <span class="hf-toggle-ui">
                  <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                  <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                  <span class="hf-toggle-thumb"></span>
                </span>
              </label>
            </div>
            <% } %>

            <div class="col-12">
              <div class="hf-section-title">Print Settings</div>
            </div>

            <div class="col-md-4 hf-form-group">
              <div class="hf-toggle-card">
                <label for="in_on_off_flag" class="hf-label">IN Receipt</label>
                <label class="hf-modern-toggle">
                  <input type="checkbox" value="Y" id="in_on_off_flag" name="in_on_off_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>
            </div>

            <div class="col-md-4 hf-form-group">
              <div class="hf-toggle-card">
                <label for="out_on_off_flag" class="hf-label">OUT Receipt</label>
                <label class="hf-modern-toggle">
                  <input type="checkbox" value="Y" id="out_on_off_flag" name="out_on_off_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>
            </div>

            <div class="col-md-4 hf-form-group">
              <div class="hf-toggle-card">
                <label for="report_flag" class="hf-label">Report Print</label>
                <label class="hf-modern-toggle">
                  <input type="checkbox" value="Y" id="report_flag" name="report_flag" class="hf-toggle-input">
                  <span class="hf-toggle-ui">
                    <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                    <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                    <span class="hf-toggle-thumb"></span>
                  </span>
                </label>
              </div>
            </div>
          </div>

          <div class="text-center mt-4">
            <button type="submit" class="hf-submit-btn">Register Configuration</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // 1. Feather Icons
    if (typeof feather !== 'undefined') feather.replace();

    // 2. DataTables Pagination
    $('#example').DataTable({
      pageLength: 10,
      lengthMenu: [10, 25, 50, 100],
      ordering: false,
      responsive: true,
      autoWidth: false,
      language: {
        search: "Search:",
        lengthMenu: "Show _MENU_ entries",
        paginate: { previous: "Prev", next: "Next" }
      }
    });

    // 3. Modal logic
    $("#myBtn").click(function () {
      $("#myModal").modal('show');
    });

    // 4. Hide add button if record exists
    var customer_id = $('#cust_id').val();
    $.ajax({
      type: "GET",
      url: "/header/header_footer_details",
      data: { customer_id: customer_id },
      success: function (response) {
        if (response.suc > 0 && response.msg.length > 0) {
          $('#myBtn').hide();
        }
      },
      error: function (error) {
        console.log(error);
      }
    });
  });

  // 5. Character count logic
  function updateCharCount(textareaId, countId) {
    var textarea = document.getElementById(textareaId);
    var charCount = document.getElementById(countId);
    if (textarea && charCount) {
      var count = textarea.value.length;
      charCount.innerHTML = '<b>(' + count + '/30)</b>';
    }
  }
</script>