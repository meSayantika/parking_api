<link href="/template/dist/css/header_footer.css" rel="stylesheet">

<div class="hf-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card hf-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="hf-header">
              <div class="hf-title-group">
                <div class="hf-icon-badge">
                  <i data-feather="edit-3"></i>
                </div>
                <button type="button" class="hf-back-btn" id="backBtn">
                  <i data-feather="arrow-left"></i>
                </button>
                <h3 class="hf-edit-title">Edit Header & Footer</h3>
              </div>
            </div>

            <!-- FORM -->
            <form action="/header/edit_save_header_footer" id="myForm" method="post">
              <input type="hidden" name="cust_id" value="<%= data.customer_id %>">
              
              <div class="row mt-4">
                <div class="col-md-12 hf-form-group">
                  <label class="hf-label">Customer Name</label>
                  <input type="text" class="hf-input" value="<%= data.customer_name %>" disabled style="background-color: var(--gray-50);">
                </div>

                <div class="col-12">
                  <div class="hf-section-title">Header Configuration</div>
                </div>

                <% 
                const headerData = [
                  { id: 'header_1', val: data.header1, flag: data.header1_flag, label: 'Header 1' },
                  { id: 'header_2', val: data.header2, flag: data.header2_flag, label: 'Header 2' },
                  { id: 'header_3', val: data.header3, flag: data.header3_flag, label: 'Header 3' },
                  { id: 'header_4', val: data.header4, flag: data.header4_flag, label: 'Header 4' }
                ];
                headerData.forEach((h, idx) => { %>
                  <div class="col-md-9">
                    <div class="form-group hf-form-group">
                      <label for="<%= h.id %>" class="hf-label"><%= h.label %> <span id="charCount<%= idx+1 %>" class="char-count"><b>(0/30)</b></span></label>
                      <textarea class="hf-textarea" id="<%= h.id %>" name="<%= h.id %>" rows="2" placeholder="Enter <%= h.label.toLowerCase() %>"
                        maxlength="30" oninput="updateCharCount('<%= h.id %>','charCount<%= idx+1 %>')"><%= h.val %></textarea>
                    </div>
                  </div>
                  <div class="col-md-3 hf-form-group hf-inline-flag-group">
                    <label for="<%= h.id %>_flag" class="hf-label">Line <%= idx+1 %> Visibility</label>
                    <label class="hf-modern-toggle">
                      <input type="checkbox" value="1" id="<%= h.id %>_flag" name="<%= h.id %>_flag" class="hf-toggle-input" <%= h.flag == '1' ? 'checked' : '' %>>
                      <span class="hf-toggle-ui">
                        <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                        <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                        <span class="hf-toggle-thumb"></span>
                      </span>
                    </label>
                  </div>
                <% }); %>

                <div class="col-12">
                  <div class="hf-section-title">Footer Configuration</div>
                </div>

                <% 
                const footerData = [
                  { id: 'footer_1', val: data.footer1, flag: data.footer1_flag, label: 'Footer 1' },
                  { id: 'footer_2', val: data.footer2, flag: data.footer2_flag, label: 'Footer 2' },
                  { id: 'footer_3', val: data.footer3, flag: data.footer3_flag, label: 'Footer 3' },
                  { id: 'footer_4', val: data.footer4, flag: data.footer4_flag, label: 'Footer 4' }
                ];
                footerData.forEach((f, idx) => { %>
                  <div class="col-md-9">
                    <div class="form-group hf-form-group">
                      <label for="<%= f.id %>" class="hf-label"><%= f.label %> <span id="charCount<%= idx+5 %>" class="char-count"><b>(0/30)</b></span></label>
                      <textarea class="hf-textarea" id="<%= f.id %>" name="<%= f.id %>" rows="2" placeholder="Enter <%= f.label.toLowerCase() %>"
                        maxlength="30" oninput="updateCharCount('<%= f.id %>','charCount<%= idx+5 %>')"><%= f.val %></textarea>
                    </div>
                  </div>
                  <div class="col-md-3 hf-form-group hf-inline-flag-group">
                    <label for="<%= f.id %>_flag" class="hf-label">Line <%= idx+1 %> Visibility</label>
                    <label class="hf-modern-toggle">
                      <input type="checkbox" value="1" id="<%= f.id %>_flag" name="<%= f.id %>_flag" class="hf-toggle-input" <%= f.flag == '1' ? 'checked' : '' %>>
                      <span class="hf-toggle-ui">
                        <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                        <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                        <span class="hf-toggle-thumb"></span>
                      </span>
                    </label>
                  </div>
                <% }); %>

                <div class="col-12">
                  <div class="hf-section-title">Print Settings</div>
                </div>

                <div class="col-md-4 hf-form-group">
                  <div class="hf-toggle-card">
                    <label for="in_on_off_flag" class="hf-label">IN Receipt</label>
                    <label class="hf-modern-toggle">
                      <input type="checkbox" value="Y" id="in_on_off_flag" name="in_on_off_flag" class="hf-toggle-input" <%= data.IN_on_off == 'Y' ? 'checked' : '' %>>
                      <span class="hf-toggle-ui">
                        <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                        <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                        <span class="hf-toggle-thumb"></span>
                      </span>
                    </label>
                  </div>
                </div>

                <div class="col-md-4 hf-form-group">
                  <div class="hf-toggle-card">
                    <label for="out_on_off_flag" class="hf-label">OUT Receipt</label>
                    <label class="hf-modern-toggle">
                      <input type="checkbox" value="Y" id="out_on_off_flag" name="out_on_off_flag" class="hf-toggle-input" <%= data.OUT_on_off == 'Y' ? 'checked' : '' %>>
                      <span class="hf-toggle-ui">
                        <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                        <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                        <span class="hf-toggle-thumb"></span>
                      </span>
                    </label>
                  </div>
                </div>

                <div class="col-md-4 hf-form-group">
                  <div class="hf-toggle-card">
                    <label for="report_flag" class="hf-label">Report Print</label>
                    <label class="hf-modern-toggle">
                      <input type="checkbox" value="Y" id="report_flag" name="report_flag" class="hf-toggle-input" <%= data.report_flag == 'Y' ? 'checked' : '' %>>
                      <span class="hf-toggle-ui">
                        <span class="hf-toggle-option hf-toggle-option-on">Active</span>
                        <span class="hf-toggle-option hf-toggle-option-off">Deactive</span>
                        <span class="hf-toggle-thumb"></span>
                      </span>
                    </label>
                  </div>
                </div>
              </div>

              <div class="text-center mt-5">
                <button type="submit" class="hf-submit-btn" id="submitBtn" disabled>Update Configuration</button>
              </div>
            </form>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // 1. Feather Icons
    if (typeof feather !== 'undefined') feather.replace();

    // 2. Back button
    $("#backBtn").click(function () {
      window.location.href = "/header/customer_name";
    });

    // 3. Initial character counts
    const fieldIds = ['header_1', 'header_2', 'header_3', 'header_4', 'footer_1', 'footer_2', 'footer_3', 'footer_4'];
    fieldIds.forEach((id, index) => updateCharCount(id, 'charCount' + (index + 1)));

    // 4. Change detection logic
    const trackableFields = [
      'header_1', 'header_1_flag',
      'header_2', 'header_2_flag',
      'header_3', 'header_3_flag',
      'header_4', 'header_4_flag',
      'footer_1', 'footer_1_flag',
      'footer_2', 'footer_2_flag',
      'footer_3', 'footer_3_flag',
      'footer_4', 'footer_4_flag',
      'in_on_off_flag', 'out_on_off_flag', 'report_flag'
    ];

    function getVal(id) {
      const $el = $('#' + id);
      if ($el.is(':checkbox')) return $el.prop('checked') ? '1' : '0';
      return ($el.val() || '').trim();
    }

    const initialState = {};
    trackableFields.forEach(id => initialState[id] = getVal(id));

    function evaluateChanges() {
      let changed = false;
      for (const id of trackableFields) {
        if (getVal(id) !== initialState[id]) {
          changed = true;
          break;
        }
      }
      $('#submitBtn').prop('disabled', !changed);
    }

    $(document).on('input change', 'textarea, input[type="checkbox"]', function() {
      evaluateChanges();
    });
  });

  // 5. Character count function
  function updateCharCount(textareaId, countId) {
    var textarea = document.getElementById(textareaId);
    var charCount = document.getElementById(countId);
    if (textarea && charCount) {
      var count = textarea.value.length;
      charCount.innerHTML = '<b>(' + count + '/30)</b>';
    }
  }
</script>



