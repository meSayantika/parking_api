<link href="/template/dist/css/operator-page.css" rel="stylesheet">

<div class="op-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card op-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="op-header" style="margin-bottom:20px;">
              <div class="op-title-group">
                <div class="op-icon-badge">
                  <i data-feather="truck"></i>
                </div>
                <h3 class="op-edit-title">Add Vehicle</h3>
              </div>
            </div>

            <!-- FORM -->
            <form>
              <div class="row mt-4">
                <div class="col-md-4 op-form-group">
                  <label class="op-label">Vehicle Name</label>
                  <input type="text" class="op-input" name="vehic" placeholder="Enter Vehicle Name">
                </div>

                <div class="col-md-4 op-form-group">
                  <label class="op-label">Select Vehicle Icon</label>
                  <select class="op-select" id="inlineFormCustomSelect">
                    <option selected>Choose Icon...</option>
                    <!-- Icon options here -->
                  </select>
                </div>

                <div class="col-md-4 op-form-group">
                  <div class="op-switch-container">
                    <label class="op-label">Vehicle Status</label>
                    <label class="op-switch">
                      <input type="checkbox" name="status" id="status" value="A" checked>
                      <span class="op-slider round"></span>
                    </label>
                  </div>
                </div>
              </div>

              <div class="text-center mt-4 pt-2">
                <button type="submit" class="op-submit-btn">Create Vehicle</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    feather.replace();
    $('.op-select').select2({
      width: '100%'
    });
  });
</script>