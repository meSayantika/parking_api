<link href="/template/dist/css/operator-page.css" rel="stylesheet">

<div class="op-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card op-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="op-header">
              <div class="op-title-group">
                <div class="op-icon-badge">
                  <i data-feather="key"></i>
                </div>
                <h3 class="op-edit-title">Report Password Settings</h3>
              </div>
            </div>

            <!-- FORM -->
            <form action="/report_password_save" method="post">
              <div class="row mt-3 align-items-end">
                <div class="col-md-3 op-form-group">
                  <div class="op-switch-container">
                    <label class="op-label">Report Password</label>
                    <label class="op-switch">
                      <input type="checkbox" value="Y" id="report_pwd" name="report_pwd"
                        <%= data.msg[0].report_password_flag != 'N' ? 'checked' : '' %>>
                      <span class="op-slider round"></span>
                    </label>
                  </div>
                </div>

                <div class="col-md-4 op-form-group" id="details">
                  <label class="op-label" for="pwd">New Password</label>
                  <div class="op-password-group">
                    <input type="password" id="pwd" name="pwd" class="op-input" value=""
                      placeholder="Enter new password..." />
                    <button class="op-password-toggle" type="button" id="togglePassword">
                      <i class="fa fa-eye-slash" id="eyeIcon"></i>
                    </button>
                  </div>
                </div>

                <div class="col-md-3 op-form-group">
                  <button type="submit" id="submitButton" class="op-submit-btn" disabled>Save Changes</button>
                </div>
              </div>
            </form>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
$(document).ready(function () {
    // Initialize Feather icons
    if (typeof feather !== 'undefined') {
        feather.replace();
    }

    const $report = $("#report_pwd");
    const $pwd = $("#pwd");
    const $details = $("#details");
    const $submit = $("#submitButton");
    const $togglePwd = $("#togglePassword");
    const $eyeIcon = $("#eyeIcon");

    // Capture initial state
    // initial.report_pwd stores if it was active ('Y') or inactive ('N')
    const initial = {
        report_pwd: $report.prop("checked") ? "Y" : "N",
        pwd: "" // initial password field is always empty for the user to type new one
    };

    /**
     * Logic to determine if the submit button should be enabled
     * Only enabled if the state has changed from the initial load
     */
    function evaluateChanges() {
        const now = {
            report_pwd: $report.prop("checked") ? "Y" : "N",
            pwd: ($pwd.val() || "").trim()
        };

        let changed = false;

        // Case 1: Initially Deactivated
        if (initial.report_pwd === "N") {
            if (now.report_pwd === "Y") {
                // Must provide a password to activate
                changed = now.pwd.length > 0;
            } else {
                // Stayed deactivated
                changed = false;
            }
        }
        // Case 2: Initially Activated
        else {
            if (now.report_pwd === "N") {
                // Turning off is a change
                changed = true;
            } else {
                // Staying on requires a new password to be considered a change
                changed = now.pwd.length > 0;
            }
        }

        $submit.prop("disabled", !changed);
    }

    // Event Listeners
    $report.on("change", function () {
        if ($(this).is(":checked")) {
            $details.slideDown(300);
        } else {
            $details.slideUp(300);
            $pwd.val(""); // Clear password if deactivating
        }
        evaluateChanges();
    });

    $pwd.on("input", evaluateChanges);

    // Password visibility toggle
    $togglePwd.on("click", function () {
        const isPassword = $pwd.attr("type") === "password";
        $pwd.attr("type", isPassword ? "text" : "password");
        $eyeIcon.toggleClass("fa-eye fa-eye-slash");
    });

    // Initial setup based on server-side data
    if (initial.report_pwd === "Y") {
        $details.show();
    } else {
        $details.hide();
    }
    evaluateChanges();
});
</script>






