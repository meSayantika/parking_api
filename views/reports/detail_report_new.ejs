<style>
.form-check{
    margin-right:50px;
}
 .exclbutton {
    margin-left: 15px;
    color: #246024;
    font-size: 14px;
    font-weight: 500;
 }
 .exclbutton:hover {
    color: #1f6b1f; /* brighter green on hover */
    cursor: pointer;
}
 .textcolor{
    color: black;
 } 

#goTopBtn, #goDownBtn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    z-index: 999;
    background-color: #8a4286;
    color: white;
    border: none;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
    display: none;
    box-shadow: 0px 3px 6px rgba(0,0,0,0.3);
}

#goTopBtn {
    bottom: 90px;
}

/* Bottom button appears above top button */
#goDownBtn {
    bottom: 30px;
}

#goTopBtn:hover, #goDownBtn:hover {
    background-color: #8a4286;
}
.exclbutton1 {
       float: right;
    color: #093809;
    font-size: 15px;
    font-weight: 500;
    background-color: white;
    border-color: #175217;
}
 .exclbutton1:hover {
    background-color: #326632; /* brighter green on hover */
    cursor: pointer;
}
#pageLoader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(3px);
    display: none;
    z-index: 9999;
}

.loader {
    width: 120px;
    height: 40px;
    margin: 20% auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.circle {
    width: 20px;
    height: 20px;
    background: #4CAF50;
    border-radius: 50%;
    animation: bounce 0.6s infinite alternate;
}

.circle:nth-child(2) {
    animation-delay: 0.2s;
}

.circle:nth-child(3) {
    animation-delay: 0.4s;
}

@keyframes bounce {
    to {
        transform: translateY(-20px);
        background: #2e7d32;
    }
}

.shadow {
    width: 20px;
    height: 4px;
    background: #bbb;
    border-radius: 50%;
    filter: blur(2px);
    animation: shadow 0.6s infinite alternate;
}

.shadow:nth-child(5) {
    animation-delay: 0.2s;
}

.shadow:nth-child(6) {
    animation-delay: 0.4s;
}

@keyframes shadow {
    to {
        transform: scale(0.7);
        background: #999;
    }
}
</style>    
<div class="container-fluid">
    <div class="col-sm-12 col-md-12 col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">
                    <%= title %>
                </h4>
                    <div class="row mb-4">
    <div class="col-md-12 text-center">
        <label class="text-dark font-weight-bold">Select Period</label>

        <div class="mt-2">
            <label class="mr-4">
                <input type="radio" name="month_filter" value="this_month">
                This Month
            </label>

            <label>
                <input type="radio" name="month_filter" value="prev_month">
                Previous Month
            </label>
        </div>
    </div>
</div>
                <div class="row dateCalenderField">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="frm_dt">From Date</label>
                            <input type="datetime-local" id="frm_dt" name="frm_dt" class="form-control" required="">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="to_dt">To Date</label>
                            <input type="datetime-local" id="to_dt" name="to_dt" class="form-control" required="">
                        </div>
                    </div>
                    <div class="form-group col-4">
                        <label for="pay_mode" class="text-dark"><b>Pay Mode:</b></label>
                        <select name="pay_mode" class="form-control" id="pay_mode">
                          <option value="">Select Pay Mode</option>
                          <option value="C">CASH</option>
                          <option value="U">UPI</option>
                          <option value="A">All</option>
                        </select>
                      </div>
                </div>
                <div class="row">
                      <div class="col-md-3 searchBtnDataWis" style="margin-left: 28vw;">
                        <button type="button" class="btn waves-effect waves-light btn-rounded btn-outline-primary" id="btnSubmit">Search</button>
                    </div>
                </div>
                <!-- <div class="card-body" id="resultDiv"> -->
                    <div class="dateWiseDataTable" id="resultDiv" style="display: block !important;">
                    <h4 class="card-title">
                        <center>
                            <span id="searchCred"></span>
                        </center>
                    </h4>
                  <div class="d-flex justify-content-end mb-2">
                    <!-- <button onclick="printAllTable()" class="btn btn-primary">Print All</button> -->
                    <button class="btn btn-success btn-sm exclbutton1" id="btnExcel">
                    <i class="fa fa-file-excel"></i> &nbsp; Download All Data
                   </button>
                  </div>
                    <div class="table-responsive">
                        <table class="table" id="cust-datatable">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Receipt No.</th>
                                    <th scope="col">Date Time In</th>
                                    <th scope="col">Machine Sl. No. In</th>
                                    <th scope="col">Vehicle Type</th>
                                    <th scope="col">Vehicle No.</th>
                                    <th scope="col">Date Time Out</th>
                                    <th scope="col">Duration</th>
                                    <th scope="col">Machine Sl. No. Out</th>
                                    <th scope="col">Base Amount</th>
                                    <th scope="col">Advance Amount</th>
                                    <th scope="col">CGST</th>
                                    <th scope="col">SGST</th>
                                    <th scope="col">IGST</th>
                                    <th scope="col">Gross Amount</th>
                                    <th scope="col">Net Amount</th>
                                    <th scope="col">Mode</th>
                                    <th scope="col">Operator Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                
                            </tbody>

                            <tfoot>
                                <tr>
                                    <td scope="col" colspan="9">Pagewise Total</td>
                                    <td scope="col" id="base_amt"><b>0</b></td>
                                    <td scope="col" id="advance_amt"><b>0</b></td>
                                    <td scope="col" id="cgst"><b>0</b></td>
                                    <td scope="col" id="sgst"><b>0</b></td>
                                    <td scope="col" id="igst"><b>0</b></td>
                                    <td scope="col" id="paid_amt"><b>0</b></td>
                                    <td scope="col" id="tot_amt"><b>0</b></td>
                                    <td scope="col" id="mode"><b></b></td>
                                    <td></td>
                                </tr>
                                <!-- <tr style="display: none;">
                                    <td scope="col" colspan="2">Total UPI</td>
                                    <td scope="col" class="text-left" id="tot_upi" colspan="17"></td>
                                </tr>
                                <tr style="display: none;">
                                    <td scope="col" colspan="2">Total Cash</td>
                                    <td scope="col" class="text-left" id="tot_cash" colspan="17"></td>
                                </tr>  -->
                                <tr id="upiRow" style="display: none;">
                                <td colspan="18" class="text-left"><b>Grand Total UPI: </b><span id="tot_upi"></span></td>
                                </tr>

                                <tr id="cashRow" style="display: none;">
                                <td colspan="18" class="text-left"><b>Grand Total Cash: </b><span id="tot_cash"></span></td>
                                </tr>
                            </tfoot>
                        </table>

                        <a href="#" class="printBtnDate" onclick="printDiv()"><i class="fa fa-print"></i> Print</a>
