<script>
function downloadExcel() {
    // Get the table element
    // var table = document.querySelector("#resultDiv table");
    var table = document.querySelector("#cust-datatable");
    // console.log(table,'TABLE');
    

    if (!table) {
        alert("No data available to export!");
        return;
    }

    // Convert table to worksheet
    var workbook = XLSX.utils.book_new();
    var rows = [];
    // var worksheet = XLSX.utils.table_to_sheet(table);

     // STEP 1: Read table rows normally (NO QUOTES)
    table.querySelectorAll("tr").forEach(tr => {
        //  if (index < 3) return;
        let row = [];
        tr.querySelectorAll("th, td").forEach((cell) => {
            row.push(cell.innerText.trim());
        });
        rows.push(row);
    });

    // STEP 2: Convert to sheet
    var worksheet = XLSX.utils.aoa_to_sheet(rows);

    // STEP 3: Force specific columns to TEXT format (NO auto conversion)
    Object.keys(worksheet).forEach(key => {
        if (key.startsWith("!")) return; // skip metadata

        let cell = worksheet[key];
        if (!cell || !cell.v) return;

        let col = key.replace(/[0-9]/g, ""); // get column letter(s)

        // Receipt No. → column B
        // if (col === "B") {
        //     cell.t = "s";        // force as text
        // }

        // DateTime In → column C
        // if (col === "C") {
        //     cell.t = "s";        // force as text
        // }

        // DateTime Out → column G
        // if (col === "G") {
        //     cell.t = "s";
        // }
         if (["B","C","G"].includes(col)) {
            cell.t = "s";
        }
    });

    // Convert array → sheet
    // var worksheet = XLSX.utils.aoa_to_sheet(rows);

    XLSX.utils.book_append_sheet(workbook, worksheet, "Detail Report");

    // Download Excel file
    XLSX.writeFile(workbook, "Detail_Report.xlsx");
}
</script>

<script>
$("#btnExcel").on("click", function () {

    var frm_dt = $("#frm_dt").val();
    var to_dt = $("#to_dt").val();
    var pay_mode = $("#pay_mode").val();
    var period = $('input[name="month_filter"]:checked').val() // ADD THIS

    if (!frm_dt || !to_dt || !pay_mode || !period) {
        alert("Please select all filters before downloading!");
        return;
    }

    $.ajax({
        url: "/report/get_details_report_excel",
        type: "POST",
        data: { frm_dt, to_dt, pay_mode, period },
        beforeSend: function () {
            $(".preloader").fadeIn();
        },
        success: function (res) {
            if (res.suc === 1) {
                generateExcel(res.data);
            } else {
                alert("No Data Found!");
            }
        },
        complete: function () {
            $(".preloader").fadeOut();
        }
    });
});

function generateExcel(data) {

    let rows = [];

    let total_base = 0, total_adv = 0, total_cgst = 0, total_sgst = 0, total_igst = 0,
        total_paid = 0, total_cash = 0, total_upi = 0;

    // HEADER
    rows.push([
        "#", "Receipt No", "Date Time In", "Machine In",
        "Vehicle Type", "Vehicle No", "Date Time Out",
        "Duration", "Machine Out", "Base Amt", "Advance Amt",
        "CGST", "SGST", "IGST", "Paid Amt", "Net Amt", "Mode", "Operator Name"
    ]);

    // DETAILS ROWS
    data.forEach((dt, i) => {

        let netAmt = Number(dt.paid_amt) + Number(dt.advance_amt);

        rows.push([
            i + 1,
            dt.receipt_no,
            dt.date_time_in,
            dt.device_id,
            dt.vehicle_name,
            dt.vehicle_no,
            dt.date_time_out,
            dt.total_time,
            dt.device_id_out,
            dt.base_amt,
            dt.advance_amt,
            dt.cgst,
            dt.sgst,
            dt.igst,
            dt.paid_amt,
            netAmt,
            dt.pay_mode === "U" ? "UPI" : dt.pay_mode === "C" ? "CASH" : "",
            dt.operator_name
        ]);

        total_base += Number(dt.base_amt);
        total_adv += Number(dt.advance_amt);
        total_cgst += Number(dt.cgst);
        total_sgst += Number(dt.sgst);
        total_igst += Number(dt.igst);
        total_paid += Number(dt.paid_amt);

        if (dt.pay_mode === "C") total_cash += Number(dt.paid_amt);
        if (dt.pay_mode === "U") total_upi += Number(dt.paid_amt);
    });

    // BLANK ROW
    rows.push([]);

    // EXACT TOTAL ROW LIKE YOUR SCREENSHOT
    rows.push([
        "Total",     // Column A
        "", "", "", "", "", "", "", "",   // B–I empty
        total_base,   // Base Amt (column J)
        total_adv,    // Advance Amt (column K)
        total_cgst,   // CGST (column L)
        total_sgst,   // SGST (column M)
        total_igst,   // SGST (column N)
        total_paid,   // Paid Amt (column O)
        total_paid,   // Net Amt (column P)
        "",
        ""
        // total_cash,   // Mode total Cash under Mode column (P)
        // total_upi     // Mode total UPI under Operator column (Q)
    ]);

    // NEXT ROW: TOTAL UPI
    rows.push([
        "Total UPI:", total_upi
    ]);

    // NEXT ROW: TOTAL CASH
    rows.push([
        "Total Cash:", total_cash
    ]);

    // GENERATE
    let workbook = XLSX.utils.book_new();
    let worksheet = XLSX.utils.aoa_to_sheet(rows);

    // FORCE COLUMN B (Receipt No) AS TEXT
let totalRows = rows.length;
for (let i = 2; i <= totalRows; i++) {  
    let cellRef = "B" + i;   // B2, B3, B4...
    if (worksheet[cellRef]) {
        worksheet[cellRef].z = "@"; // force text format
        worksheet[cellRef].t = "s"; // mark as text type
    }
}

    XLSX.utils.book_append_sheet(workbook, worksheet, "Detail Report");

    XLSX.writeFile(workbook, "Detail_Report_All.xlsx");
}
</script>



