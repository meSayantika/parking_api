    <script>
let table;

$('#btnSubmit').on('click', function () {
    var frm_dt = $('#frm_dt').val();
    var to_dt = $('#to_dt').val();
    var pay_mode = $('#pay_mode').val();
    var period  = $('input[name="month_filter"]:checked').val();

    if (frm_dt !== '' && to_dt !== '' && pay_mode !== '' && period !== '') {

        if (table) {
            table.destroy();     // destroy previous instance
            $('#cust-datatable tbody').empty();
        }

    //  if ($.fn.DataTable.isDataTable('#cust-datatable')) { $('#cust-datatable').DataTable().clear().destroy(); $('#cust-datatable tbody').empty(); }

        table = $('#cust-datatable').DataTable({
    processing: true,
    serverSide: true,
    searching: false,
    lengthChange: true,
    pageLength: 50,
    ajax: {
        url: "/report/get_details_report_new",
        type: "POST",
        data: function (d) {
            d.frm_dt = $('#frm_dt').val();
            d.to_dt = $('#to_dt').val();
            d.pay_mode = $('#pay_mode').val();
            d.period = $('input[name="month_filter"]:checked').val();
        },
         beforeSend: function () {
                    $('#pageLoader').fadeIn();
                },
                complete: function () {
                    $('#pageLoader').fadeOut();
                }
    },
    columns: [
        { 
            data: null,
            render: function (data, type, row, meta) {
                return meta.row + meta.settings._iDisplayStart + 1;
            }
        },
        { data: "receipt_no" },
        { data: "date_time_in" },
        { data: "device_id" },
        { data: "vehicle_name" },
        { data: "vehicle_no" },
        { data: "date_time_out" },
        { data: "total_time" },
        { data: "device_id_out" },
        { 
            data: "base_amt",
            render: d => Number(d || 0).toFixed(2)
        },
        { 
            data: "advance_amt",
            render: d => Number(d || 0).toFixed(2)
        },
        { 
            data: "cgst",
            render: d => Number(d || 0).toFixed(2)
        },
        { 
            data: "sgst",
            render: d => Number(d || 0).toFixed(2)
        },
         { 
            data: "igst",
            render: d => Number(d || 0).toFixed(2)
        },
