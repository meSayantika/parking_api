<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

<script>
function downloadExcel() {
    // Get the table element
    var table = document.querySelector("#cust-datatable");

    if (!table) {
        alert("No data available to export!");
        return;
    }

    // Convert table to worksheet
    var workbook = XLSX.utils.book_new();
    var rows = [];

    // var worksheet = XLSX.utils.table_to_sheet(table);

    // STEP 1: Read table rows normally (NO QUOTES)
    table.querySelectorAll("tr").forEach(tr => {
        let row = [];
        tr.querySelectorAll("th, td").forEach((cell) => {
            row.push(cell.innerText.trim());
        });
        rows.push(row);
    });

    // STEP 2: Convert to sheet
    var worksheet = XLSX.utils.aoa_to_sheet(rows);

    // STEP 3: Force specific columns to TEXT format (NO auto conversion)
    Object.keys(worksheet).forEach(key => {
        if (key.startsWith("!")) return; // skip metadata

        let cell = worksheet[key];
        if (!cell || !cell.v) return;

        let col = key.replace(/[0-9]/g, ""); // get column letter(s)

        // Receipt No. → column B
        if (col === "B") {
            cell.t = "s";        // force as text
        }

        // DateTime In → column C
        if (col === "C") {
            cell.t = "s";        // force as text
        }

        // DateTime Out → column G
        if (col === "G") {
            cell.t = "s";
        }
    });

    XLSX.utils.book_append_sheet(workbook, worksheet, "Combine Report Vehiclewise");

    // Download Excel file
    XLSX.writeFile(workbook, "Combine_Report_Vehiclewise.xlsx");
}
</script>


<script>
// Show button on scroll
window.onscroll = function () {
    const topBtn = document.getElementById("goTopBtn");
    const downBtn = document.getElementById("goDownBtn");

    if (document.body.scrollTop > 100 || document.documentElement.scrollTop > 100) {
        topBtn.style.display = "block";
    } else {
        topBtn.style.display = "none";
    }

    // Show bottom button only if NOT already at bottom
    if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 100) {
        downBtn.style.display = "none";
    } else {
        downBtn.style.display = "block";
    }
};

// Scroll to top
document.getElementById("goTopBtn").onclick = function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
};

// Scroll to bottom
document.getElementById("goDownBtn").onclick = function () {
    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
};
</script>