<div class="container-fluid">
    <div class="col-sm-12 col-md-12 col-lg-12">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">
                    <%= title %>
                </h4>
                <div class="row dateCalenderField">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="frm_dt">From Date</label>
                            <input type="datetime-local" id="frm_dt" name="frm_dt" class="form-control" required="">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="to_dt">To Date</label>
                            <input type="datetime-local" id="to_dt" name="to_dt" class="form-control" required="">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="vehicle_id">Select Vehicle</label>
                            <select name="vehicle_id" id="vehicle_id" class="form-control" required="">

                                <option value="">Select Vehicle</option>"
                                <% combineData.msg.forEach(function(item,index) { %>
                                    <option value="<%= item.vehicle_id %>">
                                        <%= item.vehicle_name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2 searchBtnDataWis">
                        <button type="button" class="btn waves-effect waves-light btn-rounded btn-outline-primary"
                            id="btnSubmit">Search</button>
                    </div>
                </div>
                <!-- <div class="card-body" id="resultDiv"> -->
                <div class="dateWiseDataTable" id="resultDiv">
                    <h4 class="card-title">
                        <center>
                            <span id="searchCred"></span>
                        </center>
                    </h4>
                    <div class="table-responsive">
                        <table class="table table-bordered" id="cust-datatable">
                            <thead class="thead-dark">
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Machine Sl. No.</th>
                                    <th scope="col">Operator Name</th>
                                    <th scope="col">Base Amount</th>
                                    <th scope="col">Advance Amount</th>
                                    <th scope="col">CGST</th>
                                    <th scope="col">SGST</th>
                                    <th scope="col">IGST</th>
                                    <th scope="col">Paid Amount</th>
                                    <th scope="col">Net Amount</th>
                                </tr>
                            </thead>
                            <tbody>

                            </tbody>

                            <tfoot>
                                <tr>
                                    <td colspan="3">Total</td>
                                    <td scope="col" id="tot_base"><b>0</b></td>
                                    <td scope="col" id="advance_amt"><b>0</b></td>
                                    <td scope="col" id="tot_cgst"><b>0</b></td>
                                    <td scope="col" id="tot_sgst"><b>0</b></td>
                                    <td scope="col" id="tot_igst"><b>0</b></td>
                                    <td scope="col" id="paid_amt"><b>0</b></td>
                                    <td scope="col" id="tot_amt"><b>0</b></td>
                                </tr>
                            </tfoot>
                        </table>

                        <a href="#" class="printBtnDate" onclick="printDiv()"><i class="fa fa-print"></i> Print</a>
                        <a href="#" class="exclbutton" onclick="downloadExcel()"><i class="fa fa-file-excel"></i> Excel</a>
                    </div>
                </div>
                  <button id="goTopBtn" title="Go to Top">
                  <i class="fa fa-arrow-up"></i>
                </button>
                <button id="goTopBtn" title="Go to Top">
                  <i class="fa fa-arrow-down"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<script src="https://raw.githubusercontent.com/phstc/jquery-dateFormat/master/dist/dateFormat.min.js"></script>
<script>
    $(document).ready(function () {
        $('#resultDiv').hide()
    })
</script>
<script>
    $('#btnSubmit').on('click', function () {
        var frm_dt = $('#frm_dt').val()
        var to_dt = $('#to_dt').val()
        var vehicle_id = $('#vehicle_id').val()

        if (frm_dt != '' && to_dt != '' && vehicle_id != '') {
            $.ajax({
                method: "POST",
                url: "/report/get_combine_repo_new",
                data: { frm_dt, to_dt, vehicle_id },
                dataType: "html",
                beforeSend: function () {
                    $(".preloader").fadeIn();
                },
                success: function (result) {
                    var res = JSON.parse(result);
                    var paid_amt_tot = 0;
                    var base_amt_tot = 0;
                    var advance_amt_tot = 0;
                    var cgst_amt_tot = 0;
                    var sgst_amt_tot = 0;
                    var igst_amt_tot = 0;
                    var total_amt_tot = 0;
                    var tot_amt_tot = 0;
                    $('#resultDiv').show()
                    $('#resultDiv table tbody').empty()
                    console.log(res)
                    if (res.suc > 0) {
                        if (res.msg.length > 0) {
                            $('#searchCred').text(`Combine Report For Vehiclewise from ${createDate(frm_dt)} to ${createDate(to_dt)}`)
                            let i = 1;
                            for (let dt of res.msg) {
                                base_amt_tot += Number(dt.base_amt)
                                advance_amt_tot += Number(dt.advance_amt)
                                cgst_amt_tot += Number(dt.cgst)
                                sgst_amt_tot += Number(dt.sgst)
                                igst_amt_tot += Number(dt.igst)
                                paid_amt_tot += Number(dt.paid_amt)
                                total_amt_tot = (Number(dt.paid_amt) + Number(dt.advance_amt))
                                tot_amt_tot += Number(total_amt_tot)

                                $('#resultDiv table tbody').append(`
                                    <tr>
                                        <td class="textcolor">${i}</td>
                                        <td class="textcolor">${dt.device_id}</td>
                                        <td class="textcolor">${dt.operator_name}</td>
                                        <td class="textcolor">${Number(dt.base_amt) > 0 ? Number(dt.base_amt).toFixed(2) : dt.base_amt}</td>
                                        <td class="textcolor">${Number(dt.advance_amt) > 0 ? Number(dt.advance_amt) : dt.advance_amt}</td>
                                        <td class="textcolor">${Number(dt.cgst) > 0 ? Number(dt.cgst).toFixed(2) : dt.cgst}</td>
                                        <td class="textcolor">${Number(dt.sgst) > 0 ? Number(dt.sgst).toFixed(2) : dt.sgst}</td>
                                        <td class="textcolor">${Number(dt.igst) > 0 ? Number(dt.igst).toFixed(2) : dt.igst}</td>
                                        <td class="textcolor">${dt.paid_amt}</td>
                                        <td class="textcolor">${total_amt_tot}</td>
                                    </tr>
                                    `)
                                i++
                            }
                            $('#tot_base').text(Number(base_amt_tot) > 0 ? Number(base_amt_tot).toFixed(2) : base_amt_tot)
                            $('#advance_amt').text(Number(advance_amt_tot) > 0 ? Number(advance_amt_tot).toFixed(2) : advance_amt_tot)
                            $('#tot_cgst').text(Number(cgst_amt_tot) > 0 ? Number(cgst_amt_tot).toFixed(2) : cgst_amt_tot)
                            $('#tot_sgst').text(Number(sgst_amt_tot) > 0 ? Number(sgst_amt_tot).toFixed(2) :sgst_amt_tot )
                            $('#tot_igst').text(Number(igst_amt_tot) > 0 ? Number(igst_amt_tot).toFixed(2) :igst_amt_tot )
                            $('#paid_amt').text(paid_amt_tot)
                            $('#tot_amt').text(tot_amt_tot)
                        } else {
                            $('#resultDiv table tbody').append('<tr><td colspan="9" class="text-center text-danger">No Data Found</td></tr>')
                            $('#tot_base').text(Number(base_amt_tot) > 0 ? Number(base_amt_tot).toFixed(2) : base_amt_tot)
                            $('#advance_amt').text(Number(advance_amt_tot) > 0 ? Number(advance_amt_tot).toFixed(2) : advance_amt_tot)
                            $('#tot_cgst').text(Number(cgst_amt_tot) > 0 ? Number(cgst_amt_tot).toFixed(2) : cgst_amt_tot)
                            $('#tot_sgst').text(Number(sgst_amt_tot) > 0 ? Number(sgst_amt_tot).toFixed(2) :sgst_amt_tot )
                            $('#tot_igst').text(Number(igst_amt_tot) > 0 ? Number(igst_amt_tot).toFixed(2) :igst_amt_tot )
                            $('#paid_amt').text(paid_amt_tot)
                            $('#tot_amt').text(tot_amt_tot)
                        }
                    }
                },
                complete: function () {
                    $(".preloader").fadeOut();
                }
            })
        }
    })
</script>

