<link href="/template/dist/css/operator-page.css" rel="stylesheet">
<style>
    /* ---- Scroll buttons ---- */
    #goTopBtn, #goDownBtn, #goLeftBtn, #goRightBtn {
        position: fixed;
        z-index: 999;
        background-color: var(--green-600);
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        display: none;
        box-shadow: 0px 3px 6px rgba(0, 0, 0, 0.3);
    }
    #goTopBtn { bottom: 90px; right: 30px; }
    #goDownBtn { bottom: 30px; right: 30px; }
    #goLeftBtn { bottom: 30px; left: 30px; }
    #goRightBtn { bottom: 30px; left: 90px; }
    #goTopBtn:hover, #goDownBtn:hover, #goLeftBtn:hover, #goRightBtn:hover {
        background-color: var(--green-700);
    }

    /* ---- Pagination Overrides ---- */
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        color: var(--gray-700) !important;
        background: var(--white) !important;
        border: 1px solid var(--gray-200) !important;
        padding: 2px 8px !important;
        margin: 0 2px !important;
        border-radius: 4px !important;
        cursor: pointer !important;
        font-size: 0.7rem !important;
        display: inline-block !important;
        line-height: 1.1 !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: var(--green-50) !important;
        color: var(--green-600) !important;
        border-color: var(--green-200) !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
        background: var(--green-600) !important;
        color: white !important;
        border-color: var(--green-600) !important;
        font-weight: bold !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
        opacity: 0.5 !important;
        cursor: not-allowed !important;
        background: var(--gray-50) !important;
        color: var(--gray-400) !important;
    }
    .dataTables_wrapper .dataTables_info {
        font-size: 0.85rem !important;
        color: var(--gray-600) !important;
        padding-top: 10px !important;
    }

    /* ---- Page Loader ---- */
    #pageLoader {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(3px);
        display: none;
        z-index: 9999;
    }
    .loader {
        width: 120px; height: 40px;
        margin: 20% auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .circle {
        width: 20px; height: 20px;
        background: var(--green-500);
        border-radius: 50%;
        animation: bounce 0.6s infinite alternate;
    }
    .circle:nth-child(2) { animation-delay: 0.2s; }
    .circle:nth-child(3) { animation-delay: 0.4s; }
    @keyframes bounce {
        to { transform: translateY(-20px); background: var(--green-700); }
    }
    .shadow {
        width: 20px; height: 4px;
        background: #bbb;
        border-radius: 50%;
        filter: blur(2px);
        animation: shadow 0.6s infinite alternate;
    }
    .shadow:nth-child(5) { animation-delay: 0.2s; }
    .shadow:nth-child(6) { animation-delay: 0.4s; }
    @keyframes shadow {
        to { transform: scale(0.7); background: #999; }
    }

    /* ---- Print: hide layout chrome ---- */
    @media print {
        .left-sidebar, .topbar, .page-breadcrumb, .footer, nav,
        #goTopBtn, #goDownBtn, .op-filter-sec, .op-header,
        .printBtnDate, .exclbutton, .exclbutton1,
        .dataTables_length, .dataTables_filter,
        .dataTables_paginate, .dataTables_info,
        #btnExcel { display: none !important; }
        .page-wrapper, .container-fluid, .op-page-wrapper,
        .op-card, .card-body, .op-table-wrap {
            padding: 0 !important; margin: 0 !important;
            border: none !important; box-shadow: none !important;
            width: 100% !important;
        }
        .op-table th {
            color: #fff !important;
            background-color: #1c2d41 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        body { margin: 0 !important; padding: 0 !important; }
    }

    /* ---- DataTable toolbar row: Show entries left, Download All right ---- */
    .dt-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .dataTables_length {
        margin-bottom: 0 !important;
    }
    #btnExcel {
        padding: 8px 18px;
        font-size: 0.82rem;
    }

    /* ---- Search button matches input height ---- */
    #btnSubmit.op-submit-btn {
        width: auto;
        padding: 8px 20px;
        height: auto;
    }
</style>

<div class="op-page-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card op-card">
                    <div class="card-body">

                        <!-- HEADER -->
                        <div class="op-header">
                            <div class="op-title-group">
                                <div class="op-icon-badge">
                                    <i data-feather="file-text"></i>
                                </div>
                                <h3 class="op-page-title">
                                    <%= title %>
                                </h3>
                            </div>
                        </div>

                        <!-- FILTER SECTION -->
                        <div class="op-filter-sec">
                            <div class="row align-items-center">
                                <div class="col-md-3 op-form-group mb-0">
                                    <label class="op-label" for="frm_dt">From Date</label>
                                    <input type="datetime-local" id="frm_dt" name="frm_dt" class="op-input" required="">
                                </div>
                                <div class="col-md-3 op-form-group mb-0">
                                    <label class="op-label" for="to_dt">To Date</label>
                                    <input type="datetime-local" id="to_dt" name="to_dt" class="op-input" required="">
                                </div>
                                <div class="col-md-4 op-form-group mb-0">
                                    <label class="op-label" for="vehicle_id">Select Vehicle</label>
                                    <select name="vehicle_id" id="vehicle_id" class="op-input op-select" required="">
                                        <option value="">Select Vehicle</option>
                                        <% combineData.msg.forEach(function(item,index) { %>
                                            <option value="<%= item.vehicle_id %>">
                                                <%= item.vehicle_name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-2" style="margin-top: 26px;">
                                    <button type="button" class="op-submit-btn" id="btnSubmit">
                                        <i data-feather="search" style="width:15px;height:15px;margin-right:6px;"></i> Search
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- TABLE CONTENT -->
                        <div class="op-table-wrap mt-2 dateWiseDataTable" id="resultDiv" style="display:block !important;">
                            <h4 class="card-title mb-2 mt-2">
                                <center>
                                    <span id="searchCred" style="font-weight:600;color:var(--gray-800);display:inline-block;"></span>
                                </center>
                            </h4>
                            <div class="table-responsive">
                                <table class="table op-table table-bordered" id="cust-datatable">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Machine Sl. No.</th>
                                            <th scope="col">Operator Name</th>
                                            <th scope="col">Base Amount</th>
                                            <th scope="col">Advance Amount</th>
                                            <th scope="col">CGST</th>
                                            <th scope="col">SGST</th>
                                            <th scope="col">IGST</th>
                                            <th scope="col">Paid Amount</th>
                                            <th scope="col">Net Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>

                                    <tfoot>
                                        <tr>
                                            <td colspan="3" style="font-weight:700;text-align:center;">Total</td>
                                            <td scope="col" id="tot_base" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="advance_amt" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_cgst" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_sgst" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_igst" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="paid_amt" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_amt" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                        </tr>   
                                    </tfoot>
                                </table>

                                <div class="mt-1" style="text-align: left; display: flex; gap: 10px;">
                                    <a href="#" class="op-add-btn printBtnDate" onclick="printDiv()" style="background:linear-gradient(135deg, var(--green-500), white);color:var(--gray-800);box-shadow:none;border:1px solid var(--green-500);text-decoration:none;">
                                        <i data-feather="printer" style="width:15px;height:15px;margin-right:4px;"></i> Print
                                    </a>
                                    <button type="button" id="btnExcel" class="op-add-btn exclbutton" onclick="downloadExcel()">
                                        <i data-feather="file-text" style="width:15px;height:15px;margin-right:4px;"></i> Excel
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<button id="goTopBtn" title="Go to Top"><i class="fa fa-arrow-up"></i></button>
<button id="goDownBtn" title="Go to Bottom"><i class="fa fa-arrow-down"></i></button>
<button id="goLeftBtn" title="Scroll Left"><i class="fa fa-arrow-left"></i></button>
<button id="goRightBtn" title="Scroll Right"><i class="fa fa-arrow-right"></i></button>

<div id="pageLoader">
    <div class="loader">
        <div class="circle"></div>
        <div class="circle"></div>
        <div class="circle"></div>
        <div class="shadow"></div>
        <div class="shadow"></div>
        <div class="shadow"></div>
    </div>
</div>

<script src="https://raw.githubusercontent.com/phstc/jquery-dateFormat/master/dist/dateFormat.min.js"></script>

<script>
    $(document).ready(function(){
        $('#resultDiv').hide();
        if (typeof feather !== 'undefined') {
            feather.replace();
        }
        if ($.fn.select2) {
            $('.op-select').select2({ width: '100%' });
        }
    });

    var dataTable;
    $('#btnSubmit').on('click', function(){
        var frm_dt = $('#frm_dt').val()
        var to_dt = $('#to_dt').val()
        var vehicle_id = $('#vehicle_id').val()
        
        if (frm_dt != '' && to_dt != '' && vehicle_id != '') {
            $('#resultDiv').show();
            $('#searchCred').text(`Combine Report For Vehiclewise from ${createDate(frm_dt)} to ${createDate(to_dt)}`);
            
            if(dataTable){
                dataTable.destroy();
            }

            $("#pageLoader").fadeIn();
            
            dataTable = $('#cust-datatable').DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                ajax: {
                    url: "/report/get_combine_repo_new",
                    type: "POST",
                    data: function (d) {
                        d.frm_dt = frm_dt;
                        d.to_dt = to_dt;
                        d.vehicle_id = vehicle_id;
                    },
                    dataSrc: function (json) {
                        $("#pageLoader").fadeOut();
                        return json.data;
                    },
                    error: function() {
                        $("#pageLoader").fadeOut();
                    }
                },
                columns: [
                    { 
                        data: null, 
                        render: function (data, type, row, meta) {
                            return `<span class="textcolor">${meta.row + meta.settings._iDisplayStart + 1}</span>`;
                        }
                    },
                    { data: 'device_id', render: function(data){ return `<span class="textcolor">${data}</span>`; } },
                    { data: 'operator_name', render: function(data){ return `<span class="textcolor">${data}</span>`; } },
                    { data: 'base_amt', render: function(data){ return `<span class="textcolor">${Number(data)>0 ? Number(data).toFixed(2) : data}</span>`; } },
                    { data: 'advance_amt', render: function(data){ return `<span class="textcolor">${Number(data)>0 ? Number(data).toFixed(2) : data}</span>`; } },
                    { data: 'cgst', render: function(data){ return `<span class="textcolor">${Number(data)>0 ? Number(data).toFixed(2) : data}</span>`; } },
                    { data: 'sgst', render: function(data){ return `<span class="textcolor">${Number(data)>0 ? Number(data).toFixed(2) : data}</span>`; } },
                    { data: 'igst', render: function(data){ return `<span class="textcolor">${Number(data)>0 ? Number(data).toFixed(2) : data}</span>`; } },
                    { data: 'paid_amt', render: function(data){ return `<span class="textcolor">${data}</span>`; } },
                    { 
                        data: null, 
                        render: function(data, type, row){ 
                            let net = Number(row.advance_amt) + Number(row.paid_amt);
                            return `<span class="textcolor">${net}</span>`; 
                        } 
                    }
                ],
                drawCallback: function(settings) {
                    var api = this.api();
                    var json = api.ajax.json();
                    
                    if (json && json.totals) {
                        $('#tot_base').text(Number(json.totals.base_amt)>0 ? Number(json.totals.base_amt).toFixed(2) : 0);
                        $('#advance_amt').text(Number(json.totals.advance_amt)>0 ? Number(json.totals.advance_amt).toFixed(2) : 0);
                        $('#tot_cgst').text(Number(json.totals.cgst)>0 ? Number(json.totals.cgst).toFixed(2) : 0);
                        $('#tot_sgst').text(Number(json.totals.sgst)>0 ? Number(json.totals.sgst).toFixed(2) : 0);
                        $('#tot_igst').text(Number(json.totals.igst)>0 ? Number(json.totals.igst).toFixed(2) : 0);
                        $('#paid_amt').text(json.totals.paid_amt || 0);
                        
                        let netTot = Number(json.totals.advance_amt || 0) + Number(json.totals.paid_amt || 0);
                        $('#tot_amt').text(netTot);
                    } else {
                        $('#tot_base, #advance_amt, #tot_cgst, #tot_sgst, #tot_igst, #paid_amt, #tot_amt').text('0');
                    }
                    if (typeof feather !== 'undefined') {
                        feather.replace();
                    }
                }
            });
        }
    })
</script>

<script>
    function printDiv() {
        var divToPrint = document.getElementById('resultDiv');

        var WindowObject = window.open('', 'Print-Window');
        WindowObject.document.open();
        WindowObject.document.writeln('<!DOCTYPE html>');
        WindowObject.document.writeln('<html><head><title></title>');
        WindowObject.document.writeln('<style type="text/css">');

        WindowObject.document.writeln(`
            @media print {
                .center { text-align: center; }
                .inline { display: inline; }
                .underline { text-decoration: underline; }
                .left { margin-left: 315px; }
                .right { margin-right: 375px; display: inline; }
                body { text-align: center; }
                .table-responsive { width: 100%; display: flex; justify-content: center; }
                table { border-collapse: collapse; font-size: 10px; width: 90%; margin: 0 auto; }
                th, td { 
                    border: 1px solid black;
                    padding: 6px;
                    font-family: Arial, Helvetica, sans-serif;
                    text-align: center;
                }
                .table .thead-dark th, .op-table th {
                    color: #fff !important;
                    background-color: #1c2d41 !important;
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }
                tfoot { font-weight: 700; color: #000; }
                .printBtnDate, .exclbutton, .exclbutton1, #btnExcel { display: none !important; }
                .border { border: 1px solid black; }
                .bottom { bottom: 5px; width: 100%; position: fixed; }
                
                .dataTables_length,
                .dataTables_filter,
                .dataTables_info,
                .dataTables_paginate,
                .paging_simple_numbers,
                .pagination,
                .dt-buttons {
                    display: none !important;
                }
            }
        `);

        WindowObject.document.writeln('</style>');
        WindowObject.document.writeln('</head><body onload="window.print()">');
        WindowObject.document.writeln(divToPrint.innerHTML);
        WindowObject.document.writeln('</body></html>');
        WindowObject.document.close();

        setTimeout(function () {
            WindowObject.close();
        }, 1);
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

<script>
function downloadExcel() {
    var frm_dt = $('#frm_dt').val();
    var to_dt = $('#to_dt').val();
    var vehicle_id = $('#vehicle_id').val();
    
    if(!frm_dt || !to_dt || !vehicle_id){
        alert("Please search first before exporting!");
        return;
    }

    $("#pageLoader").fadeIn();
    
    $.ajax({
        method: "POST",
        url: "/report/get_combine_repo_new",
        data: { frm_dt: frm_dt, to_dt: to_dt, vehicle_id: vehicle_id, export: 'true' },
        dataType: "json",
        success: function (res) {
            $("#pageLoader").fadeOut();
            if(res.suc > 0 && res.msg.length > 0){
                var rows = [];
                rows.push(["#", "Machine No", "Operator Name", "Base Amount", "Advance Amount", "CGST", "SGST", "IGST", "Paid Amount", "Net Amount"]);
                
                var base_amt_tot = 0, advance_amt_tot = 0, cgst_amt_tot = 0, sgst_amt_tot = 0, igst_amt_tot = 0, paid_amt_tot = 0, tot_amt_tot = 0;
                let i = 1;
                
                for(let dt of res.msg){
                    let net_amt = Number(dt.advance_amt) + Number(dt.paid_amt);
                    base_amt_tot += Number(dt.base_amt);
                    advance_amt_tot += Number(dt.advance_amt);
                    cgst_amt_tot += Number(dt.cgst);
                    sgst_amt_tot += Number(dt.sgst);
                    igst_amt_tot += Number(dt.igst);
                    paid_amt_tot += Number(dt.paid_amt);
                    tot_amt_tot += net_amt;

                    rows.push([
                        i++,
                        dt.device_id,
                        dt.operator_name,
                        Number(dt.base_amt) > 0 ? Number(dt.base_amt).toFixed(2) : dt.base_amt,
                        Number(dt.advance_amt) > 0 ? Number(dt.advance_amt).toFixed(2) : dt.advance_amt,
                        Number(dt.cgst) > 0 ? Number(dt.cgst).toFixed(2) : dt.cgst,
                        Number(dt.sgst) > 0 ? Number(dt.sgst).toFixed(2) : dt.sgst,
                        Number(dt.igst) > 0 ? Number(dt.igst).toFixed(2) : dt.igst,
                        dt.paid_amt,
                        net_amt
                    ]);
                }

                rows.push([
                    "Total", "", "",
                    Number(base_amt_tot) > 0 ? Number(base_amt_tot).toFixed(2) : base_amt_tot,
                    Number(advance_amt_tot) > 0 ? Number(advance_amt_tot).toFixed(2) : advance_amt_tot,
                    Number(cgst_amt_tot) > 0 ? Number(cgst_amt_tot).toFixed(2) : cgst_amt_tot,
                    Number(sgst_amt_tot) > 0 ? Number(sgst_amt_tot).toFixed(2) : sgst_amt_tot,
                    Number(igst_amt_tot) > 0 ? Number(igst_amt_tot).toFixed(2) : igst_amt_tot,
                    paid_amt_tot,
                    tot_amt_tot
                ]);

                var worksheet = XLSX.utils.aoa_to_sheet(rows);
                var workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, worksheet, "Combine Report");
                
                var fileName = "Combine_Report_" + createDate(frm_dt) + "_to_" + createDate(to_dt) + ".xlsx";
                XLSX.writeFile(workbook, fileName.replace(/\s+/g, '_'));
            } else {
                alert("No Data Found");
            }
        },
        error: function() {
            $("#pageLoader").fadeOut();
            alert("Error generating Excel file.");
        }
    });
}
</script>

<script>
    // Show button on scroll
    window.onscroll = function () {
        const topBtn = document.getElementById("goTopBtn");
        const downBtn = document.getElementById("goDownBtn");
        const leftBtn = document.getElementById("goLeftBtn");
        const rightBtn = document.getElementById("goRightBtn");

        const isDataVisible = document.getElementById("resultDiv") && document.getElementById("resultDiv").style.display !== "none";

        if (document.body.scrollTop > 100 || document.documentElement.scrollTop > 100) {
            if (topBtn) topBtn.style.display = "block";
        } else {
            if (topBtn) topBtn.style.display = "none";
        }

        // Show bottom button only if NOT already at bottom
        if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 100) {
            if (downBtn) downBtn.style.display = "none";
        } else {
            if (downBtn) downBtn.style.display = isDataVisible ? "block" : "none";
        }

        // Show horizontal scroll buttons only if data is visible
        if (leftBtn) leftBtn.style.display = isDataVisible ? "block" : "none";
        if (rightBtn) rightBtn.style.display = isDataVisible ? "block" : "none";
    };

    // Scroll to top
    if (document.getElementById("goTopBtn")) {
        document.getElementById("goTopBtn").onclick = function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        };
    }

    // Scroll to bottom
    if (document.getElementById("goDownBtn")) {
        document.getElementById("goDownBtn").onclick = function () {
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        };
    }

    // Scroll Left
    if (document.getElementById("goLeftBtn")) {
        document.getElementById("goLeftBtn").onclick = function () {
            const tbl = document.querySelector('.table-responsive');
            if (tbl) tbl.scrollBy({ left: -300, behavior: 'smooth' });
            else window.scrollBy({ left: -300, behavior: 'smooth' });
        };
    }

    // Scroll Right
    if (document.getElementById("goRightBtn")) {
        document.getElementById("goRightBtn").onclick = function () {
            const tbl = document.querySelector('.table-responsive');
            if (tbl) tbl.scrollBy({ left: 300, behavior: 'smooth' });
            else window.scrollBy({ left: 300, behavior: 'smooth' });
        };
    }
</script>