<link href="/template/dist/css/operator-page.css" rel="stylesheet">
<style>
    /* ---- Hide default scrollbars ---- */
    body::-webkit-scrollbar,
    .table-responsive::-webkit-scrollbar {
        display: none;
    }
    body, .table-responsive {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
    }
    /* ---- Scroll buttons ---- */
    #goTopBtn, #goDownBtn {
        position: fixed;
        z-index: 999;
        background-color: var(--green-600);
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        display: none;
        box-shadow: 0px 3px 6px rgba(0, 0, 0, 0.3);
    }
    #goTopBtn { bottom: 90px; right: 30px; }
    #goDownBtn { bottom: 30px; right: 30px; }
    #goTopBtn:hover, #goDownBtn:hover {
        background-color: var(--green-700);
    }

    /* ---- Pagination Overrides ---- */
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        color: var(--gray-700) !important;
        background: var(--white) !important;
        border: 1px solid var(--gray-200) !important;
        padding: 2px 8px !important;
        margin: 0 2px !important;
        border-radius: 4px !important;
        cursor: pointer !important;
        font-size: 0.7rem !important;
        display: inline-block !important;
        line-height: 1.1 !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: var(--green-50) !important;
        color: var(--green-600) !important;
        border-color: var(--green-200) !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
        background: var(--green-600) !important;
        color: white !important;
        border-color: var(--green-600) !important;
        font-weight: bold !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
        opacity: 0.5 !important;
        cursor: not-allowed !important;
        background: var(--gray-50) !important;
        color: var(--gray-400) !important;
    }
    .dataTables_wrapper .dataTables_info {
        font-size: 0.85rem !important;
        color: var(--gray-600) !important;
        padding-top: 10px !important;
    }

    /* ---- Page Loader ---- */
    #pageLoader {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(3px);
        display: none;
        z-index: 9999;
    }
    .loader {
        width: 120px; height: 40px;
        margin: 20% auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .circle {
        width: 20px; height: 20px;
        background: var(--green-500);
        border-radius: 50%;
        animation: bounce 0.6s infinite alternate;
    }
    .circle:nth-child(2) { animation-delay: 0.2s; }
    .circle:nth-child(3) { animation-delay: 0.4s; }
    @keyframes bounce {
        to { transform: translateY(-20px); background: var(--green-700); }
    }
    .shadow {
        width: 20px; height: 4px;
        background: #bbb;
        border-radius: 50%;
        filter: blur(2px);
        animation: shadow 0.6s infinite alternate;
    }
    .shadow:nth-child(5) { animation-delay: 0.2s; }
    .shadow:nth-child(6) { animation-delay: 0.4s; }
    @keyframes shadow {
        to { transform: scale(0.7); background: #999; }
    }

    /* ---- Print: hide layout chrome ---- */
    @media print {
        .left-sidebar, .topbar, .page-breadcrumb, .footer, nav,
        #goTopBtn, #goDownBtn, #goLeftBtn, #goRightBtn, .op-filter-sec, .op-header,
        .printBtnDate, .exclbutton, .exclbutton1,
        .dataTables_length, .dataTables_filter,
        .dataTables_paginate, .dataTables_info,
        #btnExcel { display: none !important; }
        .page-wrapper, .container-fluid, .op-page-wrapper,
        .op-card, .card-body, .op-table-wrap {
            padding: 0 !important; margin: 0 !important;
            border: none !important; box-shadow: none !important;
            width: 100% !important;
        }
        .op-table th {
            color: #fff !important;
            background-color: #1c2d41 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        body { margin: 0 !important; padding: 0 !important; text-align: center; }
        .table-responsive { width: 100%; display: flex; justify-content: center; }
        table { border-collapse: collapse; font-size: 10px; width: 90%; margin: 0 auto; }
    }

    /* ---- DataTable toolbar row: Show entries left, Download All right ---- */
    .dt-top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }
    .dataTables_length {
        margin-bottom: 0 !important;
    }
    #btnExcel {
        padding: 8px 18px;
        font-size: 0.82rem;
    }

    /* ---- Search button matches input height ---- */
    #btnSubmit.op-submit-btn {
        width: auto;
        padding: 8px 20px;
        height: auto;
    }
</style>

<div class="op-page-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card op-card">
                    <div class="card-body">

                        <!-- HEADER -->
                        <div class="op-header">
                            <div class="op-title-group">
                                <div class="op-icon-badge">
                                    <i data-feather="file-text"></i>
                                </div>
                                <h3 class="op-page-title">
                                    <%= title %>
                                </h3>
                            </div>
                        </div>

                        <!-- FILTER SECTION -->
                        <div class="op-filter-sec">
                            <div class="row align-items-center">
                                <div class="col-md-3 op-form-group mb-0">
                                    <label class="op-label" for="frm_dt">From Date</label>
                                    <input type="date" id="frm_dt" name="frm_dt" class="op-input" required="">
                                </div>
                                <div class="col-md-3 op-form-group mb-0">
                                    <label class="op-label" for="to_dt">To Date</label>
                                    <input type="date" id="to_dt" name="to_dt" class="op-input" required="">
                                </div>
                                <div class="col-md-3 op-form-group mb-0">
                                    <label class="op-label" for="shift_id">Select Shift</label>
                                    <select name="shift_id" id="shift_id" class="op-input op-select" required="">
                                        <option value="">Select Shift</option>
                                        <% shiftData.msg.forEach(function(item,index) { %>
                                            <option value="<%= item.shift_id %>">
                                                <%= item.shift_name %> (<%= item.f_time %>-<%= item.t_time %>)
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-3 op-form-group mb-0">
                                    <label class="op-label" for="pay_mode">Pay Mode</label>
                                    <select name="pay_mode" class="op-input op-select" id="pay_mode">
                                        <option value="">Select Pay Mode</option>
                                        <option value="C">CASH</option>
                                        <option value="U">UPI</option>
                                        <option value="A">All</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-12 text-center">
                                    <button type="button" class="op-submit-btn" id="btnSubmit">
                                        <i data-feather="search" style="width:15px;height:15px;margin-right:6px;"></i> Search
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- TABLE CONTENT -->
                        <div class="op-table-wrap mt-2 dateWiseDataTable" id="resultDiv" style="display:block !important;">
                            <h4 class="card-title mb-2 mt-2">
                                <center>
                                    <span id="searchCred" style="font-weight:600;color:var(--gray-800);display:inline-block;"></span>
                                </center>
                            </h4>
                            <div class="table-responsive">
                                <table class="table op-table table-bordered" id="cust-datatable">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Operator Name</th>
                                            <th scope="col">MC Srl.No.</th>
                                            <th scope="col">Count</th>
                                            <th scope="col">Base Amount</th>
                                            <th scope="col"> Advance Amount</th>
                                            <th scope="col">CGST</th>
                                            <th scope="col">SGST</th>
                                            <th scope="col">IGST</th>
                                            <th scope="col"> Paid Amount</th>
                                            <th scope="col"> Net Amount</th>
                                            <th scope="col"> Mode</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                    </tbody>

                                    <tfoot>
                                        <tr>
                                            <td scope="col" colspan="3" style="font-weight:700;text-align:center;">Total</td>
                                            <td scope="col" id="tot_cnt" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_base" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_advance" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_cgst" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_sgst" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_igst" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_paid" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="tot_amt" style="font-weight:700;color:var(--green-600);text-align:center;"><b>0</b></td>
                                            <td scope="col" id="mode" style="font-weight:700;text-align:center;"><b></b></td>
                                        </tr>
                                        <tr id="upiRow" style="display: none;">
                                            <td colspan="12" class="text-left" style="font-weight:700;color:var(--green-600);"><b>Total UPI: </b><span id="tot_upi"></span></td>
                                        </tr>
                                        <tr id="cashRow" style="display: none;">
                                            <td colspan="12" class="text-left" style="font-weight:700;color:var(--green-600);"><b>Total Cash: </b><span id="tot_cash"></span></td>
                                        </tr>
                                    </tfoot>
                                </table>

                                <div class="mt-1" style="text-align: left; display: flex; gap: 10px;">
                                    <a href="#" class="op-add-btn printBtnDate" onclick="printDiv()" style="background:linear-gradient(135deg, var(--green-500), white);color:var(--gray-800);box-shadow:none;border:1px solid var(--green-500);text-decoration:none;">
                                        <i data-feather="printer" style="width:15px;height:15px;margin-right:4px;"></i> Print
                                    </a>
                                    <button type="button" id="btnExcel" class="op-add-btn exclbutton" onclick="downloadExcel()">
                                        <i data-feather="file-text" style="width:15px;height:15px;margin-right:4px;"></i> Excel
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<button id="goTopBtn" title="Go to Top"><i data-feather="arrow-up" style="width:20px; height:20px;"></i></button>
<button id="goDownBtn" title="Go to Bottom"><i data-feather="arrow-down" style="width:20px; height:20px;"></i></button>

<div id="pageLoader">
    <div class="loader">
        <div class="circle"></div>
        <div class="circle"></div>
        <div class="circle"></div>
        <div class="shadow"></div>
        <div class="shadow"></div>
        <div class="shadow"></div>
    </div>
</div>

<script src="https://raw.githubusercontent.com/phstc/jquery-dateFormat/master/dist/dateFormat.min.js"></script>
<script>
    $(document).ready(function () {
        $('#resultDiv').hide();
        if (typeof feather !== 'undefined') {
            feather.replace();
        }
        if ($.fn.select2) {
            $('.op-select').select2({ width: '100%' });
        }
    })
</script>
<script>
    $('#btnSubmit').on('click', function () {
        var frm_dt = $('#frm_dt').val()
        var to_dt = $('#to_dt').val()
        var shift_id = $('#shift_id').val()
        var pay_mode = $('#pay_mode').val()

        if (frm_dt != '' && to_dt != '' && shift_id != '' && pay_mode != '') {
            $.ajax({
                method: "POST",
                url: "/report/shift_wise_repo",
                data: { frm_dt, to_dt, shift_id, pay_mode },
                dataType: "html",
                beforeSend: function () {
                    $("#pageLoader").fadeIn();
                },
                success: function (result) {
                    var res = JSON.parse(result);
                    var net_amt_tot = 0;
                    var base_amt_tot = 0;
                    var advance_amt_tot = 0;
                    var cgst_amt_tot = 0;
                    var sgst_amt_tot = 0;
                    var igst_amt_tot = 0;
                    var paid_amt_tot = 0;
                    var cnt_tot = 0;
                    var total_amt_tot = 0;
                    var tot_amt_tot = 0;
                    var tot_upi = 0, tot_cash = 0;
                    $('#tot_upi').text('');
                    $('#tot_cash').text('');
                    $('#resultDiv').show()
                    $('#resultDiv table tbody').empty()
                    // console.log(res)
                    if (res.suc > 0) {
                        if (res.msg.length > 0) {
                            $('#searchCred').text(`Shift Wise Report from ${createDate(frm_dt)} to ${createDate(to_dt)}`)
                            let i = 1;
                            for (let dt of res.msg) {
                                base_amt_tot += Number(dt.base_amt)
                                advance_amt_tot += Number(dt.advance_amt)
                                cgst_amt_tot += Number(dt.cgst)
                                sgst_amt_tot += Number(dt.sgst)
                                igst_amt_tot += Number(dt.igst)
                                paid_amt_tot += Number(dt.paid_amt)
                                total_amt_tot = (Number(dt.paid_amt) + Number(dt.advance_amt))
                                net_amt_tot = (Number(dt.advance_amt) + Number(dt.paid_amt))
                                tot_amt_tot += Number(total_amt_tot)
                                cnt_tot += Number(dt.tot_vehi)

                                if (dt.pay_mode == 'C')
                                    tot_cash += total_amt_tot

                                if (dt.pay_mode == 'U')
                                    tot_upi += total_amt_tot

                                $('#resultDiv table tbody').append(`
                                    <tr>
                                        <td class="textcolor">${i}</td>
                                        <td class="textcolor">${dt.opratorName}</td>
                                        <td class="textcolor">${dt.mc_srl_no_out}</td>
                                        <td class="textcolor">${dt.tot_vehi}</td>
                                        <td class="textcolor">${Number(dt.base_amt) > 0 ? Number(dt.base_amt).toFixed(2) : dt.base_amt}</td>
                                        <td class="textcolor">${Number(dt.advance_amt) > 0 ? Number(dt.advance_amt).toFixed(2) : dt.advance_amt}</td>
                                        <td class="textcolor">${Number(dt.cgst) > 0 ? Number(dt.cgst).toFixed(2) : dt.cgst}</td>
                                        <td class="textcolor">${Number(dt.sgst) > 0 ? Number(dt.sgst).toFixed(2) : dt.sgst}</td>
                                        <td class="textcolor">${Number(dt.igst) > 0 ? Number(dt.igst).toFixed(2) : dt.igst}</td>
                                        <td class="textcolor">${dt.paid_amt}</td>
                                        <td class="textcolor">${net_amt_tot}</td>
                                        <td class="textcolor">${dt.pay_mode == 'U' ? 'UPI' : dt.pay_mode == 'C' ? 'CASH' : ''}</td>
                                    </tr>
                                    `)
                                i++
                            }
                            $('#tot_base').text(Number(base_amt_tot) > 0 ? Number(base_amt_tot).toFixed(2) : base_amt_tot)
                            $('#tot_advance').text(Number(advance_amt_tot) > 0 ? Number(advance_amt_tot).toFixed(2) : advance_amt_tot)
                            $('#tot_cgst').text(Number(cgst_amt_tot) > 0 ? Number(cgst_amt_tot).toFixed(2) : cgst_amt_tot)
                            $('#tot_sgst').text(Number(sgst_amt_tot) > 0 ? Number(sgst_amt_tot).toFixed(2) : sgst_amt_tot)
                            $('#tot_igst').text(Number(igst_amt_tot) > 0 ? Number(igst_amt_tot).toFixed(2) : igst_amt_tot)
                            $('#tot_paid').text(paid_amt_tot)
                            $('#tot_amt').text(tot_amt_tot)
                            $('#tot_cnt').text(cnt_tot)

                            if (pay_mode == 'A') {
                                $('#upiRow').show()
                                $('#cashRow').show()
                                $('#tot_upi').text(tot_upi)
                                $('#tot_cash').text(tot_cash)
                            } else {
                                $('#upiRow').hide()
                                $('#cashRow').hide()
                                $('#tot_upi').text('')
                                $('#tot_cash').text('')
                            }
                        } else {
                            $('#resultDiv table tbody').append('<tr><td colspan="12" class="text-center text-danger" style="font-weight:600;">No Data Found</td></tr>')
                            $('#tot_base').text(Number(base_amt_tot) > 0 ? Number(base_amt_tot).toFixed(2) : base_amt_tot)
                            $('#tot_advance').text(Number(advance_amt_tot) > 0 ? Number(advance_amt_tot).toFixed(2) : advance_amt_tot)
                            $('#tot_cgst').text(Number(cgst_amt_tot) > 0 ? Number(cgst_amt_tot).toFixed(2) : cgst_amt_tot)
                            $('#tot_sgst').text(Number(sgst_amt_tot) > 0 ? Number(sgst_amt_tot).toFixed(2) : sgst_amt_tot)
                            $('#tot_igst').text(Number(igst_amt_tot) > 0 ? Number(igst_amt_tot).toFixed(2) : igst_amt_tot)
                            $('#tot_paid').text(paid_amt_tot)
                            $('#tot_amt').text(tot_amt_tot)
                            $('#tot_cnt').text(cnt_tot)
                        }
                    }
                },
                complete: function () {
                    $("#pageLoader").fadeOut();
                    if (typeof feather !== 'undefined') {
                        feather.replace();
                    }
                    if (typeof updateHorizontalScrollButtons === 'function') {
                        updateHorizontalScrollButtons();
                    }
                }
            })
        }
    })
</script>

<script>
    function printDiv() {
        var divToPrint = document.getElementById('resultDiv');

        var WindowObject = window.open('', 'Print-Window');
        WindowObject.document.open();
        WindowObject.document.writeln('<!DOCTYPE html>');
        WindowObject.document.writeln('<html><head><title></title>');
        WindowObject.document.writeln('<style type="text/css">');

        WindowObject.document.writeln(`
            @media print {
                .center { text-align: center; }
                .inline { display: inline; }
                .underline { text-decoration: underline; }
                .left { margin-left: 315px; }
                .right { margin-right: 375px; display: inline; }
                body { text-align: center; }
                .table-responsive { width: 100%; display: flex; justify-content: center; }
                table { border-collapse: collapse; font-size: 10px; width: 90%; margin: 0 auto; }
                th, td { 
                    border: 1px solid black;
                    padding: 6px;
                    font-family: Arial, Helvetica, sans-serif;
                    text-align: center;
                }
                .table .thead-dark th, .op-table th {
                    color: #fff !important;
                    background-color: #1c2d41 !important;
                    -webkit-print-color-adjust: exact;
                    print-color-adjust: exact;
                }
                tfoot { font-weight: 700; color: #000; }
                .printBtnDate, .exclbutton, .exclbutton1, #btnExcel { display: none !important; }
                .border { border: 1px solid black; }
                .bottom { bottom: 5px; width: 100%; position: fixed; }
                
                .dataTables_length,
                .dataTables_filter,
                .dataTables_info,
                .dataTables_paginate,
                .paging_simple_numbers,
                .pagination,
                .dt-buttons {
                    display: none !important;
                }
            }
        `);

        WindowObject.document.writeln('</style>');
        WindowObject.document.writeln('</head><body onload="window.print()">');
        WindowObject.document.writeln(divToPrint.innerHTML);
        WindowObject.document.writeln('</body></html>');
        WindowObject.document.close();

        setTimeout(function () {
            WindowObject.close();
        }, 1);
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

<script>
    function downloadExcel() {
        // Get the table element
        var table = document.querySelector("#cust-datatable");

        if (!table) {
            alert("No data available to export!");
            return;
        }

        // Convert table to worksheet
        var workbook = XLSX.utils.book_new();
        var rows = [];

        // STEP 1: Read table rows normally (NO QUOTES)
        table.querySelectorAll("tr").forEach(tr => {
            let row = [];
            tr.querySelectorAll("th, td").forEach((cell) => {
                row.push(cell.innerText.trim());
            });
            rows.push(row);
        });

        // STEP 2: Convert to sheet
        var worksheet = XLSX.utils.aoa_to_sheet(rows);

        // STEP 3: Force specific columns to TEXT format (NO auto conversion)
        Object.keys(worksheet).forEach(key => {
            if (key.startsWith("!")) return; // skip metadata

            let cell = worksheet[key];
            if (!cell || !cell.v) return;

            let col = key.replace(/[0-9]/g, ""); // get column letter(s)

            // Receipt No. → column B
            if (col === "B") {
                cell.t = "s";        // force as text
            }

            // DateTime In → column C
            if (col === "C") {
                cell.t = "s";        // force as text
            }

            // DateTime Out → column G
            if (col === "G") {
                cell.t = "s";
            }
        });

        XLSX.utils.book_append_sheet(workbook, worksheet, "Shift Wise Report");

        // Download Excel file
        XLSX.writeFile(workbook, "Shift_Wise_Report.xlsx");
    }
</script>

<script>
    function updateHorizontalScrollButtons() {
        const topBtn = document.getElementById("goTopBtn");
        const downBtn = document.getElementById("goDownBtn");
        const isDataVisible = document.getElementById("resultDiv") && document.getElementById("resultDiv").style.display !== "none";

        if (topBtn) topBtn.style.display = isDataVisible ? "block" : "none";
        if (downBtn) downBtn.style.display = isDataVisible ? "block" : "none";
    }

    // Bind events for horizontal scrolling
    window.addEventListener('resize', updateHorizontalScrollButtons);

    // Show button on scroll
    window.onscroll = function () {
        updateHorizontalScrollButtons();
    };

    // Scroll to top
    document.getElementById("goTopBtn").onclick = function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Scroll to bottom
    document.getElementById("goDownBtn").onclick = function () {
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    };
</script>