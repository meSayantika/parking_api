<link href="/template/dist/css/operator-page.css" rel="stylesheet">

<style>
    #goTopBtn,
    #goDownBtn {
        position: fixed;
        right: 30px;
        z-index: 999;
        background-color: var(--green-600);
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        display: none;
        box-shadow: 0px 3px 6px rgba(0, 0, 0, 0.3);
    }

    #goTopBtn {
        bottom: 90px;
    }

    #goDownBtn {
        bottom: 30px;
    }

    #goTopBtn:hover,
    #goDownBtn:hover {
        background-color: var(--green-700);
    }

    /* Pagination Overrides */
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        color: var(--gray-700) !important;
        background: var(--white) !important;
        border: 1px solid var(--gray-200) !important;
        padding: 2px 8px !important;
        margin: 0 2px !important;
        border-radius: 4px !important;
        cursor: pointer !important;
        font-size: 0.7rem !important;
        display: inline-block !important;
        line-height: 1.1 !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: var(--green-50) !important;
        color: var(--green-600) !important;
        border-color: var(--green-200) !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
        background: var(--green-600) !important;
        color: white !important;
        border-color: var(--green-600) !important;
        font-weight: bold !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled,
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled:hover {
        opacity: 0.5 !important;
        cursor: not-allowed !important;
        background: var(--gray-50) !important;
        color: var(--gray-400) !important;
    }

    .dataTables_wrapper .dataTables_info {
        font-size: 0.85rem !important;
        color: var(--gray-600) !important;
        padding-top: 10px !important;
    }



    /* ---- Print: hide everything except the report table ---- */
    @media print {
        /* Hide layout chrome */
        .left-sidebar,
        .topbar,
        .page-breadcrumb,
        .footer,
        nav,
        #goTopBtn,
        #goDownBtn,
        .op-filter-sec,
        .op-header,
        .printBtnDate,
        .exclbutton,
        .dataTables_length,
        .dataTables_filter,
        .dataTables_paginate,
        .dataTables_info {
            display: none !important;
        }

        /* Expand content to full width */
        .page-wrapper,
        .container-fluid,
        .op-page-wrapper,
        .op-card,
        .card-body,
        .op-table-wrap {
            padding: 0 !important;
            margin: 0 !important;
            border: none !important;
            box-shadow: none !important;
            width: 100% !important;
        }

        /* Table print styles */
        .op-table th {
            color: #fff !important;
            background-color: #1c2d41 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        body {
            margin: 0 !important;
            padding: 0 !important;
        }
    }
</style>

<div class="op-page-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card op-card">
                    <div class="card-body">

                        <!-- HEADER -->
                        <div class="op-header">
                            <div class="op-title-group">
                                <div class="op-icon-badge">
                                    <i data-feather="file-text"></i>
                                </div>
                                <h3 class="op-page-title">
                                    <%= title %>
                                </h3>
                            </div>
                        </div>

                        <!-- FILTER SECTION -->
                        <div class="op-filter-sec">
                            <div class="row align-items-end">
                                <div class="col-md-4 op-form-group mb-0">
                                    <label class="op-label" for="frm_dt">From Date</label>
                                    <input type="datetime-local" id="frm_dt" name="frm_dt" class="op-input" required="">
                                </div>
                                <div class="col-md-4 op-form-group mb-0">
                                    <label class="op-label" for="to_dt">To Date</label>
                                    <input type="datetime-local" id="to_dt" name="to_dt" class="op-input" required="">
                                </div>
                                <div class="col-md-4">
                                    <div style="white-space: nowrap; margin-top: 25px; display: flex; gap: 10px;">
                                        <button type="button" class="op-submit-btn" id="btnSubmit">
                                            <i data-feather="search"
                                                style="width:15px;height:15px;margin-right:6px;"></i> Search
                                        </button>
                                        <!-- <button type="button" class="op-submit-btn" id="btnScrollDown"
                                            title="Go to Results" style="display: none; padding: 11px 15px;"
                                            onclick="document.getElementById('resultDiv').scrollIntoView({behavior: 'smooth', block: 'start'})">
                                            <i data-feather="arrow-down" style="width:16px;height:16px;margin:0;"></i>
                                        </button> -->
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TABLE CONTENT -->
                        <div class="op-table-wrap mt-3 dateWiseDataTable" id="resultDiv">
                            <h4 class="card-title mb-4 mt-4">
                                <center>
                                    <span id="searchCred"
                                        style="font-weight: 600; color: var(--gray-800); margin-top: 15px; display: inline-block;"></span>
                                </center>
                            </h4>
                            <div class="table-responsive">
                                <table class="table op-table table-bordered" id="cust-datatable">
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Receipt No.</th>
                                            <th scope="col">Date Time In</th>
                                            <th scope="col">Machine Sl. No. In</th>
                                            <th scope="col">Vehicle Type</th>
                                            <th scope="col">Vehicle No.</th>
                                            <th scope="col" class="text-center">Advance Amount</th>
                                            <th scope="col">Operator Name</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                    </tbody>

                                    <tfoot>
                                        <tr>
                                            <td scope="col" colspan="6" style="font-weight:700; text-align:center;">Total
                                            </td>
                                            <td scope="col" id="tot_amt" class="text-center"
                                                style="font-weight:700; color:var(--green-600);"><b>0</b></td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>

                                <div class="mt-4" style="text-align: left;">
                                    <button class="op-add-btn printBtnDate" onclick="printDiv()" style="background:linear-gradient(135deg, var(--green-500), white);color:var(--gray-800);box-shadow:none;border:1px solid var(--green-500);">
                                        <i data-feather="printer" style="width:15px;height:15px;margin-right:4px;"></i>
                                        Print
                                    </button>
                                    <button class="op-add-btn exclbutton" onclick="downloadExcel()"
                                        style="margin-left: 10px;">
                                        <i data-feather="file-text"
                                            style="width:15px;height:15px;margin-right:4px;"></i> Excel
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
</div>

<button id="goTopBtn" title="Go to Top">
    <i class="fa fa-arrow-up"></i>
</button>
<button id="goDownBtn" title="Go to Bottom">
    <i class="fa fa-arrow-down"></i>
</button>

<script>
    $(document).ready(function () {
        $('#resultDiv').hide()
    })
</script>
<script>
    $('#btnSubmit').on('click', function () {
        var frm_dt = $('#frm_dt').val()
        var to_dt = $('#to_dt').val()

        if (frm_dt != '' && to_dt != '') {
            $.ajax({
                method: "POST",
                url: "/report/get_unbilled_report",
                data: { frm_dt, to_dt },
                dataType: "html",
                beforeSend: function () {
                    $(".preloader").fadeIn();
                },
                success: function (result) {
                    var res = JSON.parse(result);
                    var adv_amt_tot = 0;

                    if ($.fn.DataTable.isDataTable('#cust-datatable')) {
                        $('#cust-datatable').DataTable().clear().destroy();
                    }

                    $('#resultDiv').show()
                    $('#resultDiv table tbody').empty()
                    $('#searchCred').text('')

                    if (res.suc > 0 && res.msg.length > 0) {
                        // --- Has Data ---
                        $('#goTopBtn, #goDownBtn').show()
                        $('#searchCred').text(`Unbilled Report from ${createDate(frm_dt)} to ${createDate(to_dt)}`)
                        let i = 1;
                        for (let dt of res.msg) {
                            adv_amt_tot += Number(dt.advance_amt)
                            $('#resultDiv table tbody').append(`
                                <tr>
                                    <td class="textcolor">${i}</td>
                                    <td class="textcolor">${dt.receipt_no}</td>
                                    <td class="textcolor">${createDateTime(dt.date_time_in)}</td>
                                    <td class="textcolor">${dt.device_id}</td>
                                    <td class="textcolor">${dt.vehicle_name}</td>
                                    <td class="textcolor">${dt.vehicle_no}</td>
                                    <td class="textcolor text-center">${dt.advance_amt}</td>
                                    <td class="textcolor">${dt.operator_name}</td>
                                </tr>
                            `)
                            i++
                        }
                        $('#tot_amt').text(adv_amt_tot)

                        // Initialize DataTable for pagination
                        $('#cust-datatable').DataTable({
                            pageLength: 10,
                            responsive: true,
                            ordering: false,
                            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                            language: {
                                search: "Filter records:",
                                lengthMenu: "Show _MENU_ entries"
                            },
                            drawCallback: function () {
                                // Update footer total to show only current visible page sum
                                var visibleTotal = 0;
                                $('#cust-datatable tbody tr').filter(':visible').each(function () {
                                    var val = parseFloat($(this).find('td').eq(6).text()) || 0;
                                    visibleTotal += val;
                                });
                                $('#tot_amt').text(visibleTotal);
                            }
                        });

                        setTimeout(function () {
                            if (typeof toggleScrollButtons === 'function') toggleScrollButtons();
                        }, 100);

                    } else {
                        // --- No Data ---
                        $('#goTopBtn, #goDownBtn').hide()
                        $('#tot_amt').text(0)
                        $('#resultDiv table tbody').append(`
                            <tr>
                                <td colspan="8" style="padding: 40px 20px; text-align: center; border: none;">
                                    <div style="
                                        display: inline-flex;
                                        flex-direction: column;
                                        align-items: center;
                                        gap: 12px;
                                        background: #f9fafb;
                                        border: 1.5px dashed #d1d5db;
                                        border-radius: 12px;
                                        padding: 32px 48px;
                                        color: #6b7280;
                                    ">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"
                                            fill="none" stroke="#9ca3af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="11" cy="11" r="8"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            <line x1="11" y1="8" x2="11" y2="14"></line>
                                            <line x1="8" y1="11" x2="14" y2="11"></line>
                                        </svg>
                                        <span style="font-size: 1rem; font-weight: 600; color: #374151;">No Data Found</span>
                                        <span style="font-size: 0.82rem; color: #9ca3af;">No unbilled records found for the selected date range.</span>
                                    </div>
                                </td>
                            </tr>
                        `)
                    }
                },
                complete: function () {
                    $(".preloader").fadeOut();
                }
            })
        }
    })
</script>

<script>
    function printDiv() {
        // Collect visible rows only (current page)
        var title = $('#searchCred').text() || 'Unbilled Report';
        var headers = [];
        $('#cust-datatable thead th').each(function () {
            headers.push('<th>' + $(this).text() + '</th>');
        });

        var rowsHtml = '';
        $('#cust-datatable tbody tr:visible').each(function () {
            rowsHtml += '<tr>';
            $(this).find('td').each(function () {
                rowsHtml += '<td>' + $(this).text() + '</td>';
            });
            rowsHtml += '</tr>';
        });

        // Page total
        var pageTotal = parseFloat($('#tot_amt').text()) || 0;

        var printContent = `<!DOCTYPE html>
<html>
<head>
<title>Unbilled Report</title>
<style>
    body { font-family: Arial, Helvetica, sans-serif; margin: 20px; font-size: 12px; }
    h3 { text-align: center; margin-bottom: 16px; font-size: 14px; color: #1c2d41; }
    table { width: 100%; border-collapse: collapse; font-size: 11px; }
    th { background-color: #1c2d41; color: #fff; padding: 7px 10px; text-align: center; border: 1px solid #1c2d41; }
    td { padding: 6px 10px; border: 1px solid #ccc; text-align: center; }
    tfoot td { font-weight: 700; background: #f3f4f6; color: #059669; }
    @media print {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
</style>
</head>
<body onload="window.print()">
<h3>${title}</h3>
<table>
    <thead><tr>${headers.join('')}</tr></thead>
    <tbody>${rowsHtml}</tbody>
    <tfoot>
        <tr>
            <td colspan="6" style="text-align:center; font-weight:700;">Total (This Page)</td>
            <td style="text-align:center; font-weight:700; color:#059669;">${pageTotal}</td>
            <td></td>
        </tr>
    </tfoot>
</table>
</body>
</html>`;

        var WindowObject = window.open('', 'Print-Window', 'width=900,height=650');
        WindowObject.document.open();
        WindowObject.document.write(printContent);
        WindowObject.document.close();
        setTimeout(function () { WindowObject.close(); }, 500);
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>

<script>
    function downloadExcel() {
        var workbook = XLSX.utils.book_new();
        var rows = [];

        // STEP 1: Read thead headers
        var headers = [];
        $('#cust-datatable thead th').each(function () {
            headers.push($(this).text().trim());
        });
        rows.push(headers);

        // STEP 2: Read only visible (current page) tbody rows
        var pageTotal = 0;
        $('#cust-datatable tbody tr:visible').each(function () {
            var row = [];
            $(this).find('td').each(function (colIdx) {
                var val = $(this).text().trim();
                // Advance Amount is column index 6
                if (colIdx === 6) {
                    pageTotal += parseFloat(val) || 0;
                }
                row.push(val);
            });
            rows.push(row);
        });

        // STEP 3: Add page total row
        var totalRow = ['', '', '', '', '', 'Total (This Page)', pageTotal, ''];
        rows.push(totalRow);

        // STEP 4: Convert to sheet
        var worksheet = XLSX.utils.aoa_to_sheet(rows);

        // STEP 5: Force text format for Receipt No (B), DateTime In (C), Advance (G)
        Object.keys(worksheet).forEach(function (key) {
            if (key.startsWith("!")) return;
            var cell = worksheet[key];
            if (!cell || !cell.v) return;
            var col = key.replace(/[0-9]/g, "");
            if (col === "B" || col === "C") {
                cell.t = "s";
            }
        });

        XLSX.utils.book_append_sheet(workbook, worksheet, "Unbilled Report");
        XLSX.writeFile(workbook, "Unbilled_Report.xlsx");
    }
</script>

<script>
    // Scroll to top
    document.getElementById("goTopBtn").onclick = function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Scroll to bottom
    document.getElementById("goDownBtn").onclick = function () {
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    };
</script>