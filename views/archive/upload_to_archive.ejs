<link href="/template/dist/css/operator-page.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .archive-type-card {
        background: #ffffff;
        border: 2px solid var(--gray-200, #e2e8f0);
        border-radius: 12px;
        padding: 14px 20px;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        gap: 12px;
        user-select: none;
    }

    .archive-type-card:hover {
        border-color: var(--green-500, #10b981);
        background: var(--green-50, #f0fdf4);
    }

    .archive-type-card.active {
        border-color: var(--green-600, #059669);
        background: var(--green-50, #ecfdf5);
        box-shadow: 0 4px 12px rgba(5, 150, 105, 0.15);
    }

    .archive-type-card input[type="radio"] {
        accent-color: var(--green-600, #059669);
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .archive-type-title {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--gray-800, #1e293b);
        margin: 0;
    }

    .archive-type-card.active .archive-type-title {
        color: var(--green-800, #065f46);
    }

    .archive-type-desc {
        font-size: 0.75rem;
        color: var(--gray-500, #64748b);
        margin: 0;
    }

    .archive-badge-info {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 600;
        background: var(--green-100, #d1fae5);
        color: var(--green-800, #065f46);
        border: 1px solid var(--green-300, #6ee7b7);
    }

    .select-count-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: 16px;
        font-size: 0.8rem;
        font-weight: 700;
        background: #1e293b;
        color: #ffffff;
        margin-left: 10px;
    }

    .row-checkbox, #selectAllCheckbox {
        cursor: pointer;
        width: 17px;
        height: 17px;
        accent-color: var(--green-600, #059669);
    }

    .op-submit-btn:disabled,
    .op-submit-btn[disabled] {
        opacity: 0.55 !important;
        cursor: not-allowed !important;
        background: #94a3b8 !important;
        border-color: #94a3b8 !important;
        box-shadow: none !important;
        transform: none !important;
        pointer-events: auto !important;
    }

    /* Custom Pagination Styling */
    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 18px;
        padding: 12px 16px;
        background: #f8fafc;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
    }

    .pagination-info {
        font-size: 0.88rem;
        color: var(--gray-600, #475569);
        font-weight: 500;
    }

    .pagination-controls {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .pagination-btn {
        padding: 6px 12px;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }

    .pagination-btn:hover:not(.disabled) {
        background: var(--green-50, #ecfdf5);
        border-color: var(--green-500, #10b981);
        color: var(--green-700, #047857);
    }

    .pagination-btn.active {
        background: var(--green-600, #059669);
        border-color: var(--green-600, #059669);
        color: #ffffff;
    }

    .pagination-btn.disabled {
        opacity: 0.5;
        cursor: not-allowed;
        background: #f1f5f9;
    }

    .page-size-select {
        height: 36px;
        padding: 4px 10px;
        border-radius: 6px;
        border: 1px solid #cbd5e1;
        font-size: 0.85rem;
        color: #334155;
        background-color: #fff;
        outline: none;
    }

    #goTopBtn,
    #goDownBtn {
        position: fixed;
        right: 30px;
        z-index: 999;
        background-color: var(--green-600, #059669);
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        display: none;
        box-shadow: 0px 3px 6px rgba(0, 0, 0, 0.3);
    }

    #goTopBtn { bottom: 90px; }
    #goDownBtn { bottom: 30px; }
    #goTopBtn:hover, #goDownBtn:hover { background-color: var(--green-700, #047857); }
</style>

<div class="op-page-wrapper">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card op-card">
                    <div class="card-body">

                        <!-- HEADER -->
                        <div class="op-header">
                            <div class="op-title-group">
                                <div class="op-icon-badge">
                                    <i data-feather="archive"></i>
                                </div>
                                <h3 class="op-page-title">
                                    <%= title %>
                                </h3>
                            </div>
                            <div>
                                <span class="archive-badge-info" id="statusBadge">
                                    <i data-feather="info" style="width:14px;height:14px;margin-right:6px;"></i>
                                    <span id="statusBadgeText">Unbilled Mode: Ready to process unbilled records</span>
                                </span>
                            </div>
                        </div>

                        <!-- FILTER & OPTION SECTION -->
                        <div class="op-filter-sec">
                            <!-- 1. Selection Options: Unbilled vs Billed -->
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="op-label mb-2" style="font-size: 0.9rem; font-weight: 700; color: var(--gray-700);">Select Record Type to Archive:</label>
                                </div>
                                <div class="col-md-4 col-sm-6 mb-2">
                                    <label class="archive-type-card active w-100" id="cardUnbilled">
                                        <input type="radio" name="archive_type" id="typeUnbilled" value="unbilled" checked>
                                        <div>
                                            <p class="archive-type-title">Unbilled Records</p>
                                            <p class="archive-type-desc">No date range required</p>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-md-4 col-sm-6 mb-2">
                                    <label class="archive-type-card w-100" id="cardBilled">
                                        <input type="radio" name="archive_type" id="typeBilled" value="billed">
                                        <div>
                                            <p class="archive-type-title">Billed Records</p>
                                            <p class="archive-type-desc">Select From & To Date (Prior months)</p>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- 2. Unbilled Mode Action Button (Below cards when Unbilled is selected) -->
                            <div class="row mt-2" id="unbilledActionRow">
                                <div class="col-12 d-flex flex-wrap align-items-center" style="gap: 12px;">
                                    <button type="button" class="op-submit-btn btn-fetch" id="btnFetchUnbilled">
                                        <i data-feather="search" style="width:15px;height:15px;margin-right:6px;"></i> Fetch Records
                                    </button>
                                    <button type="button" class="op-add-btn btn-upload-archive" style="background: linear-gradient(135deg, #059669, #047857); display: none;">
                                        <i data-feather="upload-cloud" style="width:15px;height:15px;margin-right:6px;"></i> Upload to Archive
                                    </button>
                                </div>
                            </div>

                            <!-- 3. Billed Mode: Date Filter & Action Button on the SAME ROW -->
                            <div class="row align-items-end" id="dateFilterSection" style="display: none;">
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 op-form-group mb-0">
                                    <label class="op-label" for="frm_dt">From Date <span class="text-danger">*</span> <small class="text-muted" style="font-weight:500; font-size:0.75rem;">(Past months only)</small></label>
                                    <input type="datetime-local" id="frm_dt" name="frm_dt" class="op-input">
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 op-form-group mb-0">
                                    <label class="op-label" for="to_dt">To Date <span class="text-danger">*</span> <small class="text-muted" style="font-weight:500; font-size:0.75rem;">(Past months only)</small></label>
                                    <input type="datetime-local" id="to_dt" name="to_dt" class="op-input">
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-6 col-12">
                                    <div class="d-flex align-items-center flex-wrap" style="white-space: nowrap; margin-top: 25px; gap: 10px;">
                                        <button type="button" class="op-submit-btn btn-fetch" id="btnFetchBilled" style="padding: 10px 22px; white-space: nowrap;" disabled>
                                            <i data-feather="search" style="width:15px;height:15px;margin-right:6px;"></i> Fetch Records
                                        </button>
                                        <button type="button" class="op-add-btn btn-upload-archive" style="background: linear-gradient(135deg, #059669, #047857); padding: 10px 22px; white-space: nowrap; display: none;">
                                            <i data-feather="upload-cloud" style="width:15px;height:15px;margin-right:6px;"></i> Upload to Archive
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- TABLE CONTENT -->
                        <div class="op-table-wrap mt-4 dateWiseDataTable" id="resultDiv" style="padding-top: 10px;">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3 pb-2" id="tableHeaderInfo">
                                <div>
                                    <span id="searchCred" style="font-weight: 700; color: var(--gray-800); font-size: 0.95rem;"></span>
                                </div>
                                <div class="d-flex align-items-center" style="gap: 10px;">
                                    <div style="position: relative;">
                                        <input type="text" id="tableSearchInput" class="op-input" placeholder="Search Receipt / Machine / Vehicle..." style="padding-left: 36px; padding-right: 12px; height: 38px; width: 300px; font-size: 0.85rem; border-radius: 8px; border: 1px solid #cbd5e1;">
                                        <i data-feather="search" style="position: absolute; left: 11px; top: 11px; width: 16px; height: 16px; color: #94a3b8;"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table op-table table-bordered" id="cust-datatable">
                                    <thead>
                                        <tr>
                                            <th scope="col" class="text-center" style="width: 40px;">
                                                <input type="checkbox" id="selectAllCheckbox" title="Select / Deselect All Records Across All Pages">
                                            </th>
                                            <th scope="col">#</th>
                                            <th scope="col">Receipt No.</th>
                                            <th scope="col">Date Time In</th>
                                            <th scope="col">Machine Sl. No. In</th>
                                            <th scope="col">Vehicle Type</th>
                                            <th scope="col">Vehicle No.</th>
                                            <th scope="col" class="text-center">Advance Amount</th>
                                            <th scope="col">Operator Name</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tableBody">
                                        <!-- Dynamic Data Rows -->
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td scope="col" colspan="7" style="font-weight:700; text-align:center;">Total</td>
                                            <td scope="col" id="tot_amt" class="text-center" style="font-weight:700; color:var(--green-600);"><b>0.00</b></td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <!-- PAGINATION CONTROLS -->
                            <div class="pagination-container" id="paginationContainer" style="display: none;">
                                <div class="d-flex align-items-center flex-wrap" style="gap: 15px;">
                                    <div class="pagination-info" id="paginationInfo">Showing 0 to 0 of 0 entries</div>
                                    <div class="d-flex align-items-center" style="gap: 8px;">
                                        <label class="mb-0 text-muted" style="font-size:0.85rem; font-weight:600;">Show:</label>
                                        <select class="page-size-select" id="pageSizeSelect">
                                            <option value="25">25 per page</option>
                                            <option value="50">50 per page</option>
                                            <option value="100">100 per page</option>
                                            <option value="All">All records</option>
                                        </select>
                                    </div>
                                </div>
                                <ul class="pagination-controls" id="paginationButtons">
                                    <!-- Dynamic Pagination Buttons -->
                                </ul>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<button id="goTopBtn" title="Go to Top"><i class="fa fa-arrow-up"></i></button>
<button id="goDownBtn" title="Go to Bottom"><i class="fa fa-arrow-down"></i></button>

<script>
    var allFetchedRecords = [];
    var selectedReceipts = new Set();
    var currentPage = 1;
    var pageSize = 25;
    var searchQuery = '';

    // Calculate maximum allowed datetime (last minute of previous month)
    function getPreviousMonthEndMax() {
        var now = new Date();
        var lastDayOfPrevMonth = new Date(now.getFullYear(), now.getMonth(), 0, 23, 59);
        var pad = function (n) { return (n < 10 ? '0' : '') + n; };
        var yyyy = lastDayOfPrevMonth.getFullYear();
        var mm = pad(lastDayOfPrevMonth.getMonth() + 1);
        var dd = pad(lastDayOfPrevMonth.getDate());
        var hh = pad(lastDayOfPrevMonth.getHours());
        var min = pad(lastDayOfPrevMonth.getMinutes());
        return yyyy + '-' + mm + '-' + dd + 'T' + hh + ':' + min;
    }

    // Validate From and To Date for Billed mode
    function validateBilledDates() {
        var frmVal = $('#frm_dt').val();
        var toVal = $('#to_dt').val();
        var now = new Date();
        var startOfCurrentMonth = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0, 0);

        var isFrmValid = false;
        var isToValid = false;

        if (frmVal) {
            var frmDate = new Date(frmVal);
            if (frmDate >= startOfCurrentMonth) {
                $('#frm_dt').val('');
                frmVal = '';
                if (window.Swal) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Current Month Not Allowed',
                        text: 'Archiving records from the current month is not permitted. Please select dates up to the previous month.',
                        confirmButtonColor: '#059669'
                    });
                } else {
                    alert('Archiving records from the current month is not permitted. Please select dates up to the previous month.');
                }
            } else {
                isFrmValid = true;
                $('#to_dt').attr('min', frmVal);
            }
        } else {
            $('#to_dt').removeAttr('min');
        }

        if (toVal) {
            var toDate = new Date(toVal);
            if (toDate >= startOfCurrentMonth) {
                $('#to_dt').val('');
                toVal = '';
                if (window.Swal) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Current Month Not Allowed',
                        text: 'Archiving records from the current month is not permitted. Please select dates up to the previous month.',
                        confirmButtonColor: '#059669'
                    });
                } else {
                    alert('Archiving records from the current month is not permitted. Please select dates up to the previous month.');
                }
            } else if (frmVal && new Date(toVal) < new Date(frmVal)) {
                $('#to_dt').val('');
                toVal = '';
                if (window.Swal) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Invalid Date Range',
                        text: 'To Date cannot be earlier than From Date.',
                        confirmButtonColor: '#059669'
                    });
                } else {
                    alert('To Date cannot be earlier than From Date.');
                }
            } else {
                isToValid = true;
            }
        }

        if (isFrmValid && isToValid) {
            $('#btnFetchBilled').prop('disabled', false);
        } else {
            $('#btnFetchBilled').prop('disabled', true);
        }
    }

    $(document).ready(function () {
        $('#resultDiv').hide();
        if (window.feather) { feather.replace(); }

        // Set max datetime constraint on From and To Date (disallowing current month dates)
        var maxAllowedDateTime = getPreviousMonthEndMax();
        $('#frm_dt').attr('max', maxAllowedDateTime);
        $('#to_dt').attr('max', maxAllowedDateTime);

        // Listen for date input/change to validate and toggle Fetch Records button
        $(document).on('change input blur', '#frm_dt, #to_dt', function () {
            validateBilledDates();
        });

        // Live Search Input (Filters by Receipt No, Machine No, Vehicle No, etc.)
        $(document).on('input', '#tableSearchInput', function () {
            searchQuery = $(this).val();
            currentPage = 1;
            renderTableRows();
        });

        // Toggle Unbilled vs Billed options
        $('input[name="archive_type"]').on('change', function () {
            var selected = $(this).val();
            if (selected === 'unbilled') {
                $('#cardUnbilled').addClass('active');
                $('#cardBilled').removeClass('active');
                $('#dateFilterSection').slideUp(200);
                $('#unbilledActionRow').slideDown(200);
                $('#statusBadgeText').text('Unbilled Mode: Ready to process unbilled records (No date required)');
                $('#frm_dt, #to_dt').removeAttr('required');
            } else {
                $('#cardBilled').addClass('active');
                $('#cardUnbilled').removeClass('active');
                $('#unbilledActionRow').slideUp(200);
                $('#dateFilterSection').slideDown(200);
                $('#statusBadgeText').text('Billed Mode: Select From Date & To Date (up to previous month) to enable Fetch Records');
                $('#frm_dt, #to_dt').attr('required', 'required');
                validateBilledDates();
            }
            $('#resultDiv').hide();
            $('.btn-upload-archive').hide();
            $('#goTopBtn, #goDownBtn').hide();
        });

        // Submit Search / Fetch on either button
        $(document).on('click', '.btn-fetch', function () {
            if ($(this).is(':disabled')) {
                return;
            }
            var archiveType = $('input[name="archive_type"]:checked').val();
            var frm_dt = $('#frm_dt').val();
            var to_dt = $('#to_dt').val();

            if (archiveType === 'billed') {
                if (!frm_dt || !to_dt) {
                    if (window.Swal) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Date Range Required',
                            text: 'Please select both From Date and To Date for Billed records.',
                            confirmButtonColor: '#059669'
                        });
                    } else {
                        alert('Please select both From Date and To Date for Billed records.');
                    }
                    return;
                }

                var now = new Date();
                var startOfCurrentMonth = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0, 0);
                if (new Date(frm_dt) >= startOfCurrentMonth || new Date(to_dt) >= startOfCurrentMonth) {
                    if (window.Swal) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Current Month Not Allowed',
                            text: 'Archiving records from the current month is not permitted. Please select dates up to the previous month.',
                            confirmButtonColor: '#059669'
                        });
                    } else {
                        alert('Archiving records from the current month is not permitted. Please select dates up to the previous month.');
                    }
                    return;
                }
            }

            $.ajax({
                method: "POST",
                url: archiveType === 'unbilled' ? "/archive/get_unbilled_archive" : "/archive/get_billed_archive",
                data: archiveType === 'unbilled' ? {} : { frm_dt: frm_dt, to_dt: to_dt },
                dataType: "json",
                beforeSend: function () {
                    if ($(".preloader").length) { $(".preloader").fadeIn(); }
                },
                success: function (res) {
                    if ($(".preloader").length) { $(".preloader").fadeOut(); }
                    allFetchedRecords = res.msg || res.data || [];
                    
                    // Checkboxes start UNCHECKED by default
                    selectedReceipts = new Set();
                    searchQuery = '';
                    $('#tableSearchInput').val('');

                    currentPage = 1;
                    $('#resultDiv').show();
                    renderTableRows();
                },
                error: function () {
                    if ($(".preloader").length) { $(".preloader").fadeOut(); }
                    allFetchedRecords = [];
                    selectedReceipts = new Set();
                    searchQuery = '';
                    $('#tableSearchInput').val('');
                    $('#resultDiv').show();
                    renderTableRows();
                }
            });
        });

        // Page Size Selector Change
        $('#pageSizeSelect').on('change', function () {
            var val = $(this).val();
            pageSize = val === 'All' ? allFetchedRecords.length : parseInt(val);
            currentPage = 1;
            renderTableRows();
        });

        // Master "Select All" Checkbox (Selects / Deselects ALL Records Across ALL Pages)
        $(document).on('change', '#selectAllCheckbox', function () {
            var isChecked = $(this).is(':checked');
            var targetRecords = getFilteredRecords();
            if (isChecked) {
                targetRecords.forEach(function (item, i) {
                    var receipt = item.receipt_no || item.reciept_no || ('REC-' + (i + 1));
                    selectedReceipts.add(receipt);
                });
            } else {
                targetRecords.forEach(function (item, i) {
                    var receipt = item.receipt_no || item.reciept_no || ('REC-' + (i + 1));
                    selectedReceipts.delete(receipt);
                });
            }
            $('.row-checkbox').prop('checked', isChecked);
            updateMasterCheckboxState();
            updateSelectedSummary();
        });

        // Individual Row Checkbox Handler
        $(document).on('change', '.row-checkbox', function () {
            var receipt = $(this).val();
            if ($(this).is(':checked')) {
                selectedReceipts.add(receipt);
            } else {
                selectedReceipts.delete(receipt);
            }
            updateMasterCheckboxState();
            updateSelectedSummary();
        });

        // Pagination Click Handler
        $(document).on('click', '.pagination-btn:not(.disabled)', function () {
            var page = $(this).data('page');
            if (page === 'prev') {
                if (currentPage > 1) currentPage--;
            } else if (page === 'next') {
                var totalPages = Math.ceil(getFilteredRecords().length / (pageSize || 25)) || 1;
                if (currentPage < totalPages) currentPage++;
            } else {
                currentPage = parseInt(page);
            }
            renderTableRows();
            window.scrollTo({ top: $('#resultDiv').offset().top - 80, behavior: 'smooth' });
        });

        // Upload to Archive Action Button
        $(document).on('click', '.btn-upload-archive', function () {
            var selectedList = Array.from(selectedReceipts);

            if (selectedList.length === 0) {
                if (window.Swal) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Selection',
                        text: 'Please select at least one record to archive.',
                        confirmButtonColor: '#059669'
                    });
                } else {
                    alert('Please select at least one record to archive.');
                }
                return;
            }

            var archiveType = $('input[name="archive_type"]:checked').val();
            var endpoint = archiveType === 'unbilled' ? '/archive/save_unbilled_archive' : '/archive/save_billed_archive';

            var performArchive = function () {
                $.ajax({
                    method: "POST",
                    url: endpoint,
                    data: { receipt_nos: selectedList },
                    dataType: "json",
                    beforeSend: function () {
                        if ($(".preloader").length) { $(".preloader").fadeIn(); }
                    },
                    success: function (res) {
                        if ($(".preloader").length) { $(".preloader").fadeOut(); }
                        if (res.suc > 0) {
                            if (window.Swal) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Archive Successful',
                                    text: res.msg || 'Records uploaded to archive successfully!',
                                    confirmButtonColor: '#059669'
                                });
                            } else {
                                alert(res.msg || 'Records uploaded to archive successfully!');
                            }
                            $('.btn-fetch:visible').click();
                        } else {
                            if (window.Swal) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Upload Failed',
                                    text: res.msg || 'Failed to upload records to archive.',
                                    confirmButtonColor: '#059669'
                                });
                            } else {
                                alert(res.msg || 'Failed to upload records to archive.');
                            }
                        }
                    },
                    error: function () {
                        if ($(".preloader").length) { $(".preloader").fadeOut(); }
                        if (window.Swal) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Error occurred while archiving records.',
                                confirmButtonColor: '#059669'
                            });
                        } else {
                            alert('Error occurred while archiving records.');
                        }
                    }
                });
            };

            if (window.Swal) {
                Swal.fire({
                    title: 'Upload to Archive?',
                    text: 'Are you sure you want to upload and archive ' + selectedList.length + ' selected record(s)?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#059669',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, Archive',
                    cancelButtonText: 'Cancel',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        performArchive();
                    }
                });
            } else {
                if (confirm('Are you sure you want to upload and archive ' + selectedList.length + ' selected records?')) {
                    performArchive();
                }
            }
        });
    });

    function getFilteredRecords() {
        if (!allFetchedRecords || allFetchedRecords.length === 0) return [];
        if (!searchQuery || !searchQuery.trim()) return allFetchedRecords;

        var q = searchQuery.trim().toLowerCase();
        return allFetchedRecords.filter(function (item) {
            var receipt = (item.receipt_no || item.reciept_no || '').toString().toLowerCase();
            var machine = (item.device_id || item.mc_srl_no || '').toString().toLowerCase();
            var vehicleNo = (item.vehicle_no || '').toString().toLowerCase();
            var vehicleType = (item.vehicle_name || item.vehicle_type || '').toString().toLowerCase();
            var operator = (item.operator_name || item.user_id || '').toString().toLowerCase();

            return receipt.indexOf(q) !== -1 ||
                   machine.indexOf(q) !== -1 ||
                   vehicleNo.indexOf(q) !== -1 ||
                   vehicleType.indexOf(q) !== -1 ||
                   operator.indexOf(q) !== -1;
        });
    }

    function renderTableRows() {
        var archiveType = $('input[name="archive_type"]:checked').val();
        var rows = '';
        var displayRecords = getFilteredRecords();
        var totalRecords = displayRecords.length;

        if (totalRecords > 0) {
            $('#tableHeaderInfo').show();
            var modeName = archiveType === 'unbilled' ? 'Unbilled' : 'Billed';
            var searchInfo = searchQuery ? ' <span class="badge badge-info" style="font-size:0.8rem; background:#3b82f6; color:#fff; border-radius:10px; padding:2px 8px; margin-left:6px;">Filtered: ' + totalRecords + '</span>' : '';
            $('#searchCred').html('<span style="color:var(--gray-800); font-weight:700;">Total ' + modeName + ' Records Fetched: </span><span class="badge badge-success" style="font-size:0.9rem; padding:4px 10px; background-color:var(--green-600); color:white; border-radius:12px;">' + allFetchedRecords.length + '</span>' + searchInfo);
            
            // Calculate Pagination Slice
            var effectivePageSize = pageSize || 25;
            var totalPages = Math.ceil(totalRecords / effectivePageSize) || 1;
            if (currentPage > totalPages) currentPage = totalPages;

            var startIndex = (currentPage - 1) * effectivePageSize;
            var endIndex = Math.min(startIndex + effectivePageSize, totalRecords);
            var pageRecords = displayRecords.slice(startIndex, endIndex);

            // Render Rows for Current Page
            $.each(pageRecords, function (idx, item) {
                var globalIndex = startIndex + idx + 1;
                var amt = parseFloat(item.advance_amt || item.paid_amt || item.amount || 0);
                var receipt = item.receipt_no || item.reciept_no || ('REC-' + globalIndex);
                var dateTimeIn = formatDateTime(item.date_time_in || item.in_time);
                var machineNo = item.device_id || item.mc_srl_no || '-';
                var isChecked = selectedReceipts.has(receipt) ? 'checked' : '';

                rows += '<tr>' +
                    '<td class="text-center">' +
                        '<input type="checkbox" class="row-checkbox" value="' + receipt + '" data-amt="' + amt + '" ' + isChecked + '>' +
                    '</td>' +
                    '<td>' + globalIndex + '</td>' +
                    '<td>' + receipt + '</td>' +
                    '<td>' + dateTimeIn + '</td>' +
                    '<td>' + machineNo + '</td>' +
                    '<td>' + (item.vehicle_name || item.vehicle_type || '-') + '</td>' +
                    '<td>' + (item.vehicle_no || '-') + '</td>' +
                    '<td class="text-center">' + amt.toFixed(2) + '</td>' +
                    '<td>' + (item.operator_name || item.user_id || '-') + '</td>' +
                    '</tr>';
            });

            // Render Pagination Navigation Controls
            renderPaginationControls(startIndex + 1, endIndex, totalRecords, totalPages);
            $('#paginationContainer').show();
            $('.btn-upload-archive').show();
            $('#goDownBtn').show();
        } else {
            $('#tableHeaderInfo').show();
            var modeName = archiveType === 'unbilled' ? 'Unbilled' : 'Billed';
            if (searchQuery && allFetchedRecords.length > 0) {
                $('#searchCred').html('<span style="color:var(--gray-800); font-weight:700;">Total ' + modeName + ' Records Fetched: </span><span class="badge badge-success" style="font-size:0.9rem; padding:4px 10px; background-color:var(--green-600); color:white; border-radius:12px;">' + allFetchedRecords.length + '</span> <span class="text-danger" style="font-size:0.85rem; margin-left:8px;">(No matching results for "' + searchQuery + '")</span>');
            } else {
                $('#searchCred').text('No records found');
            }
            rows = '<tr><td colspan="9" class="text-center text-muted">No matching records found</td></tr>';
            $('#paginationContainer').hide();
            $('.btn-upload-archive').hide();
            $('#goTopBtn, #goDownBtn').hide();
        }

        $('#tableBody').html(rows);
        updateMasterCheckboxState();
        updateSelectedSummary();
        if (window.feather) { feather.replace(); }
    }

    function renderPaginationControls(start, end, total, totalPages) {
        $('#paginationInfo').html('Showing <b>' + start + '</b> to <b>' + end + '</b> of <b>' + total + '</b> entries');
        
        if (totalPages <= 1) {
            $('#paginationButtons').html('');
            return;
        }

        var html = '';
        // Previous Button
        html += '<li class="pagination-btn ' + (currentPage === 1 ? 'disabled' : '') + '" data-page="prev">&laquo; Prev</li>';

        // Page Number Buttons with Smart Ellipsis
        var startPage = Math.max(1, currentPage - 2);
        var endPage = Math.min(totalPages, currentPage + 2);

        if (startPage > 1) {
            html += '<li class="pagination-btn ' + (currentPage === 1 ? 'active' : '') + '" data-page="1">1</li>';
            if (startPage > 2) html += '<li class="pagination-btn disabled">...</li>';
        }

        for (var p = startPage; p <= endPage; p++) {
            html += '<li class="pagination-btn ' + (p === currentPage ? 'active' : '') + '" data-page="' + p + '">' + p + '</li>';
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) html += '<li class="pagination-btn disabled">...</li>';
            html += '<li class="pagination-btn ' + (currentPage === totalPages ? 'active' : '') + '" data-page="' + totalPages + '">' + totalPages + '</li>';
        }

        // Next Button
        html += '<li class="pagination-btn ' + (currentPage === totalPages ? 'disabled' : '') + '" data-page="next">Next &raquo;</li>';

        $('#paginationButtons').html(html);
    }

    function updateMasterCheckboxState() {
        var targetRecords = getFilteredRecords();
        if (!targetRecords || targetRecords.length === 0) {
            $('#selectAllCheckbox').prop('checked', false);
            return;
        }
        var allSelected = true;
        for (var i = 0; i < targetRecords.length; i++) {
            var r = targetRecords[i].receipt_no || targetRecords[i].reciept_no || ('REC-' + (i + 1));
            if (!selectedReceipts.has(r)) {
                allSelected = false;
                break;
            }
        }
        $('#selectAllCheckbox').prop('checked', allSelected);
    }

    function updateSelectedSummary() {
        var count = selectedReceipts.size;
        var displayRecords = getFilteredRecords();
        var totalRecords = displayRecords ? displayRecords.length : 0;
        var effectivePageSize = pageSize || 25;
        var startIndex = (currentPage - 1) * effectivePageSize;
        var endIndex = Math.min(startIndex + effectivePageSize, totalRecords);
        var pageRecords = displayRecords ? displayRecords.slice(startIndex, endIndex) : [];

        var pageTotalAmt = 0;
        pageRecords.forEach(function (item) {
            var val = parseFloat(item.advance_amt || item.paid_amt || item.amount || 0);
            if (!isNaN(val)) pageTotalAmt += val;
        });

        $('#tot_amt').html('<b>' + pageTotalAmt.toFixed(2) + '</b>');

        if (count > 0) {
            $('.btn-upload-archive').show();
        } else {
            $('.btn-upload-archive').hide();
        }
    }

    function formatDateTime(inputDate) {
        if (!inputDate || inputDate === '-' || inputDate === 'null' || inputDate === 'undefined') return '-';
        if (typeof inputDate === 'string' && /^\d{2}\/\d{2}\/\d{4}/.test(inputDate)) {
            return inputDate;
        }
        var date = new Date(inputDate);
        if (isNaN(date.getTime())) {
            return inputDate;
        }
        var pad = function (n) { return (n < 10 ? '0' : '') + n; };
        var day = pad(date.getDate());
        var month = pad(date.getMonth() + 1);
        var year = date.getFullYear();
        var hr = pad(date.getHours());
        var min = pad(date.getMinutes());
        var sec = pad(date.getSeconds());
        return day + '/' + month + '/' + year + ' ' + hr + ':' + min + ':' + sec;
    }

    // Scroll buttons display logic
    window.onscroll = function () {
        var topBtn = document.getElementById("goTopBtn");
        var downBtn = document.getElementById("goDownBtn");
        var isDataVisible = $('#resultDiv').is(':visible');

        if (document.body.scrollTop > 100 || document.documentElement.scrollTop > 100) {
            if (topBtn) topBtn.style.display = "block";
        } else {
            if (topBtn) topBtn.style.display = "none";
        }

        if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 100) {
            if (downBtn) downBtn.style.display = "none";
        } else {
            if (downBtn) downBtn.style.display = isDataVisible ? "block" : "none";
        }
    };

    // Scroll to Top
    document.getElementById("goTopBtn").onclick = function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Scroll to Bottom
    document.getElementById("goDownBtn").onclick = function () {
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    };
</script>
