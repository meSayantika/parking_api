<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Required meta tags -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <link href="https://fonts.googleapis.com/css?family=Roboto:300,400&display=swap" rel="stylesheet" />



  <link rel="stylesheet" href="/login_template/fonts/icomoon/style.css" />
  <link rel="stylesheet" href="/login_template/css/owl.carousel.min.css" />

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="/login_template/css/bootstrap.min.css" />

  <!-- Style -->
  <link rel="stylesheet" href="/login_template/css/style.css" />
  <link rel="stylesheet" href="/login_template/css/custom-login.css" />

  <title>Parking || SuperAdmin Sign In</title>



  <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-player/1.4.3/lottie-player.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/lottie-web@5.7.1"></script>



  <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>



  <!-- Include jQuery -->
  <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

  <!-- Include jQuery Validation Plugin -->
  <script src="https://cdn.jsdelivr.net/jquery.validation/1.19.3/jquery.validate.min.js"></script>

</head>

<body>
  <style>
    .login-loader-overlay {
      position: fixed;
      inset: 0;
      z-index: 200000;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.55);
      backdrop-filter: blur(8px);
    }

    .login-loader-overlay.is-visible {
      display: flex;
    }

    body.login-loading {
      overflow: hidden;
    }

    .login-loader-card {
      min-width: 240px;
      padding: 24px 26px;
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 20px 45px rgba(15, 23, 42, 0.12);
      text-align: center;
    }

    .login-loader-spinner {
      width: 52px;
      height: 52px;
      margin: 0 auto 14px;
      border: 4px solid #d1fae5;
      border-top-color: #059669;
      border-radius: 50%;
      animation: loginSpin 0.8s linear infinite;
    }

    .login-loader-text {
      color: #374151;
      font-weight: 700;
    }

    @keyframes loginSpin {
      to { transform: rotate(360deg); }
    }
  </style>

  <div class="login-loader-overlay" id="loginLoader">
    <div class="login-loader-card">
      <div class="login-loader-spinner"></div>
      <div class="login-loader-text">Signing you in...</div>
    </div>
  </div>

  <div class="content">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6 d-none d-md-block">
          <lottie-player src="/lottiefiles/1701683407794.json" background="transparent" speed="1" loop autoplay
            class="img-fluid" style="width: 100%; max-width: 500px; margin: 0 auto;"></lottie-player>
        </div>
        <div class="col-md-6 contents">
          <div class="row justify-content-center">
            <div class="col-md-11">
              <div class="mb-4 text-center text-md-left">
                <h3 style="font-size: 1.8rem;">SuperAdmin Portal</h3>
                <p class="text-muted" style="font-size: 0.9rem; font-weight: 500;">Please sign in to your dashboard</p>
              </div>
              <form action="/superadmin_login" method="post" id="myForm">
                <div class="form-group mb-4">
                  <label for="user_id">Username</label>
                  <input type="text" class="form-control" id="user_id" name="user_id" placeholder="Enter username" required />
                </div>
                <div class="form-group mb-4 position-relative">
                  <label for="password">Password</label>
                  <input type="password" class="form-control" id="password" name="password" placeholder="Enter password" required style="padding-right: 50px !important;" />
                  <span id="togglePassword" class="icon-eye" style="position: absolute; right: 18px; top: 48px; cursor: pointer; color: var(--gray-400); font-size: 1.1rem; transition: color 0.2s;"></span>
                </div>

                <div class="d-flex mb-4 align-items-center">
                    <label class="control control--checkbox mb-0" style="font-size: 0.85rem; font-weight: 500; color: var(--gray-600);">
                        <span class="caption">Remember me</span>
                        <input type="checkbox" checked="checked"/>
                        <div class="control__indicator"></div>
                    </label>
                </div>

                <input type="submit" value="Log In to Dashboard" class="btn btn-block btn-success" />
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/login_template/js/jquery-3.3.1.min.js"></script>
  <script src="/login_template/js/popper.min.js"></script>
  <script src="/login_template/js/bootstrap.min.js"></script>
  <script src="/login_template/js/main.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>

  <% if (error.length> 0) { %>
    <script>
      toastr.error('<%= error %>')
    </script>
    <% } else if (success.length> 0) { %>
      <script>
        toastr.success('<%= success %>')
      </script>
      <% }else if (info.length> 0) { %>
        <script>
          toastr.info('<%= info %>')
        </script>
        <% }else if (warning.length> 0) { %>
          <script>
            toastr.warning('<%= warning %>')
          </script>
          <% } %>

            <script>
              $(document).ready(function () {
                const $loader = $("#loginLoader");
                const $submit = $("#myForm input[type='submit']");

                // Password Toggle Logic
                const togglePassword = document.querySelector('#togglePassword');
                const password = document.querySelector('#password');

                togglePassword.addEventListener('click', function (e) {
                    const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                    password.setAttribute('type', type);
                    this.classList.toggle('icon-eye-slash');
                    this.classList.toggle('icon-eye');
                    
                    // Style change on click
                    if(type === 'text') {
                      this.style.color = 'var(--green-600)';
                    } else {
                      this.style.color = 'var(--gray-400)';
                    }
                });

                $("#myForm").validate({
                  rules: {
                    user_id: "required",
                    password: {
                      required: true,
                      minlength: 6
                    }
                  },
                  messages: {
                    user_id: "Please enter your username",
                    password: {
                      required: "Please enter your password",
                      minlength: "Password must be at least 6 characters long"
                    }
                  },
                  errorPlacement: function(error, element) {
                      error.insertAfter(element);
                  },
                  submitHandler: function(form) {
                    $("body").addClass("login-loading");
                    $loader.addClass("is-visible");
                    $submit.prop("disabled", true).val("Please wait...");
                    form.submit();
                  }
                });
              });
            </script>
</body>

</html>
