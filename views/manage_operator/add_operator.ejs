<link href="/template/dist/css/operator-page.css" rel="stylesheet">

<!-- DataTables CSS/JS if not already added -->
<link rel="stylesheet"
href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">

<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<div class="op-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card op-card">
          <div class="card-body">

            <!-- HEADER -->
            <div class="op-header">
              <div class="op-title-group">
                <div class="op-icon-badge">
                  <i data-feather="users"></i>
                </div>
                <h3 class="op-page-title">Manage Operator</h3>
              </div>
              <button type="button" class="op-add-btn" id="myBtn">
                <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Operator
              </button>
            </div>

            <!-- TABLE CONTENT -->
            <div class="op-table-wrap mt-3">
              <table id="example" class="table op-table no-wrap display">
                <thead>
                  <tr>
                    <th>Sl. No.</th>
                    <th>Operator Name</th>
                    <th>User ID</th>
                    <th>Device ID</th>
                    <th>Status</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(data.msg && data.msg.length> 0) { %>
                    <% data.msg.forEach(function(item,index) { %>
                      <tr>
                        <td>
                          <%=(index+1)%>
                        </td>
                        <td style="font-weight: 600; color: var(--gray-800);">
                          <%=item.operator_name %>
                        </td>
                        <td>
                          <%=item.user_id%>
                        </td>
                        <td>
                          <%=item.device_id%>
                        </td>
                        <td>
                          <span class="badge <%=(item.allow_flag=='Y')?'badge-success':'badge-danger'%>"
                            style="font-size: 0.8rem; padding: 5px 12px; border-radius: 20px;">
                            <%=(item.allow_flag=='Y')?"Active":"Deactive"%>
                          </span>
                        </td>
                        <td>
                          <a href="/operator/operator_edit?customer_id=<%=item.customer_id%>&&user_id=<%= item.user_id%>"
                            class="action-btn-edit" title="Edit Operator">
                            <i class="fa fa-edit"></i>
                          </a>
                        </td>
                      </tr>
                      <% }); %>
                        <% } else { %>
                          <tr>
                            <td colspan="6" style="color: var(--danger); font-weight: 500; padding: 30px; text-align: center;">No data available</td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title"><i data-feather="user-plus" style="width:20px;height:20px;"></i><b> Add Operator</b>
        </h4>
        <button type="button" class="close" data-dismiss="modal">&times;</button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <form action="/operator/save_add_operator" method="post" id="myForm">
          <div class="row">
            <div class="col-md-6 op-form-group">
              <label class="op-label">Operator Name</label>
              <input type="text" class="op-input" name="op_name" id="op_name" placeholder="Enter Operator Name" required>
            </div>

            <div class="col-md-6 op-form-group">
              <label class="op-label">Mobile No.</label>
              <input type="text" class="op-input" name="mob_no" id="mob_no" placeholder="Enter Mobile No." maxlength="10" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)" required>
               <small id="mobError" style="color:red;display:none;">
                Mobile number already exists
              </small>
            </div>

            <div class="col-md-6 op-form-group">
              <label class="op-label">Device ID</label>
              <input type="text" class="op-input" name="dev_id" id="dev_id" placeholder="Enter Device ID." required>
            </div>

            <div class="col-md-6 op-form-group">
              <label class="op-label">Password</label>
              <div class="op-password-group">
                <input type="password" class="op-input" name="pwd" id="pwd" placeholder="Enter secure password" required>
                <button class="op-password-toggle" type="button" id="togglePassword">
                  <i data-feather="eye-off" style="width:16px;height:16px;"></i>
                </button>
              </div>
            </div>
          </div>
          <div class="text-center mt-4 pt-2">
            <button type="submit" class="op-submit-btn">Register Operator</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    // Show Modal
    $("#myBtn").click(function () {
      $("#myModal").modal('show');
    });

    // Password toggle
    $("#togglePassword").click(function () {
      const pwdField = $("#pwd");
      const icon = $(this).find('i');

      if (pwdField.attr("type") === "password") {
        pwdField.attr("type", "text");
        $(this).html('<i data-feather="eye" style="width:16px;height:16px;"></i>');
      } else {
        pwdField.attr("type", "password");
        $(this).html('<i data-feather="eye-off" style="width:16px;height:16px;"></i>');
      }
      feather.replace();
    });

    // Replace feather icons
    if (typeof feather !== 'undefined') {
      feather.replace();
    }
  });

  // DataTable Pagination
    $('#example').DataTable({
        pageLength:10,
        lengthMenu:[10,25,50,100],
        ordering:false,
        responsive:true,
        autoWidth:false,
        language:{
            search:"Search Operator:",
            lengthMenu:"Show _MENU_ entries",
            info:"Showing _START_ to _END_ of _TOTAL_ operators",
            paginate:{
                previous:"Prev",
                next:"Next"
            }
        },

        /* Serial no auto change by page */
        drawCallback:function(){
            var api=this.api();
            var start=api.page.info().start;

            api.column(0,{page:'current'}).nodes()
            .each(function(cell,i){
                cell.innerHTML=start+i+1;
            });
        }
    });

    if(typeof feather!=='undefined'){
        feather.replace();
    }

</script>
