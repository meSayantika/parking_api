<link href="/template/dist/css/operator-page.css" rel="stylesheet">

<!-- DataTables CSS/JS if not already added -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<div class="op-page-wrapper">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card op-card">
          <div class="card-body">
            
            <!-- HEADER -->
            <div class="op-header">
                <div class="op-title-group">
                    <div class="op-icon-badge">
                        <i data-feather="truck"></i>
                    </div>
                    <h3 class="op-page-title">Manage Vehicle</h3>
                </div>
                <button type="button" class="op-add-btn" id="myBtn">
                    <i data-feather="plus" style="width:15px;height:15px;stroke:currentColor;"></i> Add Vehicle
                </button>
            </div>

            <!-- TABLE CONTENT -->
            <div class="op-table-wrap mt-3">
              <table id="example" class="table op-table no-wrap display">
                <thead>
                  <tr>
                    <th>Sl. No.</th>
                    <th>Vehicle Name</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if(data.msg && data.msg.length > 0){
                      data.msg.forEach(function(item,index) { %>
                        <tr>
                          <td class="text-center"><%=(index+1)%></td>
                          <td style="font-weight: 600; color: var(--gray-800);"><%=item.vehicle_name %></td>
                          <td class="text-center">
                            <% if (item.vehicle_on_off == 'Y') { %>
                              <span class="badge badge-success" style="font-size: 0.8rem; padding: 5px 12px; border-radius: 20px;">Active</span>
                            <% } else { %>
                              <span class="badge badge-danger" style="font-size: 0.8rem; padding: 5px 12px; border-radius: 20px;">Deactive</span>
                            <% } %>
                          </td>
                          <td class="text-center">
                            <a href="/vehicle/edit_vehicle_details?customer_id=<%=item.customer_id%>&vehicle_id=<%=item.vehicle_id %>" 
                               class="action-btn-edit" title="Edit Vehicle">
                               <i class="fa fa-edit"></i>
                            </a>
                          </td>
                        </tr>
                        <% });}else{ %>
                          <tr>
                            <td colspan="4" style="color: var(--danger); font-weight: 500; padding: 30px; text-align: center;">No vehicle data available</td>
                          </tr>
                          <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade loc-modal" id="myModal">
    <div class="modal-dialog">
      <div class="modal-content">
        <!-- Modal Header -->
        <div class="modal-header">
          <h4 class="modal-title"><i data-feather="plus-circle" style="width:20px;height:20px;"></i><b> Add Vehicle</b>
          </h4>
          <button type="button" class="close" data-dismiss="modal">&times;</button>
        </div>
  
        <!-- Modal body -->
        <div class="modal-body">
          <form action="/vehicle/add_save_vehicle" method="post" id="myForm">
            <div class="row">
              <div class="col-md-12 op-form-group">
                <label class="op-label">Customer Name</label>
                <select name="cust_id" class="op-input" id="cust_id" readonly style="background-color: var(--gray-100); pointer-events: none;">
                  <option value="<%=user.user_data.customer_id %>">
                    <%= user.user_data.customer_name %>
                  </option>
                </select>
              </div>
  
              <div class="col-md-12 op-form-group">
                <label class="op-label">Vehicle Name</label>
                <input type="text" class="op-input" id="vehicle_name" name="vehicle_name" placeholder="Enter Vehicle Name (e.g. Car, Truck)" required>
              </div>
            </div>
            <div class="text-center mt-2">
              <button type="submit" class="op-submit-btn" style="width: 100%;">Create Vehicle</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

<script>
    $(document).ready(function () {
      // Show Modal
      $("#myBtn").click(function () {
        $("#myModal").modal('show');
      });

      // Replace feather icons
      if (typeof feather !== 'undefined') {
        feather.replace();
      }

      // DataTable Initialization matching Operator section
      $('#example').DataTable({
          pageLength: 10,
          lengthMenu: [10, 25, 50, 100],
          ordering: false,
          responsive: true,
          autoWidth: false,
          language: {
              search: "Search Vehicle:",
              lengthMenu: "Show _MENU_ entries",
              info: "Showing _START_ to _END_ of _TOTAL_ vehicles",
              paginate: {
                  previous: "Prev",
                  next: "Next"
              }
          },
          drawCallback: function() {
              var api = this.api();
              var start = api.page.info().start;
              api.column(0, {page:'current'}).nodes().each(function(cell, i) {
                  cell.innerHTML = start + i + 1;
              });
              if (typeof feather !== 'undefined') {
                  feather.replace();
              }
          }
      });
    });
</script>
